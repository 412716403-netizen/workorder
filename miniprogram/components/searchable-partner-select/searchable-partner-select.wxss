
@import '../../styles/tokens.wxss';
@import '../../styles/plan-form-cell.wxss';

.sps {
  margin-bottom: 24rpx;
}

.sps--embedded {
  margin-bottom: 0;
}

.sps__trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.sps__trigger--embedded {
  padding: 28rpx var(--spacing-card);
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border-bottom: 1rpx solid var(--color-border);
}

.sps__label {
  flex-shrink: 0;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-secondary);
  width: 120rpx;
}

.sps__label--embedded {
  width: auto;
  min-width: 160rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: var(--color-text-primary);
}

.sps__req {
  color: #ff4d4f;
  margin-right: 4rpx;
}

.sps__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__value--placeholder {
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.sps__trigger--embedded .sps__value {
  font-size: 30rpx;
}

.sps__trigger--embedded .sps__value--placeholder {
  color: var(--color-text-tertiary);
}

.sps__chevron {
  color: var(--color-text-tertiary);
  font-size: 32rpx;
  line-height: 1;
}

.sps__overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  overflow: hidden;
}

.sps__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sps__mask--show {
  opacity: 1;
}

.sps--cell {
  margin-bottom: 0;
}

.sps__sheet--picker {
  /* 高度由 JS 按 windowHeight 计算后 inline 设置 */
}

.sps__picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.sps__picker-cancel {
  min-width: 96rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.sps__picker-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-primary);
}

.sps__picker-action {
  min-width: 96rpx;
}

.sps__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  transform: translateY(100%);
  transition: none;
  will-change: transform;
}

.sps__sheet--motion {
  transition: transform 0.3s cubic-bezier(0.36, 0.66, 0.04, 1);
}

.sps__sheet--show {
  transform: translateY(0);
}

.sps__sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.sps__sheet-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--color-text-primary);
}

.sps__sheet-close {
  font-size: var(--font-caption);
  color: var(--color-primary);
}

.sps__search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.sps__search-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.sps__search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  transform: translateY(-50%);
  opacity: 0.45;
}

.sps__search-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 24rpx 0 64rpx;
  border-radius: var(--radius-button);
  background: var(--color-bg-input);
  font-size: var(--font-caption);
  color: var(--color-text-primary);
}

.sps__quick-create-btn {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-button);
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
}

.sps__tabs {
  flex-shrink: 0;
  margin: 0 var(--spacing-page) 12rpx;
  white-space: nowrap;
}

.sps__tabs-row {
  display: inline-flex;
  gap: 8rpx;
  padding-bottom: 4rpx;
}

.sps__tab {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
}

.sps__tab--active {
  color: var(--color-text-inverse);
  background: var(--color-primary);
}

.sps__list {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 var(--spacing-page) 16rpx;
  box-sizing: border-box;
}

.sps__empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.sps__row {
  padding: 20rpx 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-button);
  border: 2rpx solid transparent;
  background: var(--color-bg-page);
}

.sps__row--active {
  background: var(--color-primary-light);
  border-color: rgba(47, 107, 255, 0.25);
}

.sps__row-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.sps__row-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  word-break: break-all;
}

.sps__row-cat {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.sps__row-contact {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.sps__qc-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.sps__qc-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.55);
}

.sps__qc-panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.18);
}

.sps__qc-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.sps__qc-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.sps__qc-field {
  margin-top: 24rpx;
}

.sps__qc-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.sps__qc-input,
.sps__qc-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg-input);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 80rpx;
}

.sps__qc-picker--ph {
  color: var(--color-text-tertiary);
}

.sps__qc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 36rpx;
}

.sps__qc-btn {
  min-width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.sps__qc-btn--ghost {
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
}

.sps__qc-btn--primary {
  color: #fff;
  background: var(--color-primary);
}

.sps__qc-btn--disabled {
  opacity: 0.6;
}
