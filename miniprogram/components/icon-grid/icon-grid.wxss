
.st-icon-grid {
  display: grid;
  gap: 24rpx 16rpx;
  padding: var(--spacing-card);
}

.st-icon-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.st-icon-grid__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-icon);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.st-icon-grid__icon {
  width: 48rpx;
  height: 48rpx;
}

.st-icon-grid__char {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
  pointer-events: none;
}

.st-icon-grid__fallback {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.st-icon-grid__label {
  font-size: var(--font-small);
  color: var(--color-text-primary);
  text-align: center;
  line-height: 1.3;
}

.st-icon-grid--inverse {
  padding: 0;
  gap: 20rpx 12rpx;
}

.st-icon-grid--inverse .st-icon-grid__icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.st-icon-grid--inverse .st-icon-grid__icon {
  width: 44rpx;
  height: 44rpx;
}

.st-icon-grid--inverse .st-icon-grid__char,
.st-icon-grid--inverse .st-icon-grid__fallback {
  color: var(--color-primary);
}

.st-icon-grid--inverse .st-icon-grid__label {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
}
