<view wx:if="{{open}}" class="report-sheet-mask {{sheetShow ? 'report-sheet-mask--show' : ''}}" bindtap="onMaskTap" catchtouchmove="noop">
  <view class="report-sheet {{sheetShow ? 'report-sheet--show' : ''}}" catchtap="noop" catchtouchmove="noop">
    <view class="report-sheet__handle"></view>

    <view class="report-sheet__head">
      <text class="report-sheet__title">工序报工</text>
      <view class="report-sheet__context">
        <text class="report-sheet__order">{{orderNumber}}</text>
        <text class="report-sheet__dot">·</text>
        <text class="report-sheet__milestone">{{milestoneName}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="report-sheet__muted">加载可报量…</view>

    <block wx:else>
      <view class="report-sheet__quota {{remaining <= 0 ? 'report-sheet__quota--empty' : ''}}">
        <text class="report-sheet__quota-label">剩余可报</text>
        <text class="report-sheet__quota-value">{{remaining}}</text>
        <text class="report-sheet__quota-unit">件</text>
      </view>

      <view class="report-sheet__form">
        <view class="report-sheet__field">
          <text class="report-sheet__field-label">良品数量</text>
          <view class="report-sheet__stepper">
            <view class="report-sheet__step-btn" data-field="quantity" data-delta="-1" bindtap="onStepTap">−</view>
            <input
              class="report-sheet__step-input"
              type="digit"
              value="{{quantity}}"
              bindinput="onQuantityInput"
              bindblur="onQuantityBlur"
            />
            <view class="report-sheet__step-btn" data-field="quantity" data-delta="1" bindtap="onStepTap">+</view>
          </view>
        </view>
        <view class="report-sheet__field">
          <text class="report-sheet__field-label">不良品</text>
          <view class="report-sheet__stepper">
            <view class="report-sheet__step-btn" data-field="defectiveQty" data-delta="-1" bindtap="onStepTap">−</view>
            <input
              class="report-sheet__step-input"
              type="digit"
              value="{{defectiveQty}}"
              bindinput="onDefectiveInput"
              bindblur="onDefectiveBlur"
            />
            <view class="report-sheet__step-btn" data-field="defectiveQty" data-delta="1" bindtap="onStepTap">+</view>
          </view>
        </view>
      </view>

      <view class="report-sheet__actions">
        <button class="report-sheet__btn report-sheet__btn--ghost" bindtap="onGoScan">去扫码报工</button>
        <button
          class="report-sheet__btn report-sheet__btn--primary"
          loading="{{submitting}}"
          disabled="{{submitting || remaining <= 0}}"
          bindtap="onSubmit"
        >确认报工</button>
      </view>
    </block>
  </view>
</view>
