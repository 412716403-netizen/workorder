@import '../../components/node-chip-select/node-chip-select.wxss';

.mms__mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}

.mms__mask--show {
  background: rgba(0, 0, 0, 0.45);
}

.mms__sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
}

.mms__sheet--motion {
  transition: transform 0.3s ease;
}

.mms__sheet--show {
  transform: translateY(0);
}

.mms__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.mms__head-text {
  flex: 1;
  min-width: 0;
}

.mms__title {
  display: block;
  font-size: var(--font-section);
  font-weight: 700;
  color: var(--color-text-primary);
}

.mms__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.mms__close {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: var(--color-primary);
  padding-top: 4rpx;
}

.mms__summary {
  padding: 0 var(--spacing-page) 16rpx;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.mms__list {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 var(--spacing-page);
  box-sizing: border-box;
}

.mms__empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  font-style: italic;
}

.mms__chip-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

.mms__footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx var(--spacing-page) 24rpx;
  flex-shrink: 0;
  border-top: 1rpx solid var(--color-border);
}

.mms__btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 16rpx;
  border-radius: var(--radius-card);
  font-size: var(--font-caption);
  font-weight: 700;
}

.mms__btn--ghost {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.mms__btn--primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.mms__btn--disabled {
  opacity: 0.6;
}
