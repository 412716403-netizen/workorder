
.st-stat-row {
  display: flex;
  padding: 8rpx var(--spacing-card) var(--spacing-card);
}

.st-stat-row__item {
  flex: 1;
  text-align: center;
}

.st-stat-row__value {
  font-size: var(--font-stat-row);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.st-stat-row__label {
  margin-top: 8rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}
