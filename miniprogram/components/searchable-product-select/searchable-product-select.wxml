<view class="sps {{embedded ? 'sps--embedded' : ''}} {{cell ? 'sps--cell' : ''}}">
  <view
    wx:if="{{cell}}"
    class="plan-form-cell"
    bindtap="onOpen"
  >
    <text class="plan-form-cell__label">
      <text wx:if="{{required}}" class="plan-form-cell__req">*</text>{{label}}
    </text>
    <text class="plan-form-cell__value {{hasDisplayValue ? '' : 'plan-form-cell__value--ph'}}">{{hasDisplayValue ? displayText : placeholder}}</text>
    <text class="plan-form-cell__chevron">›</text>
  </view>

  <view wx:else class="sps__trigger {{embedded ? 'sps__trigger--embedded' : ''}}" bindtap="onOpen">
    <text class="sps__label {{embedded ? 'sps__label--embedded' : ''}}">
      <text wx:if="{{required}}" class="sps__req">*</text>{{label}}
    </text>
    <view class="sps__value-wrap">
      <block wx:if="{{hasDisplayValue}}">
        <text class="sps__value">{{displayName}}</text>
        <text wx:if="{{displaySku}}" class="sps__value-sku">{{displaySku}}</text>
      </block>
      <text wx:else class="sps__value sps__value--placeholder">{{placeholder}}</text>
    </view>
    <text class="sps__chevron">›</text>
  </view>

  <view wx:if="{{open}}" class="sps__overlay" catchtouchmove="noop">
    <view
      class="sps__mask {{sheetShow ? 'sps__mask--show' : ''}}"
      bindtap="onClose"
      catchtouchmove="noop"
    />
    <view
      class="sps__sheet {{cell ? 'sps__sheet--picker' : ''}} {{sheetMotion ? 'sps__sheet--motion' : ''}} {{sheetShow ? 'sps__sheet--show' : ''}}"
      style="height: {{sheetHeightPx}}px; max-height: {{sheetHeightPx}}px;"
      catchtouchmove="noop"
    >
    <view wx:if="{{cell}}" class="sps__picker-bar">
      <text class="sps__picker-cancel" bindtap="onClose">取消</text>
      <text class="sps__picker-title">{{label}}</text>
      <text class="sps__picker-action"></text>
    </view>
    <view wx:else class="sps__sheet-head">
      <text class="sps__sheet-title">选择{{label}}</text>
      <text class="sps__sheet-close" bindtap="onClose">关闭</text>
    </view>

    <view class="sps__search-wrap">
      <image class="sps__search-icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        class="sps__search-input"
        value="{{search}}"
        bindinput="onSearchInput"
        placeholder="搜索产品名称、SKU、自定义内容..."
        confirm-type="search"
      />
    </view>

    <scroll-view
      wx:if="{{categories.length > 0}}"
      class="sps__tabs"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="sps__tabs-row">
        <view
          class="sps__tab {{activeTab === 'all' ? 'sps__tab--active' : ''}}"
          data-tab="all"
          bindtap="onTabTap"
        >全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="sps__tab {{activeTab === item.id ? 'sps__tab--active' : ''}}"
          data-tab="{{item.id}}"
          bindtap="onTabTap"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <scroll-view class="sps__list" scroll-y enhanced show-scrollbar="{{true}}">
      <view wx:if="{{filteredProducts.length === 0}}" class="sps__empty">未找到匹配的产品</view>
      <view
        wx:for="{{filteredProducts}}"
        wx:key="id"
        class="sps__row {{valueId === item.id ? 'sps__row--active' : ''}} {{item.hasCustomTags ? 'sps__row--rich' : ''}} {{item.unavailable ? 'sps__row--disabled' : ''}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onSelect"
      >
        <view class="sps__row-left">
          <view class="sps__row-thumb">
            <image
              wx:if="{{item.showImage}}"
              class="sps__row-img"
              src="{{item.imageUrl}}"
              mode="aspectFill"
              lazy-load="{{true}}"
              data-id="{{item.id}}"
              binderror="onImageError"
            />
            <view wx:else class="sps__row-img sps__row-img--placeholder">
              <image class="sps__row-placeholder-icon" src="{{productPlaceholderIcon}}" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="sps__row-body">
          <view class="sps__row-title">
            <text class="sps__row-name">{{item.name}}</text>
            <text wx:if="{{item.sku}}" class="sps__row-sku">{{item.sku}}</text>
            <text
              wx:for="{{item.customTags}}"
              wx:for-item="tag"
              wx:key="id"
              class="sps__row-tag sps__row-tag--inline"
            >{{tag.label}}: {{tag.display}}</text>
          </view>
        </view>
        <text wx:if="{{item.used}}" class="sps__row-used">已添加</text>
        <text wx:elif="{{item.blocked && item.unavailable}}" class="sps__row-blocked">不可选</text>
        <text wx:elif="{{item.categoryLabel}}" class="sps__row-cat">{{item.categoryLabel}}</text>
      </view>
    </scroll-view>
    </view>
  </view>
</view>
