
@import '../../styles/tokens.wxss';
@import '../../styles/plan-form-cell.wxss';

.sps {
  margin-bottom: 24rpx;
}

.sps--embedded {
  margin-bottom: 0;
}

.sps__trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.sps__trigger--embedded {
  padding: 28rpx var(--spacing-card);
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border-bottom: 1rpx solid var(--color-border);
}

.sps__label {
  flex-shrink: 0;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-secondary);
  width: 120rpx;
}

.sps__label--embedded {
  width: auto;
  min-width: 160rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: var(--color-text-primary);
}

.sps__req {
  color: #ff4d4f;
  margin-right: 4rpx;
}

.sps__value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  overflow: hidden;
}

.sps__value {
  flex-shrink: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__value-sku {
  flex-shrink: 0;
  max-width: 45%;
  text-align: right;
  font-size: var(--font-small);
  font-weight: 500;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__value--placeholder {
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.sps__trigger--embedded .sps__value-wrap {
  justify-content: flex-end;
}

.sps__trigger--embedded .sps__value {
  font-size: 30rpx;
}

.sps__trigger--embedded .sps__value--placeholder {
  color: var(--color-text-tertiary);
}

.sps__chevron {
  color: var(--color-text-tertiary);
  font-size: 32rpx;
  line-height: 1;
}

.sps__overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
}

.sps__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sps__mask--show {
  opacity: 1;
}

.sps--cell {
  margin-bottom: 0;
}

.sps__sheet--picker {
  height: 48vh;
  max-height: 48vh;
}

.sps__picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.sps__picker-cancel {
  min-width: 96rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.sps__picker-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-primary);
}

.sps__picker-action {
  min-width: 96rpx;
}

.sps__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  height: 68vh;
  max-height: 68vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.36, 0.66, 0.04, 1);
  will-change: transform;
}

.sps__sheet--show {
  transform: translateY(0);
}

.sps__sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.sps__sheet-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--color-text-primary);
}

.sps__sheet-close {
  font-size: var(--font-caption);
  color: var(--color-primary);
}

.sps__search-wrap {
  position: relative;
  margin: 0 var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.sps__search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  transform: translateY(-50%);
  opacity: 0.45;
}

.sps__search-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 24rpx 0 64rpx;
  border-radius: var(--radius-button);
  background: var(--color-bg-input);
  font-size: var(--font-caption);
  color: var(--color-text-primary);
}

.sps__tabs {
  flex-shrink: 0;
  margin: 0 var(--spacing-page) 12rpx;
  white-space: nowrap;
}

.sps__tabs-row {
  display: inline-flex;
  gap: 8rpx;
  padding-bottom: 4rpx;
}

.sps__tab {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
}

.sps__tab--active {
  color: var(--color-text-inverse);
  background: var(--color-primary);
}

.sps__list {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 var(--spacing-page) 16rpx;
  box-sizing: border-box;
}

.sps__empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.sps__row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 132rpx;
  height: 132rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-button);
  border: 2rpx solid transparent;
  background: var(--color-bg-page);
}

.sps__row--rich {
  height: auto;
  min-height: 132rpx;
  align-items: flex-start;
}

.sps__row--rich .sps__row-body {
  padding-top: 4rpx;
}

.sps__row--active {
  background: var(--color-primary-light);
  border-color: rgba(47, 107, 255, 0.25);
}

.sps__row-left {
  width: 96rpx;
  flex-shrink: 0;
}

.sps__row-thumb {
  flex-shrink: 0;
}

.sps__row-cat {
  flex-shrink: 0;
  max-width: 28%;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: right;
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__row-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  display: block;
}

.sps__row-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  border-color: #e0e7ff;
}

.sps__row-placeholder-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.55;
}

.sps__row-body {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  padding-top: 2rpx;
}

.sps__row-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.sps__row-name {
  flex-shrink: 1;
  min-width: 0;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__row-sku {
  flex-shrink: 0;
  max-width: 48%;
  font-size: var(--font-small);
  font-weight: 500;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__row-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sps__row-tag--inline {
  flex-shrink: 1;
  min-width: 0;
  max-width: 100%;
}
