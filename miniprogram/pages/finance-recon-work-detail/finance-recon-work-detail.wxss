@import '../../pages/finance-receipts/finance-receipts.wxss';

.fin-recon-work-page {
  padding: 0 var(--spacing-page) calc(40rpx + env(safe-area-inset-bottom));
}

.fin-recon-work-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.fin-recon-work-card__title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.fin-recon-work-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.fin-recon-work-row:last-child {
  border-bottom: none;
}

.fin-recon-work-row__label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
}

.fin-recon-work-row__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.fin-recon-work-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.fin-recon-work-item:last-child {
  border-bottom: none;
}

.fin-recon-work-item__name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.fin-recon-work-item__meta {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 4rpx;
}

.fin-recon-work-item__amount {
  font-size: 26rpx;
  font-weight: 800;
  color: #059669;
}
