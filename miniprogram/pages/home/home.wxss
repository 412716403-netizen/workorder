@import '../../styles/tokens.wxss';

.home-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

.home-header {
  flex-shrink: 0;
  padding: 0 28rpx 28rpx;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.home-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-top: 0;
}

.home-user__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.98);
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.38);
}

.home-user__info {
  flex: 1;
  min-width: 0;
}

.home-user__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-user__name {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-user__tenant {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-shortcuts {
  width: 100%;
}

.home-shortcuts__inner--fill {
  display: flex;
  flex-direction: row;
  width: 100%;
  justify-content: space-between;
  gap: 4rpx;
  padding: 4rpx 0 2rpx;
}

.home-shortcuts__inner--scroll {
  display: inline-flex;
  flex-direction: row;
  gap: 8rpx;
  padding: 4rpx 0 2rpx;
}

.home-shortcuts__inner--fill .home-shortcut {
  flex: 1;
  min-width: 0;
  max-width: none;
}

.home-shortcuts__inner--scroll .home-shortcut {
  flex-shrink: 0;
  width: 136rpx;
}

.home-shortcut {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 4rpx;
}

.home-shortcut__icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}

.home-shortcut__fallback {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
}

.home-shortcut__label {
  width: 100%;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  text-align: center;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-shortcuts--loading,
.home-shortcuts--empty {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.home-scroll {
  flex: 1;
  min-height: 0;
}

.home-body {
  margin-top: -24rpx;
  padding: 28rpx var(--spacing-page) 48rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-bg-page);
  min-height: 100%;
}

.home-dashboard-head {
  margin-bottom: 16rpx;
}

.home-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.home-section-head__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.home-section-head__hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.home-period {
  padding: 0 4rpx;
}

.home-period__tabs {
  display: flex;
  overflow: hidden;
  border-radius: var(--radius-icon);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.home-period__tab {
  flex: 1;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.home-period__tab:not(:last-child) {
  border-right: 1rpx solid var(--color-border);
}

.home-period__tab--active {
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.home-period__range {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.home-period__date {
  flex: 1;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-icon);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--color-text-primary);
  text-align: center;
}

.home-period__sep {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.home-period__warn {
  margin-top: 8rpx;
  font-size: var(--font-small);
  color: var(--color-danger, #e11d48);
}

.home-body .st-empty__text {
  font-size: 28rpx;
}
