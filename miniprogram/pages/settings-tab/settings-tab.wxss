@import '../../styles/tokens.wxss';

page {
  background: var(--color-bg-page);
}

.settings-tab-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.settings-tab-page {
  padding: 24rpx var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.settings-tab-intro {
  margin-bottom: 24rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.settings-tab-muted {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.settings-tab-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.settings-tab-section {
  padding: var(--spacing-card);
}

.settings-tab-section__title {
  margin-bottom: 16rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.settings-tab-row {
  padding: 28rpx var(--spacing-card);
  border-bottom: 1rpx solid var(--color-border);
}

.settings-tab-row:last-child {
  border-bottom: none;
}

.settings-tab-row__title {
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.settings-tab-row__sub {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.settings-tab-config {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.settings-tab-config:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.settings-tab-config__label {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.settings-tab-config__value {
  margin-top: 8rpx;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-primary);
}

.settings-tab-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: var(--font-small);
  color: var(--color-text-tertiary);
}
