@import '../../pages/production-plans/production-plans.wxss';
@import '../../pages/production-order-report-history/production-order-report-history.wxss';

.po-flow-filter-section {
  margin-bottom: 8rpx;
}

.po-flow-filter-section .plan-filter-panel__label {
  display: block;
  margin-bottom: 12rpx;
}

.po-flow-status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.po-flow-status-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
}

.po-flow-status-chip--active {
  color: #2f6bff;
  background: #e8efff;
  font-weight: 600;
}

.po-flow-row__main-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}

.report-history-row .report-history-row__main {
  align-items: flex-start;
}

.po-flow-row__partner {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.po-flow-row__main-left .report-history-row__product-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.po-flow-row__status {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.po-flow-row__status--partial {
  color: var(--color-primary);
  font-weight: 600;
}

.po-flow-row__status--over {
  color: #d97706;
  font-weight: 600;
}

.po-flow-row__received {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  text-align: right;
}

.po-flow-row__amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  text-align: right;
}
