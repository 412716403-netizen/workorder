@import '../../styles/tokens.wxss';

.scan-setup {
  padding: 0 var(--spacing-page) calc(var(--tabbar-height) + env(safe-area-inset-bottom) + var(--spacing-page));
}

.scan-setup__hint {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.5;
  padding: 8rpx 0 24rpx;
}

.scan-setup__form {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 8rpx var(--spacing-card);
}

.scan-setup__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.scan-setup__row:last-child {
  border-bottom: none;
}

.scan-setup__label {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  width: 160rpx;
}

.scan-setup__value {
  flex: 1;
  text-align: right;
  font-size: var(--font-caption);
  color: var(--color-text-primary);
}

.scan-setup__value--placeholder {
  color: var(--color-text-tertiary);
}

.scan-setup__chevron {
  color: var(--color-text-tertiary);
  font-size: 32rpx;
}

.scan-setup__start {
  margin-top: 32rpx;
}
