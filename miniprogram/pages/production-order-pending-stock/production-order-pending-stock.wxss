@import '../../pages/production-plans/production-plans.wxss';
@import '../../styles/form.wxss';

.pending-stock-page {
  padding: 0 var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}

.pending-stock-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.pending-stock-row__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.pending-stock-row__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.pending-stock-form {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-stock-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.pending-stock-submit {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.pending-stock-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--spacing-page);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
}

.pending-stock-scan-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-bg-page);
  color: var(--color-primary);
  border-radius: var(--radius-button);
  font-size: 28rpx;
  font-weight: 600;
}

.pending-stock-page--list {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.pending-stock-list-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.pending-stock-list-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.pending-stock-list-row__title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.pending-stock-list-row__pending {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning, #f59e0b);
}

.pending-stock-list-row__meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.pending-stock-list-row__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
