@import '../../pages/production-plans/production-plans.wxss';
@import '../../styles/form.wxss';

.pending-stock-page--list {
  padding: 0 var(--spacing-page) calc(280rpx + env(safe-area-inset-bottom));
}

.pending-stock-list-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.pending-stock-list-row__check {
  flex-shrink: 0;
  padding-top: 4rpx;
}

.pending-stock-list-row__thumb {
  flex-shrink: 0;
}

.pending-stock-list-row__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-page);
  display: block;
}

.pending-stock-list-row__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  border-color: #e0e7ff;
}

.pending-stock-list-row__placeholder-icon {
  width: 48rpx;
  height: 48rpx;
}

.pending-stock-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.pending-stock-check--on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.pending-stock-check__tick {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.pending-stock-list-row__main {
  flex: 1;
  min-width: 0;
}

.pending-stock-list-row__body {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.pending-stock-list-row__content {
  flex: 1;
  min-width: 0;
}

.pending-stock-list-row__aside {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.pending-stock-list-row__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.pending-stock-list-row__pending {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning, #f59e0b);
  line-height: 1.3;
  white-space: nowrap;
}

.pending-stock-list-row__meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.pending-stock-list-row__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.pending-stock-list-row__action {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 10rpx;
  white-space: nowrap;
}

.pending-stock-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx var(--spacing-page);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.pending-stock-footer__batch {
  margin-bottom: 16rpx;
}

.pending-stock-batch-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-button);
  font-size: 30rpx;
  font-weight: 600;
}

.pending-stock-batch-btn--disabled {
  opacity: 0.45;
}

.pending-stock-footer__actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.pending-stock-footer__flow {
  flex: 1;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  background: var(--color-primary);
  border-radius: 16rpx;
}

.pending-stock-footer__flow-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.35;
}

.pending-stock-footer__scan {
  flex-shrink: 0;
  width: 120rpx;
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  background: var(--color-primary-light);
  border: 1rpx solid rgba(47, 107, 255, 0.28);
  border-radius: 16rpx;
}

.pending-stock-footer__scan:only-child {
  flex: 1;
  flex-direction: row;
  width: auto;
  gap: 12rpx;
  min-height: 88rpx;
}

.pending-stock-footer__scan-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-stock-footer__scan-icon {
  width: 44rpx;
  height: 44rpx;
}

.pending-stock-footer__scan-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.2;
  text-align: center;
}

.pending-stock-footer__flow:active {
  opacity: 0.88;
}

.pending-stock-footer__scan:active {
  opacity: 0.88;
}
