@import '../../pages/production-plans/production-plans.wxss';
@import '../production-order-material/production-order-material.wxss';

.material-confirm-page {
  padding: 0 var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}

.material-confirm-hero {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-confirm-hero__label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.material-confirm-hero__title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.material-confirm-wh {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-confirm-wh__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.material-confirm-wh__picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.material-confirm-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.material-confirm-submit {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.material-confirm-submit--return {
  background: #ff4d4f;
}

.material-confirm-submit--disabled {
  opacity: 0.5;
}

.material-row__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.material-row__form {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.material-row__batch-picker-wrap {
  flex: 1;
  min-width: 0;
}

.material-row__batch-picker {
  width: 100%;
  min-height: 72rpx;
  line-height: 1.3;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  background: #fff;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-row__qty-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

.material-row__batch-picker-wrap + .material-row__qty-wrap {
  flex: 0 0 auto;
}

.material-row__qty-input {
  width: 120rpx;
  height: 72rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  box-sizing: border-box;
}

.material-row__unit {
  min-width: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: nowrap;
}
