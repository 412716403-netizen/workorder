@import '../../styles/tab-shell.wxss';
@import '../../styles/list.wxss';

.scan-types {
  margin-bottom: 24rpx;
}

.scan-hub__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.scan-hub__card {
  position: relative;
  padding: 24rpx 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
  border-top-width: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.scan-hub__card--tone-0 { border-top-color: #0ea5e9; }
.scan-hub__card--tone-1 { border-top-color: #6366f1; }
.scan-hub__card--tone-2 { border-top-color: #34c759; }
.scan-hub__card--tone-3 { border-top-color: #ff9500; }

.scan-hub__card--disabled {
  opacity: 0.55;
}

.scan-hub__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-hub__icon {
  width: 40rpx;
  height: 40rpx;
}

.scan-hub__label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.scan-hub__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.scan-hub__lock {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.scan-history {
  padding-top: 20rpx;
}

.scan-history__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.scan-history__section-head {
  margin: 0;
  flex: 1;
}

.scan-history__more {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.scan-history-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.scan-history-row:last-child {
  border-bottom: none;
}

.scan-history-row__code {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  word-break: break-all;
}

.scan-history-row__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.scan-history-row__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.scan-pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
}

.scan-pill--success {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.scan-pill--pending {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.scan-pill--error {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}
