@import '../../styles/plan-list-shell.wxss';
@import '../../styles/tokens.wxss';

.msg-feed-shell {
  background: var(--color-bg-page);
}

.plan-tool-btn--disabled {
  opacity: 0.4;
}

.msg-feed-scroll {
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.msg-feed-body {
  padding: 8rpx var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
}

.msg-feed-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.msg-feed-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.msg-feed-row:last-child {
  border-bottom: none;
}

.msg-feed-row:active {
  background: #f5f7fb;
}

.msg-feed-row--unread {
  padding-left: 28rpx;
}

.msg-feed-row--unread .msg-feed-row__title {
  font-weight: 700;
}

.msg-feed-row--done .msg-feed-row__title {
  color: var(--color-text-secondary);
  font-weight: 500;
  text-decoration: line-through;
}

.msg-feed-row__dot {
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fa5151;
}

.msg-feed-row__main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.msg-feed-row__top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-feed-row__title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.msg-feed-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}

.msg-feed-tag--info {
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.12);
}

.msg-feed-tag--warning {
  color: var(--color-warning);
  background: var(--color-warning-bg);
}

.msg-feed-tag--success {
  color: var(--color-success);
  background: var(--color-success-bg);
}

.msg-feed-tag--danger {
  color: var(--color-danger);
  background: var(--color-danger-bg);
}

.msg-feed-tag--muted {
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
}

.msg-feed-row__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-feed-row__time {
  flex-shrink: 0;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}

.msg-feed-row__body {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.msg-feed-row__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 12rpx;
}

.msg-feed-row__meta-item {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.msg-feed-row__chevron {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 32rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.msg-feed-footer {
  padding: 20rpx 8rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
