@import '../../styles/tokens.wxss';

.chat-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg-page);
}

.chat-body {
  padding: 24rpx var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chat-empty {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.chat-bubble-row {
  display: flex;
}

.chat-bubble-row--left {
  justify-content: flex-start;
}

.chat-bubble-row--right {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
}

.chat-bubble--left {
  background: var(--color-bg-card);
  border-bottom-left-radius: 6rpx;
}

.chat-bubble--right {
  background: var(--color-primary-light);
  border-bottom-right-radius: 6rpx;
}

.chat-bubble__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.chat-bubble--right .chat-bubble__head {
  flex-direction: row-reverse;
}

.chat-tag {
  display: inline-flex;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 600;
}

.chat-tag--info {
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.12);
}

.chat-tag--warning {
  color: var(--color-warning);
  background: var(--color-warning-bg);
}

.chat-tag--success {
  color: var(--color-success);
  background: var(--color-success-bg);
}

.chat-tag--danger {
  color: var(--color-danger);
  background: var(--color-danger-bg);
}

.chat-tag--muted {
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
}

.chat-bubble__time {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.chat-bubble__title {
  display: block;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.chat-bubble__line {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-top: 4rpx;
  word-break: break-all;
}

.chat-bubble__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.chat-bubble--right .chat-bubble__meta {
  border-top-color: rgba(47, 107, 255, 0.12);
}

.chat-bubble__meta-item {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
