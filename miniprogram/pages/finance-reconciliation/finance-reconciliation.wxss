@import '../../pages/finance-receipts/finance-receipts.wxss';
@import '../../pages/production-order-report-history/production-order-report-history.wxss';

.fin-recon-page {
  padding: 0 var(--spacing-page) calc(40rpx + env(safe-area-inset-bottom));
}

.fin-recon-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-top: 32rpx;
  margin-bottom: 20rpx;
}

.fin-recon-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #64748b;
  border-radius: 12rpx;
}

.fin-recon-tab--active {
  background: #fff;
  color: #4f46e5;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.06);
}

.fin-recon-filter {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.fin-recon-filter__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.fin-recon-filter__row--dates {
  gap: 12rpx;
}

.fin-recon-filter__row--stack {
  display: block;
  margin-bottom: 16rpx;
}

.fin-recon-filter__label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
}

.fin-recon-filter__date-picker {
  flex: 1;
  min-width: 0;
}

.fin-recon-filter__date {
  padding: 14rpx 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.fin-recon-filter__date-sep {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
}

.fin-recon-mode-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.fin-recon-modes {
  display: flex;
  flex: 1;
  min-width: 0;
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 6rpx;
}

.fin-recon-mode {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  border-radius: 10rpx;
}

.fin-recon-mode--active {
  background: #fff;
  color: #4f46e5;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.fin-recon-query-btn {
  flex-shrink: 0;
  width: 160rpx;
  text-align: center;
  padding: 18rpx 12rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 14rpx;
}

.fin-recon-query-btn--disabled {
  opacity: 0.45;
}

.fin-recon-card__product {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.fin-recon-card__product-info {
  flex: 1;
  min-width: 0;
}

.fin-recon-card__product-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fin-recon-card__product-qty {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.fin-recon-search {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  height: 72rpx;
}

.fin-recon-search__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.fin-recon-search__clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 32rpx;
}

.fin-recon-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 55%, #818cf8 100%);
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.22);
}

.fin-recon-summary__label {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
  margin-bottom: 6rpx;
}

.fin-recon-summary__value {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.fin-recon-summary__loading {
  grid-column: 1 / -1;
  text-align: center;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  font-weight: 700;
  padding: 8rpx 0;
}

.fin-recon-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.fin-recon-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.fin-recon-card__doc-type {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.fin-recon-card__doc-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fin-recon-card__balance {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #4f46e5;
}

.fin-recon-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.fin-recon-card__meta-item {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
}

.fin-recon-card__amounts {
  display: flex;
  gap: 24rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.fin-recon-card__amt {
  flex: 1;
  min-width: 0;
}

.fin-recon-card__amt-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.fin-recon-card__amt-value {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.fin-recon-card__amt-value--inc {
  color: #0f172a;
}

.fin-recon-card__amt-value--dec {
  color: #059669;
}

.fin-recon-card__chevron {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #6366f1;
}
