<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">系统设置</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view class="settings-scroll" scroll-y show-scrollbar="{{false}}">
  <view class="settings-page">
    <view wx:if="{{loading}}" class="settings-muted">加载中…</view>

    <block wx:else>
      <view wx:for="{{categories}}" wx:key="key" class="settings-group">
        <view class="settings-group__title">{{item.title}}</view>
        <view class="settings-card">
          <view
            wx:for="{{item.items}}"
            wx:for-item="tab"
            wx:key="id"
            class="settings-row"
            data-id="{{tab.id}}"
            bindtap="onTabTap"
          >
            <view class="settings-row__icon-wrap">
              <image class="settings-row__icon" src="{{tab.icon}}" mode="aspectFit" />
            </view>
            <view class="settings-row__body">
              <view class="settings-row__title">{{tab.label}}</view>
              <view class="settings-row__sub">{{tab.sub}}</view>
            </view>
            <text class="settings-chevron">›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!categories.length}}" class="settings-muted">暂无可见设置项</view>
    </block>
  </view>
</scroll-view>
</view>
