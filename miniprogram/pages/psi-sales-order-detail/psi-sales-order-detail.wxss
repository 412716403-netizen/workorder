@import '../../pages/production-plan-detail/production-plan-detail.wxss';
@import '../../pages/production-order-detail/production-order-detail.wxss';
@import '../../pages/production-order-report-history/production-order-report-history.wxss';
@import '../../pages/production-order-report-batch-detail/production-order-report-batch-detail.wxss';
@import '../../styles/qty-price-amount-summary.wxss';

.po-detail-line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.po-detail-line:last-child {
  border-bottom: none;
}

.po-detail-line__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.po-detail-line__thumb {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.po-detail-line__img {
  width: 100%;
  height: 100%;
}

.po-detail-line__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
}

.po-detail-line__placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.po-detail-line__info {
  flex: 1;
  min-width: 0;
}

.po-line-progress--compact {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.po-line-progress--compact .po-line-progress__bar {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 8rpx;
}

.so-progress-bar {
  display: flex;
  height: 100%;
  border-radius: 4rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.so-progress-bar__shipped {
  background: #0ea5e9;
  height: 100%;
}

.so-progress-bar__alloc {
  background: #2f6bff;
  height: 100%;
}

.so-progress-bar__over {
  background: #ef4444;
  height: 100%;
}

.po-line-progress__nums {
  font-size: 22rpx;
  color: #9ca3af;
}

.po-line-progress__tag {
  font-size: 20rpx;
  color: #ef4444;
}

.po-detail-hero__partner {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.po-detail-hero__doc {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.po-detail-hero__pill-row {
  margin-top: 12rpx;
}

.so-detail-allocate {
  margin-top: 12rpx;
}

.so-detail-allocate__btn {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #eef2ff;
  border-radius: 12rpx;
}
