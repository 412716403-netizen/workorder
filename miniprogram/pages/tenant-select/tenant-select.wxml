<page-header title="选择企业" theme="primary" />

<scroll-view
  class="st-scroll auth-flow-scroll"
  scroll-y
  show-scrollbar="{{false}}"
  refresher-enabled
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh"
>
  <view class="auth-flow-body st-page st-page--flow auth-flow-page">
    <empty-state wx:if="{{loading && !tenants.length}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{!tenants.length}}" class="auth-flow-hero auth-flow-hero--inset">
      <view class="auth-flow-hero__icon-wrap">
        <image class="auth-flow-hero__icon" src="/assets/icons/building-2.png" mode="aspectFit" />
      </view>
      <view class="auth-flow-hero__title">暂无企业</view>
      <view class="auth-flow-hero__desc">您还没有加入任何企业，可先创建或申请加入</view>

      <view class="auth-flow-actions st-mt-lg">
        <button class="st-btn-primary" bindtap="onOnboardingCreate">创建新企业</button>
        <button class="st-btn-secondary" bindtap="onOnboardingJoin">加入企业</button>
      </view>
    </view>

    <view wx:else class="st-card">
      <view
        wx:for="{{tenants}}"
        wx:key="id"
        wx:for-item="item"
        class="st-list-cell {{item._disabled ? 'st-list-cell--disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapTenant"
      >
        <view class="st-tenant-icon {{item._iconClass}}">{{item._iconChar}}</view>
        <view class="st-list-cell__body">
          <view class="st-list-cell__title">{{item.name}}</view>
          <view class="st-list-cell__subtitle">{{item._roleLabel}}</view>
        </view>
        <view wx:if="{{item._showPill}}" class="st-pill st-pill--{{item._pill}}">{{item._statusLabel}}</view>
        <view wx:elif="{{loadingId === item.id}}" class="st-spinner">…</view>
        <view wx:else class="st-chevron">›</view>
      </view>
    </view>

    <view wx:if="{{tenants.length}}" class="auth-flow-actions st-mt-lg">
      <button class="st-btn-primary" bindtap="onOnboardingCreate">创建新企业</button>
      <button class="st-btn-secondary" bindtap="onOnboardingJoin">加入企业</button>
    </view>

    <view class="auth-flow-footer">
      <button class="st-btn-text auth-flow-footer__logout" bindtap="onLogout">退出登录</button>
    </view>
  </view>
</scroll-view>
