@import '../../pages/production-plans/production-plans.wxss';

.material-page {
  padding: 0 var(--spacing-page) calc(32rpx + env(safe-area-inset-bottom));
}

.material-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-row__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.material-row__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.material-row__form {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.material-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.material-submit {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.material-submit--disabled {
  opacity: 0.5;
}
