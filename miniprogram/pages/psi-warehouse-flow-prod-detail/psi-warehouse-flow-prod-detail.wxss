@import '../../pages/production-plans/production-plans.wxss';
@import '../../pages/production-order-detail/production-order-detail.wxss';
@import '../../styles/qty-price-amount-summary.wxss';

.wh-prod-detail-page {
  padding: 0 var(--spacing-page) 48rpx;
}

.wh-prod-detail-hero {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.wh-prod-detail-hero__badge {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #e8efff;
}

.wh-prod-detail-hero__doc {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.wh-prod-detail-hero__product {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}
