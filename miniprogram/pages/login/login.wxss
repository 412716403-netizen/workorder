@import '../../styles/tokens.wxss';

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 200rpx) var(--spacing-page) calc(env(safe-area-inset-bottom) + 40rpx);
  background: linear-gradient(160deg, #eff6ff 0%, #ffffff 42%, #eef2ff 100%);
  display: flex;
  flex-direction: column;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.login-hero__logo {
  width: 192rpx;
  height: 192rpx;
  margin-bottom: 20rpx;
}

.login-hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.login-hero__subtitle {
  margin-top: 10rpx;
  max-width: 520rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.45;
}

.login-card {
  background: var(--color-bg-card);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.08);
  border: 1rpx solid rgba(238, 240, 243, 0.9);
  padding: 40rpx var(--spacing-card) 36rpx;
}

.login-card__head {
  margin-bottom: 32rpx;
}

.login-card__title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.login-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.login-field {
  margin-bottom: 24rpx;
}

.login-field__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--font-caption);
  font-weight: 500;
  color: #374151;
}

.login-field__box {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1rpx solid #d1d5db;
  box-sizing: border-box;
}

.login-field__input {
  flex: 1;
  height: 100%;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.login-field__ph {
  color: var(--color-text-tertiary);
}

.login-field__toggle {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-small);
  color: var(--color-primary);
  font-weight: 500;
  padding: 8rpx 0;
}

.login-submit {
  width: 100%;
  margin: 16rpx 0 0;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.25;
  background: #2563eb;
  color: var(--color-text-inverse);
  border: none;
  box-sizing: border-box;
}

.login-submit::after {
  border: none;
}

.login-submit[disabled] {
  opacity: 0.45;
}

.login-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0 8rpx;
  gap: 16rpx;
}

.login-divider__line {
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
}

.login-divider__text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.login-wechat-wrap {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.login-wechat {
  width: 72rpx !important;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  overflow: visible;
}

.login-wechat::after {
  border: none;
}

.login-wechat__icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.login-wechat--hover {
  opacity: 0.88;
}

.login-wechat[disabled],
.login-wechat--loading {
  opacity: 0.45;
}

.login-cancel-bind {
  width: 100%;
  margin: 20rpx 0 0;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: var(--font-small);
  font-weight: 500;
  line-height: 1.25;
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  box-sizing: border-box;
}

.login-cancel-bind::after {
  border: none;
}

.login-footer {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-top: 40rpx;
}

.login-footer__text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
