<view class="login-page">
  <view class="login-hero">
    <image class="login-hero__logo" src="{{logoPath}}" mode="aspectFit" />
    <view class="login-hero__title">{{brandName}}</view>
    <view class="login-hero__subtitle">{{brandTagline}}</view>
  </view>

  <view class="login-card">
    <view class="login-card__head">
      <text class="login-card__title">{{bindMode ? '绑定微信' : '账号登录'}}</text>
      <text class="login-card__desc">{{bindMode ? '首次使用需用系统账号密码完成绑定，之后可一键登录' : '请使用手机号或用户名与密码登录'}}</text>
    </view>

    <view class="login-field">
      <view class="login-field__label">手机号或用户名</view>
      <view class="login-field__box">
        <input
          class="login-field__input"
          value="{{username}}"
          bindinput="onUser"
          placeholder="请输入手机号或用户名"
          placeholder-class="login-field__ph"
        />
      </view>
    </view>

    <view class="login-field">
      <view class="login-field__label">密码</view>
      <view class="login-field__box">
        <input
          class="login-field__input"
          password="{{!showPassword}}"
          value="{{password}}"
          bindinput="onPass"
          placeholder="请输入密码"
          placeholder-class="login-field__ph"
        />
        <text class="login-field__toggle" bindtap="onTogglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <button
      class="login-submit"
      loading="{{loading}}"
      disabled="{{loading || wechatLoading}}"
      bindtap="onLogin"
    >{{bindMode ? '绑定并登录' : '登 录'}}</button>

    <block wx:if="{{!bindMode}}">
      <view class="login-divider">
        <view class="login-divider__line"></view>
        <text class="login-divider__text">或</text>
        <view class="login-divider__line"></view>
      </view>

      <view class="login-wechat-wrap">
        <button
          class="login-wechat {{wechatLoading ? 'login-wechat--loading' : ''}}"
          loading="{{wechatLoading}}"
          disabled="{{loading || wechatLoading}}"
          bindtap="onWechatLogin"
          aria-label="微信登录"
          hover-class="login-wechat--hover"
        >
          <image
            wx:if="{{!wechatLoading}}"
            class="login-wechat__icon"
            src="/assets/icons/wechat.png"
            mode="aspectFit"
          />
        </button>
      </view>
    </block>

    <button
      wx:else
      class="login-cancel-bind"
      disabled="{{loading}}"
      bindtap="onCancelBind"
    >取消，返回登录</button>
  </view>

  <view class="login-footer">
    <text class="login-footer__text">{{brandName}} · 与网页端账号互通</text>
  </view>
</view>
