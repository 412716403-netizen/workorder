@import '../../pages/psi-purchase-order-edit/psi-purchase-order-edit.wxss';

.pb-edit-mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pb-edit-mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: #f3f4f6;
}

.pb-edit-mode-tab--active {
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.1);
}

.pb-edit-wh-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.pb-edit-wh-picker__label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.pb-edit-wh-picker__label--req::before {
  content: '*';
  color: #ef4444;
  margin-right: 4rpx;
}

.pb-edit-wh-picker__value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.pb-edit-wh-picker__chevron {
  margin-left: 8rpx;
  color: var(--color-text-tertiary);
}

.pb-from-order-search {
  margin-bottom: 16rpx;
}

.pb-from-order-search__input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.pb-po-doc {
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.pb-po-doc__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.pb-po-doc__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.pb-po-doc__meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.pb-po-line {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.pb-po-line:last-child {
  border-bottom: none;
}

.pb-po-line__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.pb-po-line__check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-top: 4rpx;
}

.pb-po-line__check--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.pb-po-line__info {
  flex: 1;
  min-width: 0;
}

.pb-po-line__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.pb-po-line__sku {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-left: 8rpx;
}

.pb-po-line__remain {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.pb-po-line__inputs {
  margin-top: 12rpx;
}

.pb-from-order-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
