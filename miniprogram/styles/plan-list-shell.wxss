@import './tokens.wxss';
@import './list.wxss';
@import './todo-entry.wxss';

page {
  background: var(--color-bg-page);
}

.plan-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.plan-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-bottom: 28rpx;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.plan-filter-panel--header-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 210;
  margin: 0;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.plan-header__bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 8rpx;
  box-sizing: border-box;
}

.plan-header__back {
  width: 64rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.98);
  line-height: 1;
}

.plan-header__back--placeholder {
  visibility: hidden;
  pointer-events: none;
}

.plan-header__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-header__tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 0 32rpx;
}

.plan-search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
}

.plan-search__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.plan-search__input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.plan-search__ph {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.plan-search__clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 36rpx;
  flex-shrink: 0;
}

.plan-tool-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
}

.plan-tool-btn--active {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
}

.plan-tool-btn__icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
  opacity: 0.92;
}

.plan-tool-btn--active .plan-tool-btn__icon {
  opacity: 1;
}

.plan-header-spacer {
  flex-shrink: 0;
}

.plan-filter-panel {
  margin: 0 0 16rpx;
  padding: 24rpx var(--spacing-page) 20rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.plan-filter-panel__section {
  margin-bottom: 20rpx;
}

.plan-filter-panel__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.plan-filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plan-filter-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
}

.plan-filter-chip--active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: transparent;
  font-weight: 600;
}

.plan-filter-panel__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}

.plan-filter-switch {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #e5e7eb;
  position: relative;
}

.plan-filter-switch--on {
  background: var(--color-primary);
}

.plan-filter-switch__knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s;
}

.plan-filter-switch--on .plan-filter-switch__knob {
  transform: translateX(36rpx);
}

.plan-filter-panel__foot {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.plan-filter-reset,
.plan-filter-apply {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 600;
}

.plan-filter-reset {
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
}

.plan-filter-apply {
  color: var(--color-text-inverse);
  background: var(--color-primary);
}

.plan-list-body {
  flex: 1;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.plan-list-wrap {
  background: var(--color-bg-card);
}

.plan-list-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx var(--spacing-page);
  border-bottom: 1rpx solid var(--color-border);
}

.plan-list-row:last-child {
  border-bottom: none;
}

.plan-list-row__left {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.plan-list-row__thumb {
  flex-shrink: 0;
}

.plan-list-row__side-tags {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.plan-list-row__side-tag {
  display: block;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

.plan-list-row__side-tag--cat {
  font-weight: 600;
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
}

.plan-list-row__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-page);
  display: block;
}

.plan-list-row__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  border-color: #e0e7ff;
}

.plan-list-row__placeholder-icon {
  width: 44rpx;
  height: 44rpx;
}

.plan-list-row__main {
  flex: 1;
  min-width: 0;
}

.plan-list-row__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
}

.plan-list-row__head .st-pill {
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.plan-list-row__number {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.plan-list-row__meta {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.plan-list-row__qty {
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-primary-dark);
  flex-shrink: 0;
}

.plan-list-row__product-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.plan-list-row__product {
  flex-shrink: 1;
  min-width: 0;
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-list-row__sku {
  flex-shrink: 0;
  max-width: 48%;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-list-row__tag {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-list-row__custom-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.plan-list-row__sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx 8rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.plan-list-row__sub-customer {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  max-width: 100%;
}

.plan-list-row__sub-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.plan-list-row__sub-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-list-row__sub-customer .plan-list-row__sub-text {
  flex: 1;
  min-width: 0;
}

.plan-list-row__sub-sep {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.plan-list-row__chevron {
  align-self: center;
  margin-top: 0;
  font-size: 36rpx;
}

.plan-list-row__actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  justify-content: center;
  align-self: center;
}

.plan-list-row__action {
  box-sizing: border-box;
  min-width: 88rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  border: 1rpx solid var(--color-primary-light);
  background: #fff;
}

.plan-list-row__action--detail {
  color: var(--color-primary);
}

.plan-list-row__action--convert {
  color: #fff;
  background: #0f172a;
  border-color: #0f172a;
}

.plan-list-row__action--supplement {
  color: #fff;
  background: #f59e0b;
  border-color: #f59e0b;
}

.plan-list-row__action--order {
  color: var(--color-primary);
  background: #eef2ff;
  border-color: #c7d2fe;
}

.plan-list-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.plan-list-progress__track {
  flex: 1;
  max-width: 200rpx;
  height: 8rpx;
  background: #eef0f3;
  border-radius: 4rpx;
  overflow: hidden;
}

.plan-list-progress__track--split {
  display: flex;
}

.plan-list-progress__bar {
  height: 100%;
  background: var(--color-primary);
  border-radius: 4rpx;
}

.plan-list-progress__bar--complete,
.plan-list-progress__bar--ordered {
  background: var(--color-success);
  border-radius: 0;
}

.plan-list-progress__bar--over {
  background: var(--color-danger);
  border-radius: 0;
}

.plan-list-progress__text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.plan-list-progress__text--done {
  color: var(--color-success);
}

.plan-list-empty {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-list-footer {
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-small);
  color: var(--color-text-tertiary);
}
