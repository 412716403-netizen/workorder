@import './plan-create-form.wxss';
@import './qty-price-amount-summary.wxss';

.po-edit-qty-price-row {
  margin-top: 0;
}

.po-edit-line {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.po-edit-line__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.po-edit-line__product-select {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.po-edit-line__product-select .sps {
  margin-bottom: 0;
}

.po-edit-line__product-select .sps__trigger,
.po-edit-line__product-select .sps__trigger--embedded {
  justify-content: flex-start;
  padding: 16rpx 0;
  gap: 8rpx;
  background: transparent;
  border-bottom: none;
  box-shadow: none;
}

.po-edit-line__product-select .sps__label--embedded {
  flex-shrink: 0;
  min-width: 0;
  width: auto;
  margin-right: 0;
}

.po-edit-line__product-select .sps__trigger--embedded .sps__value-wrap {
  flex: 1;
  min-width: 0;
  align-items: baseline;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 8rpx;
}

.po-edit-line__product-select .sps__value {
  flex: 0 1 auto;
  min-width: 0;
  text-align: left;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.po-edit-line__product-select .sps__value-sku {
  flex: 0 0 auto;
  max-width: none;
  text-align: left;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-tertiary, #9ca3af);
}

.po-edit-line__product-select .sps__value--placeholder {
  flex: 0 1 auto;
  text-align: left;
  font-size: 28rpx;
  font-weight: 500;
}

.po-edit-line__product-select .sps__chevron {
  flex-shrink: 0;
  margin-left: auto;
}

.po-edit-line__remove {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ef4444;
  padding: 8rpx 12rpx;
}

.po-edit-matrix-wrap {
  margin-top: 8rpx;
}

.po-edit-matrix-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.po-edit-matrix-head__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.po-edit-matrix-head__hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.po-edit-add-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  color: #2f6bff;
  font-size: 28rpx;
}

.plan-create-footer.po-edit-footer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  box-sizing: border-box;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.plan-create-footer.po-edit-footer .po-edit-footer__summary {
  width: 100%;
  flex: none;
  min-width: 0;
  justify-content: flex-start;
  gap: 32rpx;
}

.plan-create-footer.po-edit-footer .po-edit-footer__actions {
  width: 100%;
  flex: none;
  gap: 16rpx;
}

.plan-create-footer.po-edit-footer .po-edit-footer__btn {
  flex: 1;
  min-width: 0;
  max-width: none;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 16rpx;
}

.plan-create-footer.po-edit-footer .po-edit-footer__btn--danger {
  background: #fff;
  color: var(--color-danger);
  border: 1rpx solid rgba(255, 77, 79, 0.35);
}

.plan-create-footer.po-edit-footer .po-edit-footer__btn--primary {
  min-width: 0;
}

.po-edit-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.po-edit-footer__summary {
  flex: 1 1 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  gap: 24rpx;
  min-width: 220rpx;
  overflow: hidden;
}

.po-edit-footer__stat {
  flex: 0 0 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.po-edit-footer__summary-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.po-edit-footer__summary-value {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.po-edit-footer__actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.po-edit-footer__btn {
  flex: none;
  margin: 0;
  padding: 0 28rpx;
  min-width: 112rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-button);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-sizing: border-box;
}

.po-edit-footer__btn::after {
  border: none;
}

.po-edit-footer__btn--primary {
  background: var(--color-primary);
  color: #fff;
  min-width: 136rpx;
}

.po-edit-footer__btn--danger {
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-danger);
}

.po-edit-footer__btn--hover {
  opacity: 0.88;
}

.po-edit-footer__btn--primary[disabled] {
  opacity: 0.45;
}
