@import './tokens.wxss';
@import './plan-form-cell.wxss';
@import './doc-entry-datetime.wxss';
@import './matrix-keyboard-page.wxss';

page {
  background: var(--color-bg-page);
  height: 100%;
}

.plan-create-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.plan-create-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-bottom: 12rpx;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.plan-create-header__bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 8rpx;
  box-sizing: border-box;
}

.plan-create-header__back {
  width: 64rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.98);
  line-height: 1;
}

.plan-create-header__back--placeholder {
  visibility: hidden;
  pointer-events: none;
}

.plan-create-header__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-create-header-spacer {
  flex-shrink: 0;
}

.plan-create-scroll {
  flex: 1;
  width: 100%;
}

.plan-create-page {
  padding: 16rpx var(--spacing-page) calc(240rpx + env(safe-area-inset-bottom));
}

.plan-form-card {
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.plan-form-card .sps--cell:last-child .plan-form-cell {
  border-bottom: none;
}

.plan-form-card .plan-create-matrix-wrap:last-child {
  border-bottom: none;
}

.plan-form-cell--matrix-head {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.plan-form-cell__hint {
  flex: 1;
  text-align: right;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-create-matrix-wrap {
  padding-bottom: 0;
}

.plan-create-matrix-scroll {
  width: 100%;
  padding: 0 var(--spacing-card) 20rpx;
  box-sizing: border-box;
}

.plan-create-matrix {
  min-width: 100%;
  display: inline-block;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  box-sizing: border-box;
}

.plan-create-matrix__head,
.plan-create-matrix__row {
  display: flex;
  align-items: stretch;
}

.plan-create-matrix__head {
  background: linear-gradient(180deg, var(--color-primary-light) 0%, rgba(234, 241, 255, 0.45) 100%);
  border-bottom: 1rpx solid rgba(47, 107, 255, 0.1);
}

.plan-create-matrix__corner,
.plan-create-matrix__color {
  width: 152rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.plan-create-matrix__corner {
  display: flex;
  align-items: center;
  padding: 14rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  letter-spacing: 1rpx;
}

.plan-create-matrix__size {
  flex: 1;
  min-width: 72rpx;
  max-width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 6rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.plan-create-matrix__row {
  border-bottom: 1rpx solid var(--color-border);
  align-items: stretch;
}

.plan-create-matrix__row:last-child {
  border-bottom: none;
}

.plan-create-matrix__row:nth-child(even) {
  background: rgba(247, 248, 250, 0.9);
}

.plan-create-matrix__color {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  border-right: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.55);
}

.plan-create-matrix__swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.plan-create-matrix__color-text {
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-create-matrix__cell {
  flex: 1;
  min-width: 72rpx;
  max-width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
}

.plan-create-matrix__input {
  width: 100%;
  height: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 6rpx;
  background: var(--color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  box-sizing: border-box;
  border: 1rpx solid #c9cdd4;
  font-variant-numeric: tabular-nums;
}

.plan-create-matrix__input--empty {
  background: var(--color-bg-input);
  border: 1rpx dashed #b0b4bc;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.plan-create-matrix__input--filled {
  background: #fff;
  border: 1rpx solid #b0b4bc;
  color: var(--color-text-primary);
  box-shadow: none;
}

.plan-create-matrix__input--active {
  background: #fff;
  border: 2rpx solid var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(47, 107, 255, 0.18);
  color: var(--color-primary);
  font-weight: 700;
}

.plan-create-matrix__input--active.plan-create-matrix__input--empty {
  color: var(--color-text-tertiary);
}

.plan-create-matrix__input--active.plan-create-matrix__input--filled.plan-create-matrix__input--replace {
  background: var(--color-primary-light);
}

.plan-create-page--keyboard {
  /* 保留别名，实际占位见 matrix-keyboard-page.wxss */
}

.plan-create-matrix__dash {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
}

.plan-create-muted {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-create-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.plan-create-submit {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border: none;
}

.plan-create-submit::after {
  border: none;
}

.plan-create-submit[disabled] {
  opacity: 0.45;
}
