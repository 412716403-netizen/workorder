/** 底部主扫码按钮（与 scan-batch-modal 一致） */

.trace-scan-footer,
.scan-primary-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 250, 252, 0) 0%, #f8fafc 24rpx, #f8fafc 100%);
  box-sizing: border-box;
}

.scan-batch-scan-btn {
  width: 100%;
  height: auto;
  min-height: 104rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b7dff 0%, #2f6bff 100%);
  box-shadow: 0 12rpx 32rpx rgba(47, 107, 255, 0.32);
}

.scan-batch-scan-btn::after {
  border: none;
}

.scan-batch-scan-btn--hover {
  opacity: 0.92;
  transform: scale(0.99);
}

.scan-batch-scan-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.scan-batch-scan-btn__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 0 32rpx;
}

.scan-batch-scan-btn__icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.scan-batch-scan-btn__icon-frame {
  position: absolute;
  inset: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.scan-batch-scan-btn__icon-line {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 50%;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
}

.scan-batch-scan-btn__text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
