/** 报工 Tab「我的报工」/ 报工待审列表卡片（与 pages/scan/scan.wxss 对齐） */
.worker-report-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: var(--radius-card, 24rpx);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.worker-report-card__thumb {
  flex-shrink: 0;
}

.worker-report-card__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--color-border, #e5e7eb);
  background: #fff;
  display: block;
}

.worker-report-card__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  border-color: #e0e7ff;
}

.worker-report-card__placeholder-icon {
  width: 44rpx;
  height: 44rpx;
}

.worker-report-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.worker-report-card__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.worker-report-card__time {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #a0a4ab);
}

.worker-report-card__report-no {
  font-size: 22rpx;
  color: var(--color-text-secondary, #646a73);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.worker-report-card__order-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.worker-report-card__order-line .worker-report-card__report-no {
  font-size: 20rpx;
}

.worker-report-card__order {
  font-size: 26rpx;
  color: var(--color-primary, #2f6bff);
  font-weight: 500;
}

.worker-report-card__product-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.worker-report-card__product {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
}

.worker-report-card__sku {
  font-size: 24rpx;
  color: var(--color-text-secondary, #8f959e);
}

.worker-report-card__side {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.worker-report-card__side--mine {
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.worker-report-card__qty {
  font-size: 28rpx;
  color: var(--color-text-primary, #1f2329);
  font-weight: 600;
  white-space: nowrap;
}

.worker-report-card__defective {
  font-size: 22rpx;
  color: #b45309;
  white-space: nowrap;
}

.worker-report-card__detail-btn {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 10rpx;
  line-height: 1.3;
}

.worker-report-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.worker-report-badge--pending {
  color: #b45309;
  background: #fff7ed;
}

.worker-report-badge--approved {
  color: #047857;
  background: #ecfdf5;
}

.worker-report-badge--rejected {
  color: #b91c1c;
  background: #fef2f2;
}
