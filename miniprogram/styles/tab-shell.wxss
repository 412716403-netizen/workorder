
.tab-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-page);
}

.tab-header {
  flex-shrink: 0;
  padding: 0 28rpx 28rpx;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.tab-header__main {
  padding-top: 0;
}

.tab-header__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.98);
  line-height: 1.25;
}

.tab-header__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.4;
}

.tab-scroll {
  flex: 1;
  min-height: 0;
}

.tab-body {
  margin-top: -24rpx;
  padding: 28rpx var(--spacing-page) calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 32rpx);
  border-radius: 32rpx 32rpx 0 0;
  background: var(--color-bg-page);
  min-height: 100%;
  box-sizing: border-box;
}

.tab-section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 16rpx;
}

.tab-section-head__accent {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  flex-shrink: 0;
}

.tab-section-head__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.tab-panel {
  margin-bottom: 24rpx;
  padding: var(--spacing-card);
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.tab-panel--flush {
  padding: 0;
}

.tab-empty-inline {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 0;
}

.tab-user__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.98);
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.38);
}

.tab-user__info {
  flex: 1;
  min-width: 0;
}

.tab-user__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-user__tenant {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
