@import './tokens.wxss';

.plan-form-cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 24rpx var(--spacing-card);
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.plan-form-cell--last {
  border-bottom: none;
}

.plan-form-cell--input {
  gap: 16rpx;
}

.plan-form-cell__label {
  flex-shrink: 0;
  min-width: 160rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.plan-form-cell__label--sm {
  min-width: 0;
  flex: 1;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-form-cell__req {
  color: #ff4d4f;
  margin-right: 4rpx;
}

.plan-form-cell__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-body);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-form-cell__value--ph {
  color: var(--color-text-tertiary);
}

.plan-form-cell__input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.plan-form-cell__ph {
  color: var(--color-text-tertiary);
  font-size: var(--font-body);
}

.plan-form-cell__chevron {
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}
