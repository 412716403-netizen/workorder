@import '../psi-purchase-order-edit/psi-purchase-order-edit.wxss';

.wh-edit-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.wh-edit-picker:last-child {
  border-bottom: none;
}

.wh-edit-picker__label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.wh-edit-picker__label--req::before {
  content: '*';
  color: #ef4444;
  margin-right: 4rpx;
}

.wh-edit-picker__value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.wh-edit-picker__chevron {
  margin-left: 8rpx;
  color: var(--color-text-tertiary);
}

.plan-form-cell--input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.plan-form-cell__input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.plan-form-cell__ph {
  color: var(--color-text-tertiary);
}

.plan-create-matrix__cell-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.plan-create-matrix__sys {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.plan-create-matrix__cell .plan-create-matrix__input {
  min-height: 56rpx;
  height: 56rpx;
}
