@import '/packagePsi/styles/production-plans-page.wxss';
@import '/packagePsi/styles/production-orders-page.wxss';
@import '/packagePsi/styles/report-history-page.wxss';
@import '/packagePsi/styles/qty-price-amount-summary.wxss';

.po-orders-page {
  padding: 0 var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
}

.po-doc-card {
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.so-doc-card__head {
  padding: 20rpx 24rpx 14rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.so-doc-card__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.so-doc-card__title-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.so-doc-card__name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 12rpx;
}

.so-doc-card__title-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding-top: 2rpx;
}

.so-doc-card__partner {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.so-doc-card__doc {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.so-doc-card__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  margin: 0;
  line-height: 1.3;
}

.po-doc-card__meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.po-doc-card__meta-item--operator {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.po-doc-card__meta-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.po-doc-card__qty,
.po-doc-card__amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.po-doc-card__line-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.po-doc-card__lines {
  padding: 0;
}

.so-doc-card__line {
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.so-doc-card__line:last-child {
  border-bottom: none;
}

.so-doc-card__line .report-history-row__body {
  gap: 14rpx;
}

.so-doc-card__line .report-history-row__left {
  width: 88rpx;
}

.so-doc-card__line .report-history-row__img {
  width: 88rpx;
  height: 88rpx;
}

.so-line-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.so-line-main__left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.so-line-main__right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.so-line-allocate-col {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.po-line-progress__tag {
  font-size: 20rpx;
  color: #ef4444;
}

.so-list-allocate__btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 10rpx;
  line-height: 1.3;
}

.so-list-allocate__done {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 10rpx;
  line-height: 1.3;
}

.so-list-alloc-progress__text {
  font-size: 20rpx;
  color: var(--color-text-primary, #1f2329);
  line-height: 1.35;
  text-align: right;
  white-space: nowrap;
}
