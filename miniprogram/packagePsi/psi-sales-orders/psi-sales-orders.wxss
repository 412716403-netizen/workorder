@import '/styles/production-plans-page.wxss';
@import '/styles/production-orders-page.wxss';
@import '/styles/report-history-page.wxss';
@import '../../styles/qty-price-amount-summary.wxss';

.po-orders-page {
  padding: 0 var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
}

.po-doc-card {
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.po-doc-card__head {
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.po-doc-card__title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.so-doc-card__partner {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.so-doc-card__doc {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.po-doc-card__doc {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.po-doc-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-bottom: 10rpx;
}

.po-doc-card__meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.po-doc-card__meta-item--operator {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.po-doc-card__meta-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.po-doc-card__totals {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
}

.po-doc-card__qty,
.po-doc-card__amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.po-doc-card__line-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.po-doc-card__lines {
  padding: 8rpx 0 0;
}

.po-doc-card__line {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.po-doc-card__line:last-child {
  border-bottom: none;
}

.po-doc-card__line .report-history-row__body {
  gap: 16rpx;
}

.po-doc-card__line .report-history-row__left {
  width: 96rpx;
}

.po-doc-card__line .report-history-row__img {
  width: 96rpx;
  height: 96rpx;
}

.po-line-progress--compact {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.po-line-progress--compact .po-line-progress__bar {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 8rpx;
}

.so-progress-bar {
  display: flex;
  height: 100%;
  border-radius: 4rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.so-progress-bar__shipped {
  background: #0ea5e9;
  height: 100%;
}

.so-progress-bar__alloc {
  background: #2f6bff;
  height: 100%;
}

.so-progress-bar__over {
  background: #ef4444;
  height: 100%;
}

.po-line-progress__nums {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.po-line-progress__tag {
  font-size: 20rpx;
  color: #ef4444;
}

.po-line-progress--product {
  flex-shrink: 0;
}

.so-line-progress-col {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  max-width: 62%;
}

.so-list-alloc-progress__text {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.35;
  text-align: right;
}

.so-list-allocate__btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 10rpx;
  line-height: 1.3;
}
