<view class="plan-create-shell">
  <view class="plan-create-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-create-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-create-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-create-header__title">{{title}}</text>
      <view class="plan-create-header__back plan-create-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-create-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-create-scroll"
    scroll-y
    scroll-top="{{matrixScrollTop}}"
    scroll-with-animation
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view wx:if="{{loading}}" class="plan-create-muted">加载中…</view>

    <view wx:else class="plan-create-page {{matrixKeyboardVisible ? 'matrix-keyboard-page--open' : ''}}">
      <view wx:if="{{!editing}}" class="pb-edit-mode-tabs">
        <view
          class="pb-edit-mode-tab {{creationMethod === 'MANUAL' ? 'pb-edit-mode-tab--active' : ''}}"
          data-method="MANUAL"
          bindtap="onCreationMethodTap"
        >手动创建</view>
        <view
          class="pb-edit-mode-tab {{creationMethod === 'FROM_ORDER' ? 'pb-edit-mode-tab--active' : ''}}"
          data-method="FROM_ORDER"
          bindtap="onCreationMethodTap"
        >引用采购订单</view>
      </view>

      <view class="plan-form-card">
        <view class="plan-form-cell">
          <text class="plan-form-cell__label">创建时间</text>
          <view class="report-batch-edit__datetime">
            <picker mode="date" value="{{form.createdAt}}" bindchange="onCreatedAtChange">
              <view class="report-batch-edit__picker">{{form.createdAt || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{form.createdAtTime}}" bindchange="onCreatedAtTimeChange">
              <view class="report-batch-edit__picker">{{form.createdAtTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>

        <picker
          wx:if="{{warehouseNames.length}}"
          mode="selector"
          range="{{warehouseNames}}"
          value="{{warehouseIndex}}"
          bindchange="onWarehouseChange"
        >
          <view class="pb-edit-wh-picker">
            <text class="pb-edit-wh-picker__label pb-edit-wh-picker__label--req">入库仓库</text>
            <text class="pb-edit-wh-picker__value">{{warehouseNames[warehouseIndex] || '请选择'}}</text>
            <text class="pb-edit-wh-picker__chevron">›</text>
          </view>
        </picker>

        <block wx:if="{{creationMethod === 'MANUAL' || editing}}">
          <searchable-partner-select
            cell="{{true}}"
            required="{{true}}"
            label="供应商"
            partners="{{partners}}"
            categories="{{partnerCategories}}"
            value="{{form.partner}}"
            placeholder="请选择"
            bind:change="onPartnerChange"
            bind:created="onPartnerCreated"
          />
          <view wx:if="{{form.docNumber}}" class="plan-form-cell">
            <text class="plan-form-cell__label">单号</text>
            <text class="plan-form-cell__value">{{form.docNumber}}</text>
          </view>
        </block>
      </view>

      <block wx:if="{{creationMethod === 'MANUAL' || editing}}">
        <view class="plan-form-card">
          <view wx:for="{{lines}}" wx:key="id" class="po-edit-line">
            <view class="po-edit-line__head">
              <view class="po-edit-line__product-select">
                <searchable-product-select
                  embedded="{{true}}"
                  required="{{true}}"
                  label=""
                  products="{{products}}"
                  categories="{{categories}}"
                  value-id="{{item.productId}}"
                  value-name="{{item.productName}}"
                  placeholder="请选择产品"
                  data-line-id="{{item.id}}"
                  bind:change="onLineProductChange"
                />
              </view>
              <text
                wx:if="{{lines.length > 1 || item.productId}}"
                class="po-edit-line__remove"
                data-line-id="{{item.id}}"
                catchtap="onRemoveLine"
              >删除</text>
            </view>

            <view wx:if="{{item.productId}}" class="order-detail-summary order-detail-summary--form po-edit-qty-price-row">
              <view wx:if="{{item.showBatch}}" class="order-detail-summary__item">
                <text class="order-detail-summary__label">批次</text>
                <batch-return-input
                  value="{{item.batch}}"
                  product-id="{{item.productId}}"
                  warehouse-id="{{form.warehouseId}}"
                  merge-batches="{{item.mergeBatches}}"
                  data-line-id="{{item.id}}"
                  bind:change="onLineBatchChange"
                />
              </view>
              <view class="order-detail-summary__item">
                <text class="order-detail-summary__label"><text wx:if="{{!item.useMatrix}}" class="plan-form-cell__req">*</text>数量</text>
                <input
                  wx:if="{{!item.useMatrix}}"
                  class="order-detail-summary__input order-detail-summary__input--box"
                  type="digit"
                  value="{{item.quantity}}"
                  data-line-id="{{item.id}}"
                  bindinput="onLineQtyInput"
                  placeholder="0"
                  placeholder-class="order-detail-summary__ph"
                />
                <text wx:else class="order-detail-summary__value order-detail-summary__value--box">{{item.lineTotalQty !== 0 ? item.lineTotalQty : '—'}}</text>
                <text wx:if="{{item.useMatrix}}" class="order-detail-summary__hint">色码录入</text>
              </view>
              <view wx:if="{{showAmount}}" class="order-detail-summary__item">
                <text class="order-detail-summary__label">单价</text>
                <input
                  class="order-detail-summary__input order-detail-summary__input--box"
                  type="digit"
                  value="{{item.purchasePrice}}"
                  data-line-id="{{item.id}}"
                  bindinput="onLinePriceInput"
                  placeholder="0"
                  placeholder-class="order-detail-summary__ph"
                />
              </view>
              <view wx:if="{{showAmount}}" class="order-detail-summary__item">
                <text class="order-detail-summary__label">金额</text>
                <text class="order-detail-summary__value order-detail-summary__value--box order-detail-summary__value--muted">{{item.lineAmountText || '—'}}</text>
              </view>
            </view>

            <block wx:if="{{item.productId && item.useMatrix && item.matrixLayout}}">
              <view class="plan-create-matrix-wrap po-edit-matrix-wrap">
                <view class="po-edit-matrix-head">
                  <text class="po-edit-matrix-head__title">色码数量</text>
                  <text wx:if="{{item.lineTotalQty !== 0}}" class="po-edit-matrix-head__hint">{{item.unitName}}</text>
                </view>
                <scroll-view class="plan-create-matrix-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                  <view class="plan-create-matrix">
                    <view class="plan-create-matrix__head">
                      <view class="plan-create-matrix__corner">颜色</view>
                      <view wx:for="{{item.matrixLayout.sizeColumns}}" wx:key="id" class="plan-create-matrix__size">{{item.header}}</view>
                    </view>
                    <view wx:for="{{item.matrixLayout.colorRows}}" wx:for-item="row" wx:key="key" class="plan-create-matrix__row">
                      <view class="plan-create-matrix__color">
                        <view wx:if="{{row.colorSwatch}}" class="plan-create-matrix__swatch" style="background-color: {{row.colorSwatch}};" />
                        <text class="plan-create-matrix__color-text">{{row.colorLabel}}</text>
                      </view>
                      <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="plan-create-matrix__cell">
                        <view
                          wx:if="{{cell.variantId}}"
                          class="plan-create-matrix__input {{activeLineId === item.id && activeMatrixVariantId === cell.variantId ? 'plan-create-matrix__input--active' : ''}} {{activeLineId === item.id && activeMatrixVariantId === cell.variantId && matrixInputReplaceAll && cell.quantity ? 'plan-create-matrix__input--replace' : ''}} {{cell.quantity ? 'plan-create-matrix__input--filled' : 'plan-create-matrix__input--empty'}}"
                          data-line-id="{{item.id}}"
                          data-variant-id="{{cell.variantId}}"
                          bindtap="onMatrixCellTap"
                        >{{cell.quantity}}</view>
                        <text wx:else class="plan-create-matrix__dash">—</text>
                      </view>
                    </view>
                  </view>
                </scroll-view>
              </view>
            </block>
          </view>

          <view class="po-edit-add-line" bindtap="onAddLine">
            <text>+ 添加明细</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{!editing}}">
        <view class="pb-from-order-search">
          <input
            class="pb-from-order-search__input"
            value="{{fromOrderSearch}}"
            bindinput="onFromOrderSearchInput"
            placeholder="搜索订单号 / 供应商 / 关联产品 / 产品"
          />
        </view>

        <view wx:if="{{!pendingPoDocs.length}}" class="pb-from-order-empty">暂无待入库采购订单</view>

        <view wx:for="{{pendingPoDocs}}" wx:key="docNumber" class="pb-po-doc">
          <view class="pb-po-doc__head" data-doc-number="{{item.docNumber}}" bindtap="onPoDocToggle">
            <view class="pb-po-doc__head-main">
              <text class="pb-po-doc__title">{{item.docNumber}}</text>
              <view class="pb-po-doc__meta">
                {{item.partner}}
                <text wx:if="{{item.relatedProductText}}" class="pb-po-doc__related"> · 关联 {{item.relatedProductText}}</text>
                · {{item.lineCount}} 项待入
              </view>
            </view>
            <text>{{item.expanded ? '▾' : '▸'}}</text>
          </view>

          <block wx:if="{{item.expanded}}">
            <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="pb-po-line">
              <view class="pb-po-line__head">
                <view
                  class="pb-po-line__check {{line.selected ? 'pb-po-line__check--on' : ''}}"
                  data-doc-number="{{item.docNumber}}"
                  data-line-id="{{line.id}}"
                  bindtap="onPoLineToggle"
                >{{line.selected ? '✓' : ''}}</view>
                <view class="pb-po-line__info">
                  <view>
                    <text class="pb-po-line__name">{{line.productName}}</text>
                    <text wx:if="{{line.productSku}}" class="pb-po-line__sku">{{line.productSku}}</text>
                  </view>
                  <text wx:if="{{line.variantLabel}}" class="pb-po-line__remain">规格 {{line.variantLabel}}</text>
                  <text class="pb-po-line__remain">订购 {{line.orderedText}} · 已入 {{line.receivedText}} · 待入 {{line.remainingText}}</text>
                </view>
              </view>

              <view class="pb-po-line__inputs order-detail-summary order-detail-summary--form">
                <view wx:if="{{line.showBatch}}" class="order-detail-summary__item">
                  <text class="order-detail-summary__label">批次</text>
                  <batch-return-input
                    value="{{line.batch}}"
                    product-id="{{line.productId}}"
                    warehouse-id="{{form.warehouseId}}"
                    merge-batches="{{line.mergeBatches}}"
                    data-doc-number="{{item.docNumber}}"
                    data-line-id="{{line.id}}"
                    bind:change="onPoLineBatchChange"
                  />
                </view>
                <view class="order-detail-summary__item">
                  <text class="order-detail-summary__label">入库数</text>
                  <input
                    class="order-detail-summary__input order-detail-summary__input--box"
                    type="digit"
                    value="{{line.qty}}"
                    data-doc-number="{{item.docNumber}}"
                    data-line-id="{{line.id}}"
                    bindinput="onPoLineQtyInput"
                  />
                </view>
                <view wx:if="{{showAmount}}" class="order-detail-summary__item">
                  <text class="order-detail-summary__label">单价</text>
                  <input
                    class="order-detail-summary__input order-detail-summary__input--box"
                    type="digit"
                    value="{{line.purchasePrice}}"
                    data-doc-number="{{item.docNumber}}"
                    data-line-id="{{line.id}}"
                    bindinput="onPoLinePriceInput"
                  />
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!matrixKeyboardVisible}}" class="plan-create-footer po-edit-footer">
    <view class="po-edit-footer__summary">
      <block wx:if="{{creationMethod === 'MANUAL' || editing}}">
        <view class="po-edit-footer__stat">
          <text class="po-edit-footer__summary-label">合计数量</text>
          <text class="po-edit-footer__summary-value">{{totalQtyText}}</text>
        </view>
        <view wx:if="{{showAmount}}" class="po-edit-footer__stat">
          <text class="po-edit-footer__summary-label">合计金额</text>
          <text class="po-edit-footer__summary-value">{{totalAmountText || '—'}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="po-edit-footer__stat">
          <text class="po-edit-footer__summary-label">已选明细</text>
          <text class="po-edit-footer__summary-value">{{selectedFromOrderCount}} 条</text>
        </view>
      </block>
    </view>
    <view class="po-edit-footer__actions">
      <button
        wx:if="{{canDelete}}"
        class="po-edit-footer__btn po-edit-footer__btn--danger"
        hover-class="po-edit-footer__btn--hover"
        bindtap="onDeleteTap"
      >删除</button>
      <button
        class="po-edit-footer__btn po-edit-footer__btn--primary"
        hover-class="po-edit-footer__btn--hover"
        loading="{{submitting}}"
        disabled="{{submitting || (creationMethod === 'MANUAL' || editing ? !canSubmit : selectedFromOrderCount === 0)}}"
        bindtap="onSubmit"
      >{{submitting ? '保存中…' : (creationMethod === 'FROM_ORDER' && !editing ? '执行入库' : '保存')}}</button>
    </view>
  </view>

  <matrix-qty-keyboard
    visible="{{matrixKeyboardVisible}}"
    label="{{matrixKeyboardLabel}}"
    value="{{matrixKeyboardValue}}"
    bind:action="onMatrixKeyboardAction"
  />
</view>
