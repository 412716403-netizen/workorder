@import '/styles/psi-warehouse-transfer-edit-page.wxss';

.plan-create-matrix__cell-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.plan-create-matrix__sys {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.plan-create-matrix__cell .plan-create-matrix__input {
  min-height: 56rpx;
  height: 56rpx;
}
