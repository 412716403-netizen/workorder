@import '/styles/production-plans-page.wxss';
@import '/styles/report-history-page.wxss';

.so-pending-page {
  padding: 0 var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}

.so-pending-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.so-pending-row__check {
  padding-top: 8rpx;
  flex-shrink: 0;
}

.so-pending-row__checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  background: #fff;
}

.so-pending-row__checkbox--on {
  background: #2f6bff;
  border-color: #2f6bff;
}

.so-pending-row__body {
  flex: 1;
  min-width: 0;
}

.so-pending-row__main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.so-pending-row__thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.so-pending-row__thumb .report-history-row__img {
  width: 96rpx;
  height: 96rpx;
}

.so-pending-row__content {
  flex: 1;
  min-width: 0;
}

.so-pending-row__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.so-pending-row__head-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.so-pending-row__head-dot {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.so-pending-row__doc {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.so-pending-row__partner {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.so-pending-row__qty {
  font-size: 26rpx;
  font-weight: 600;
  color: #2f6bff;
  flex-shrink: 0;
}

.so-pending-row__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

.so-pending-row__wh {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  min-width: 0;
  flex: 1;
}

.so-pending-row__detail-btn {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 10rpx;
  line-height: 1.3;
}

.so-pending-row__product {
  margin-bottom: 4rpx;
}

.so-pending-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.so-pending-footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.so-pending-footer__hint {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.so-pending-footer__hint-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.so-pending-footer__hint-count {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.so-pending-footer__hint-count--active {
  color: #2f6bff;
}

.so-pending-footer__btn {
  flex: none;
  margin: 0;
  padding: 0 32rpx;
  min-width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #2f6bff;
  border-radius: var(--radius-button, 16rpx);
  border: none;
  box-sizing: border-box;
}

.so-pending-footer__btn::after {
  border: none;
}

.so-pending-footer__btn--hover {
  opacity: 0.88;
}

.so-pending-footer__btn[disabled] {
  opacity: 0.45;
}
