<view class="plan-create-shell">
  <view class="plan-create-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-create-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-create-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-create-header__title">{{title}}</text>
      <view class="plan-create-header__back plan-create-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-create-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-create-scroll"
    scroll-y
    enhanced
    scroll-top="{{matrixScrollTop}}"
    scroll-with-animation="{{false}}"
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view wx:if="{{loading}}" class="plan-create-muted">加载中…</view>

    <view wx:else class="plan-create-page {{matrixKeyboardVisible ? 'matrix-keyboard-page--open' : ''}}" bindtap="onMatrixOutsideTap">
      <view class="plan-form-card">
        <datetime-calendar-select
          label="创建时间"
          date="{{form.createdAt}}"
          time="{{form.createdAtTime}}"
          bind:change="onCreatedAtDateTimeChange"
          bind:sheetopen="onPickerSheetOpen"
          bind:sheetclose="onPickerSheetClose"
        />

        <searchable-partner-select
          cell="{{true}}"
          required="{{true}}"
          label="供应商"
          partners="{{partners}}"
          categories="{{partnerCategories}}"
          value="{{form.partner}}"
          placeholder="请选择"
          bind:change="onPartnerChange"
          bind:created="onPartnerCreated"
        />

        <view wx:if="{{form.docNumber}}" class="plan-form-cell">
          <text class="plan-form-cell__label">单号</text>
          <text class="plan-form-cell__value">{{form.docNumber}}</text>
        </view>
      </view>

      <view class="plan-form-card">
        <view
          wx:for="{{lines}}"
          wx:key="id"
          class="po-edit-line"
        >
          <view class="po-edit-line__head">
            <view class="po-edit-line__product-select">
              <searchable-product-select
                embedded="{{true}}"
                required="{{true}}"
                label=""
                products="{{products}}"
                categories="{{categories}}"
                partners="{{partners}}"
                value-id="{{item.productId}}"
                value-name="{{item.productName}}"
                placeholder="请选择产品"
                data-line-id="{{item.id}}"
                bind:change="onLineProductChange"
              />
            </view>
            <text
              wx:if="{{lines.length > 1 || item.productId}}"
              class="po-edit-line__remove"
              data-line-id="{{item.id}}"
              catchtap="onRemoveLine"
            >删除</text>
          </view>

          <view wx:if="{{item.productId}}" class="order-detail-summary order-detail-summary--form po-edit-qty-price-row">
            <view class="order-detail-summary__item">
              <text class="order-detail-summary__label"><text wx:if="{{!item.useMatrix}}" class="plan-form-cell__req">*</text>数量</text>
              <input
                wx:if="{{!item.useMatrix}}"
                class="order-detail-summary__input order-detail-summary__input--box"
                type="digit"
                value="{{item.quantity}}"
                data-line-id="{{item.id}}"
                bindinput="onLineQtyInput"
                placeholder="0"
                placeholder-class="order-detail-summary__ph"
              />
              <text wx:else class="order-detail-summary__value order-detail-summary__value--box">{{item.lineTotalQty > 0 ? item.lineTotalQty : '—'}}</text>
              <text wx:if="{{item.useMatrix}}" class="order-detail-summary__hint">色码录入</text>
            </view>
            <view wx:if="{{showAmount}}" class="order-detail-summary__item">
              <text class="order-detail-summary__label">单价</text>
              <input
                class="order-detail-summary__input order-detail-summary__input--box"
                type="digit"
                value="{{item.purchasePrice}}"
                data-line-id="{{item.id}}"
                bindinput="onLinePriceInput"
                placeholder="0"
                placeholder-class="order-detail-summary__ph"
              />
            </view>
            <view wx:if="{{showAmount}}" class="order-detail-summary__item">
              <text class="order-detail-summary__label">金额</text>
              <text class="order-detail-summary__value order-detail-summary__value--box order-detail-summary__value--muted">{{item.lineAmountText || '—'}}</text>
            </view>
          </view>

          <block wx:if="{{item.productId && item.useMatrix && item.matrixLayout}}">
            <view class="plan-create-matrix-wrap po-edit-matrix-wrap">
              <view class="po-edit-matrix-head">
                <text class="po-edit-matrix-head__title">色码数量</text>
                <text wx:if="{{item.lineTotalQty > 0}}" class="po-edit-matrix-head__hint">{{item.unitName}}</text>
              </view>
              <scroll-view class="plan-create-matrix-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                <view class="plan-create-matrix">
                  <view class="plan-create-matrix__head">
                    <view class="plan-create-matrix__corner">颜色</view>
                    <view wx:for="{{item.matrixLayout.sizeColumns}}" wx:key="id" class="plan-create-matrix__size">{{item.header}}</view>
                  </view>
                  <view wx:for="{{item.matrixLayout.colorRows}}" wx:for-item="row" wx:key="key" class="plan-create-matrix__row">
                    <view class="plan-create-matrix__color">
                      <view wx:if="{{row.colorSwatch}}" class="plan-create-matrix__swatch" style="background-color: {{row.colorSwatch}};" />
                      <text class="plan-create-matrix__color-text">{{row.colorLabel}}</text>
                    </view>
                    <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="plan-create-matrix__cell">
                      <view
                        wx:if="{{cell.variantId}}"
                        class="plan-create-matrix__input {{activeLineId === item.id && activeMatrixVariantId === cell.variantId ? 'plan-create-matrix__input--active' : ''}} {{activeLineId === item.id && activeMatrixVariantId === cell.variantId && matrixInputReplaceAll && cell.quantity ? 'plan-create-matrix__input--replace' : ''}} {{cell.quantity ? 'plan-create-matrix__input--filled' : 'plan-create-matrix__input--empty'}}"
                        data-line-id="{{item.id}}"
                        data-variant-id="{{cell.variantId}}"
                        catchtap="onMatrixCellTap"
                      >{{cell.quantity}}</view>
                      <text wx:else class="plan-create-matrix__dash">—</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </view>
          </block>

        </view>

        <view class="po-edit-add-line" bindtap="onAddLine">
          <text>+ 添加明细</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!matrixKeyboardVisible && !pickerSheetOpen}}" class="plan-create-footer po-edit-footer">
    <view class="po-edit-footer__summary">
      <view class="po-edit-footer__stat">
        <text class="po-edit-footer__summary-label">合计数量</text>
        <text class="po-edit-footer__summary-value">{{totalQtyText}}</text>
      </view>
      <view wx:if="{{showAmount}}" class="po-edit-footer__stat">
        <text class="po-edit-footer__summary-label">合计金额</text>
        <text class="po-edit-footer__summary-value">{{totalAmountText || '—'}}</text>
      </view>
      <view wx:if="{{showFinanceEntry || showFinanceAmount}}" class="po-edit-footer__finance">
        <view wx:if="{{showFinanceAmount}}" class="po-edit-footer__stat po-edit-footer__stat--finance">
          <text class="po-edit-footer__summary-label">{{financeShortLabel}}</text>
          <text class="po-edit-footer__summary-value po-edit-footer__summary-value--finance">{{financeAmountText}}</text>
        </view>
        <view
          wx:if="{{showFinanceEntry}}"
          class="po-edit-footer__finance-icon"
          hover-class="po-edit-footer__finance-icon--hover"
          bindtap="onFinanceEntryTap"
        >
          <image class="po-edit-footer__finance-icon-img" src="{{financeEntryIcon}}" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="po-edit-footer__actions">
      <button
        wx:if="{{canDelete}}"
        class="po-edit-footer__btn po-edit-footer__btn--danger"
        hover-class="po-edit-footer__btn--hover"
        bindtap="onDeleteTap"
      >删除</button>
      <button
        class="po-edit-footer__btn po-edit-footer__btn--primary"
        hover-class="po-edit-footer__btn--hover"
        loading="{{submitting}}"
        disabled="{{submitting || !canSubmit}}"
        bindtap="onSubmit"
      >{{submitting ? '保存中…' : '保存'}}</button>
    </view>
  </view>

  <matrix-qty-keyboard
    visible="{{matrixKeyboardVisible}}"
    label="{{matrixKeyboardLabel}}"
    value="{{matrixKeyboardValue}}"
    bind:action="onMatrixKeyboardAction"
  />
</view>
