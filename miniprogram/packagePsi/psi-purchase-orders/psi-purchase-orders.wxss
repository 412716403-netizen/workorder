@import '/styles/production-plans-page.wxss';
@import '/styles/report-history-page.wxss';
@import '../../styles/qty-price-amount-summary.wxss';

.po-flow-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  padding: 0 4rpx;
}

.po-orders-filter-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin: 0;
  z-index: 1;
  border-radius: 0 0 16rpx 16rpx;
}

.po-flow-btn__icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
  opacity: 0.92;
}

.po-flow-btn__label {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.2;
}

.po-orders-page {
  padding: 0 var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
}

.po-doc-card {
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.po-doc-card__head {
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.po-doc-card__title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.po-doc-card__doc {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.po-doc-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-bottom: 10rpx;
}

.po-doc-card__meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.po-doc-card__meta-item--operator {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.po-doc-card__meta-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.po-doc-card__totals {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
}

.po-doc-card__qty {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.po-doc-card__amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.po-doc-card__line-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.po-doc-card__lines {
  padding: 8rpx 0 0;
}

.po-doc-card__line {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.po-doc-card__line:last-child {
  border-bottom: none;
}

.po-doc-card__line .report-history-row__body {
  gap: 16rpx;
}

.po-doc-card__line .report-history-row__left {
  width: 96rpx;
}

.po-doc-card__line .report-history-row__img {
  width: 96rpx;
  height: 96rpx;
}

.po-doc-card__line .report-history-row__product {
  margin-bottom: 6rpx;
}

.po-doc-card__line .order-detail-summary--compact {
  margin-top: 4rpx;
}

.po-line-progress--compact {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 0;
}

.po-line-progress--compact .po-line-progress__bar {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 8rpx;
}

.po-line-progress__nums {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.po-line-progress__tag {
  font-size: 20rpx;
  color: #ef4444;
  flex-shrink: 0;
}

.po-line-progress {
  margin-bottom: 0;
}

.po-line-progress__bar {
  display: flex;
  height: 10rpx;
  border-radius: 5rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.po-line-progress__ordered {
  background: var(--color-primary);
  height: 100%;
}

.po-line-progress__over {
  background: #ef4444;
  height: 100%;
}

.po-line-progress--product {
  flex-shrink: 0;
}
