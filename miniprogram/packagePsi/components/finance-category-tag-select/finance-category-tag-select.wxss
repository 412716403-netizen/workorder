.fcts {
  width: 100%;
}

.fcts__overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.fcts__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 35, 41, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.fcts__mask--show {
  opacity: 1;
}

.fcts__sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.fcts__sheet--motion {
  transition: transform 0.3s ease;
}

.fcts__sheet--show {
  transform: translateY(0);
}

.fcts__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.fcts__bar-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--color-text-primary);
}

.fcts__bar-collapse {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
}

.fcts__bar-collapse-icon {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.fcts__body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 8rpx var(--spacing-page) 32rpx;
  box-sizing: border-box;
}

.fcts__empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.fcts__grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.fcts__item {
  width: 20%;
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.fcts__item--active {
  background: #fff4e8;
  border-color: #f0d4b0;
}

.fcts__item-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.fcts__item-label {
  width: 100%;
  text-align: center;
  font-size: var(--font-small);
  line-height: 1.35;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
