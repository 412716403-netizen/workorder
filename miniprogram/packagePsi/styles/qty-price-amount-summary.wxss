/**
 * 数量 / 单价 / 金额 三列一行（参考外协收回 order-detail-summary）
 * 表单录入、列表行、详情行统一使用。
 */

.order-detail-summary {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.order-detail-summary--compact {
  margin-bottom: 0;
  gap: 8rpx;
}

.order-detail-summary__item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.order-detail-summary--compact .order-detail-summary__item {
  padding: 12rpx 10rpx;
  box-shadow: none;
  background: #f9fafb;
  border-radius: 12rpx;
}

.order-detail-summary__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.order-detail-summary--compact .order-detail-summary__label {
  font-size: 20rpx;
  margin-bottom: 4rpx;
  letter-spacing: 0;
}

.order-detail-summary__value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.order-detail-summary__item--readonly .order-detail-summary__value {
  color: var(--color-text-secondary);
  font-weight: 600;
}

.order-detail-summary--compact .order-detail-summary__value {
  font-size: 24rpx;
  font-weight: 600;
}

.order-detail-summary__value--success {
  color: var(--color-success);
}

.order-detail-summary__input {
  width: 100%;
  margin-top: 0;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.order-detail-summary__ph {
  color: var(--color-text-tertiary);
  font-size: 30rpx;
  font-weight: 400;
}

.order-detail-summary--form {
  gap: 16rpx;
  margin-bottom: 0;
  padding: 16rpx 0 4rpx;
  border-top: 1rpx solid #f3f4f6;
}

.order-detail-summary--form .order-detail-summary__item {
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  border-radius: 0;
}

.order-detail-summary--form .order-detail-summary__label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  letter-spacing: 0;
}

.order-detail-summary--form .order-detail-summary__input--box {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.order-detail-summary--form .order-detail-summary__value--box {
  display: block;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f9fafb;
  border: 1rpx solid #f3f4f6;
  font-size: 30rpx;
  font-weight: 600;
}

.order-detail-summary--form .order-detail-summary__value--muted {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.order-detail-summary--form .order-detail-summary__hint {
  margin-top: 6rpx;
  font-size: 20rpx;
}

.order-detail-summary--compact .order-detail-summary__input {
  height: 48rpx;
  line-height: 48rpx;
  font-size: 24rpx;
}

.order-detail-summary__item--field {
  align-items: flex-start;
}

.order-detail-summary__hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}
