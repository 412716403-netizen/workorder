.report-history-row__product {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.report-history-row__product-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}

.report-history-row__product-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.report-history-row__sku {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
