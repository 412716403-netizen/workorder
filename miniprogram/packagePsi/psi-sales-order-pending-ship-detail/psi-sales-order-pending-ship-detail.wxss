@import '/styles/plan-create-form.wxss';
@import '../styles/rework-defect-detail-page.wxss';

.so-pending-detail-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.so-pending-detail-section-title {
  padding: 24rpx var(--spacing-card) 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.so-pending-detail-table {
  margin: 0 var(--spacing-page);
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.so-pending-detail-table__head,
.so-pending-detail-table__row,
.so-pending-detail-table__foot {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.so-pending-detail-table__foot {
  border-bottom: none;
  background: #eef2ff;
}

.so-pending-detail-table__spec {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.so-pending-detail-table__qty {
  flex-shrink: 0;
  width: 180rpx;
  text-align: right;
}

.so-pending-detail-table__head .so-pending-detail-table__spec,
.so-pending-detail-table__head .so-pending-detail-table__qty {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.so-pending-detail-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #2f6bff;
}

.so-pending-detail-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.so-pending-detail-input {
  width: 100%;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #2f6bff;
}

.so-pending-detail-hint {
  padding: 12rpx var(--spacing-page) 0;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
