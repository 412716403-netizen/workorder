<view class="tab-bar">
  <view class="tab-bar__inner">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="tab-bar__item {{selectedPath === item.path ? 'tab-bar__item--active' : ''}}"
      style="width: {{item.widthPercent}}%;"
    >
      <view
        class="tab-bar__tap"
        data-path="{{item.path}}"
        catchtap="onTabTap"
      >
        <view class="tab-bar__icon-wrap">
          <image
            class="tab-bar__icon"
            src="{{selectedPath === item.path ? item.selectedIconPath : item.iconPath}}"
            mode="aspectFit"
          />
          <view wx:if="{{item.key === 'messages' && messageBadge}}" class="tab-bar__badge">
            {{messageBadge}}
          </view>
        </view>
        <view class="tab-bar__text">{{item.text}}</view>
      </view>
    </view>
  </view>
</view>
