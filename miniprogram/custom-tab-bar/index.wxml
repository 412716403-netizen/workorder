<cover-view class="tab-bar">
  <cover-view class="tab-bar__inner">
    <cover-view
      wx:for="{{items}}"
      wx:key="key"
      class="tab-bar__item {{selectedPath === item.path ? 'tab-bar__item--active' : ''}}"
      style="width: {{item.widthPercent}}%;"
    >
      <cover-view
        class="tab-bar__tap"
        data-path="{{item.path}}"
        catchtap="onTabTap"
      >
        <cover-view class="tab-bar__icon-wrap">
          <cover-image
            class="tab-bar__icon"
            src="{{selectedPath === item.path ? item.selectedIconPath : item.iconPath}}"
          />
          <cover-view wx:if="{{item.key === 'messages' && messageBadge}}" class="tab-bar__badge">
            {{messageBadge}}
          </cover-view>
        </cover-view>
        <cover-view class="tab-bar__text">{{item.text}}</cover-view>
      </cover-view>
    </cover-view>
  </cover-view>
</cover-view>
