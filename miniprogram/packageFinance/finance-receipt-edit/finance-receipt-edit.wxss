@import '/styles/plan-create-form.wxss';
@import '/styles/psi-warehouse-transfer-edit-page.wxss';
@import '/styles/finance-record-form.wxss';

.fin-transfer-delete {
  margin-top: 32rpx;
}

.fin-transfer-delete__btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-danger);
  background: var(--color-danger-bg);
  border-radius: 16rpx;
}

.fin-transfer-delete__btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}
