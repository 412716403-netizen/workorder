<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">收款单</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="单号 / 客户 / 经办人 / 备注"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view
        wx:if="{{canViewFlow}}"
        class="po-flow-btn"
        bindtap="onFlowTap"
      >
        <image class="po-flow-btn__icon" src="/assets/icons/scroll-text.png" mode="aspectFit" />
        <text class="po-flow-btn__label">流水</text>
      </view>
      <view
        wx:if="{{canCreate}}"
        class="plan-tool-btn"
        bindtap="onCreateTap"
      >
        <image class="plan-tool-btn__icon" src="/assets/icons/file-plus.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <view class="fin-receipts-page">
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{cards.length}}">
      <view
        wx:for="{{cards}}"
        wx:key="id"
        class="fin-receipt-card"
        bindtap="onCardTap"
        data-id="{{item.id}}"
      >
        <view class="fin-receipt-card__title-row">
          <text class="fin-receipt-card__partner">{{item.partner}}</text>
          <text class="fin-receipt-card__amount {{item.amountTone === 'payment' ? 'fin-receipt-card__amount--payment' : ''}}">{{item.amountText}}</text>
        </view>
        <text class="fin-receipt-card__doc">{{item.docNo}}</text>
        <view class="fin-receipt-card__meta">
          <text class="fin-receipt-card__meta-item">{{item.categoryName}}</text>
          <text class="fin-receipt-card__meta-item">{{item.timestampText}}</text>
          <view wx:if="{{item.showOperator}}" class="fin-receipt-card__meta-item fin-receipt-card__meta-item--operator">
            <image class="fin-receipt-card__meta-icon" src="/assets/icons/user.png" mode="aspectFit" />
            <text>{{item.operator}}</text>
          </view>
          <text wx:if="{{item.showWorker}}" class="fin-receipt-card__meta-item">工人 {{item.workerName}}</text>
        </view>
        <view wx:if="{{item.showProduct}}" class="fin-receipt-card__product">
          <view class="report-history-row__thumb">
            <image
              wx:if="{{item.showProductImage}}"
              class="report-history-row__img"
              src="{{item.productImageUrl}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="onProductImageError"
            />
            <view wx:else class="report-history-row__img report-history-row__img--placeholder">
              <image class="report-history-row__placeholder-icon" src="{{item.placeholderIconSrc}}" mode="aspectFit" />
            </view>
          </view>
          <view>
            <text class="fin-receipt-card__product-name">{{item.productName}}</text>
            <text wx:if="{{item.showProductSku}}" class="fin-receipt-card__product-sku">{{item.productSku}}</text>
          </view>
        </view>
        <text wx:if="{{item.showNote}}" class="fin-receipt-card__note">{{item.note}}</text>
      </view>

      <view wx:if="{{loadingMore}}" class="plan-list-footer">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="plan-list-footer">已加载全部 {{total}} 单</view>
    </view>

    <empty-state wx:else text="{{emptyText}}" />
  </view>
</view>
