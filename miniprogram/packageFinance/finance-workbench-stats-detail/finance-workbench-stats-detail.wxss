@import '../../styles/tokens.wxss';

.finance-page { height: 100vh; display: flex; flex-direction: column; background: var(--color-bg-page); }
.finance-nav { position: fixed; z-index: 5; top: 0; left: 0; right: 0; background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end)); box-shadow: 0 4rpx 16rpx rgba(47, 107, 255, 0.14); }
.finance-nav__bar { display: flex; align-items: center; justify-content: space-between; padding: 0 20rpx; }
.finance-nav__back { width: 64rpx; height: 64rpx; line-height: 58rpx; text-align: center; font-size: 54rpx; color: rgba(255, 255, 255, 0.96); }.finance-nav__back--placeholder { visibility: hidden; }
.finance-nav__title-wrap { flex: 1; min-width: 0; text-align: center; }.finance-nav__title { display: block; font-size: 30rpx; font-weight: 700; color: rgba(255, 255, 255, 0.98); }.finance-nav__subtitle { display: block; margin-top: 1rpx; font-size: 19rpx; color: rgba(255, 255, 255, 0.72); }
.finance-content { flex: 1; min-height: 0; }
.finance-filter { padding: 20rpx var(--spacing-page) 16rpx; background: #fff; }.finance-filter__tabs { display: flex; padding: 6rpx; overflow: hidden; border-radius: 18rpx; background: #f1f4fa; }
.finance-filter__tab { flex: 1; padding: 12rpx 4rpx; border-radius: 13rpx; text-align: center; font-size: 24rpx; font-weight: 600; color: var(--color-text-secondary); }.finance-filter__tab--active { color: var(--color-primary); background: #fff; box-shadow: 0 3rpx 12rpx rgba(47, 107, 255, 0.12); }
.finance-filter__range { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 14rpx; color: var(--color-text-secondary); font-size: 24rpx; }.finance-filter__date { padding: 10rpx 16rpx; border: 1rpx solid var(--color-border); border-radius: 12rpx; color: var(--color-text-primary); background: #fafbfc; }.finance-filter__range-sep { color: var(--color-text-tertiary); }.finance-filter__warning { display: block; margin-top: 10rpx; text-align: center; color: var(--color-danger); font-size: 22rpx; }
.finance-body { padding: 20rpx var(--spacing-page) calc(40rpx + env(safe-area-inset-bottom)); }
.cash-hero { position: relative; overflow: hidden; padding: 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #4d7fff, #2f6bff); box-shadow: 0 14rpx 32rpx rgba(47, 107, 255, 0.22); }.cash-hero::after { content: ''; position: absolute; right: -56rpx; top: -86rpx; width: 250rpx; height: 250rpx; border: 32rpx solid rgba(255,255,255,.11); border-radius: 50%; }.cash-hero--ok { background: linear-gradient(135deg, #12a16d, #34c759); box-shadow: 0 14rpx 32rpx rgba(52, 199, 89, .20); }.cash-hero--warn { background: linear-gradient(135deg, #f25c72, #ff7b53); box-shadow: 0 14rpx 32rpx rgba(242, 92, 114, .18); }
.cash-hero__top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }.cash-hero__eyebrow { font-size: 25rpx; font-weight: 600; opacity: .86; }.cash-hero__mark { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 50%; font-size: 26rpx; font-weight: 700; background: rgba(255,255,255,.16); }.cash-hero__value { position: relative; z-index: 1; display: block; margin-top: 16rpx; font-size: 62rpx; line-height: 1; font-weight: 800; letter-spacing: -2rpx; }.cash-hero__foot { position: relative; z-index: 1; display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; font-size: 23rpx; opacity: .88; }.cash-hero__pulse { width: 10rpx; height: 10rpx; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6rpx rgba(255,255,255,.16); }
.finance-section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 4rpx 14rpx; }.finance-section-head--spaced { margin-top: 38rpx; }.finance-section-head__title { font-size: 30rpx; font-weight: 700; color: var(--color-text-primary); }.finance-section-head__hint { font-size: 21rpx; color: var(--color-text-secondary); }
.finance-summary-grid { display: flex; gap: 16rpx; }.finance-summary { display: flex; flex: 1; min-width: 0; gap: 12rpx; padding: 20rpx 16rpx; border-radius: 20rpx; background: #fff; box-shadow: var(--shadow-card); }.finance-summary__icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 15rpx; font-size: 24rpx; font-weight: 700; }.finance-summary--receipt .finance-summary__icon { color: #0d9564; background: #e8f8f0; }.finance-summary--payment .finance-summary__icon { color: #dc4e63; background: #fff0f2; }.finance-summary__content { min-width: 0; }.finance-summary__label, .finance-summary__sub { display: block; font-size: 20rpx; color: var(--color-text-secondary); }.finance-summary__value { display: block; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 31rpx; line-height: 1; font-weight: 800; color: var(--color-text-primary); }.finance-summary__sub { margin-top: 8rpx; }
.finance-detail-card, .partner-card, .other-card { margin-top: 16rpx; padding: 22rpx 20rpx; border-radius: 20rpx; background: #fff; box-shadow: var(--shadow-card); }.finance-detail-card__head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 8rpx; }.finance-detail-card__title { font-size: 27rpx; font-weight: 700; color: var(--color-text-primary); }.finance-detail-card__badge { padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 600; }.finance-detail-card__badge--receipt { color: #0d9564; background: #e8f8f0; }.finance-detail-card__badge--payment { color: #dc4e63; background: #fff0f2; }
.finance-data-row { display: flex; align-items: center; gap: 12rpx; min-height: 76rpx; border-top: 1rpx solid #f2f4f7; }.finance-data-row__dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; }.finance-data-row__dot--receipt { background: #34c759; }.finance-data-row__dot--payment { background: #ff6b8a; }.finance-data-row__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; color: var(--color-text-primary); }.finance-data-row__right { flex-shrink: 0; text-align: right; }.finance-data-row__amount { display: block; font-size: 25rpx; font-weight: 700; color: var(--color-text-primary); }.finance-data-row__meta { display: block; margin-top: 3rpx; font-size: 19rpx; color: var(--color-text-tertiary); }.finance-detail-card__empty { display: block; padding: 24rpx 0 10rpx; text-align: center; font-size: 23rpx; color: var(--color-text-tertiary); }
.partner-card { border-left: 6rpx solid #62b6e9; }.partner-card--payable { border-left-color: #f4ad48; }.partner-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-bottom: 12rpx; }.partner-card__title { display: block; font-size: 27rpx; font-weight: 700; color: var(--color-text-primary); }.partner-card__sub { display: block; margin-top: 5rpx; font-size: 20rpx; color: var(--color-text-secondary); }.partner-card__amount { flex-shrink: 0; font-size: 31rpx; font-weight: 800; color: #1686c4; }.partner-card--payable .partner-card__amount { color: #d88716; }.partner-row { display: flex; align-items: center; min-height: 68rpx; border-top: 1rpx solid #f2f4f7; }.partner-row__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; color: var(--color-text-primary); }.partner-row__amount { margin-left: 12rpx; font-size: 23rpx; font-weight: 700; color: var(--color-text-primary); }.partner-row__pct { width: 76rpx; margin-left: 10rpx; text-align: right; font-size: 19rpx; color: var(--color-text-tertiary); }
.other-card { margin-top: 26rpx; margin-bottom: 4rpx; background: #fafbff; border: 1rpx solid #edf0fb; }.other-card__title { display: inline-block; font-size: 26rpx; font-weight: 700; color: var(--color-text-primary); }.other-card__hint { margin-left: 12rpx; font-size: 20rpx; color: var(--color-text-secondary); }.other-card__row { display: flex; justify-content: space-between; gap: 18rpx; padding-top: 16rpx; margin-top: 14rpx; border-top: 1rpx solid #edf0f5; font-size: 23rpx; color: var(--color-text-secondary); }
