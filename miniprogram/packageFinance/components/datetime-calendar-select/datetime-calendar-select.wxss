@import '/styles/tokens.wxss';
@import '../../styles/plan-form-cell.wxss';

.dcs {
  width: 100%;
}

.dcs__overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 高于 plan-create-footer(z-index:100)，避免「保存单据」穿透遮挡时刻行 */
  z-index: 10000;
}

.dcs__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 35, 41, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.dcs__mask--show {
  opacity: 1;
}

.dcs__sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  overflow: hidden;
}

.dcs__sheet--motion {
  transition: transform 0.3s ease;
}

.dcs__sheet--show {
  transform: translateY(0);
}

.dcs__bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx var(--spacing-page) 4rpx;
  flex-shrink: 0;
}

.dcs__bar-spacer {
  flex: 1;
}

.dcs__bar-done {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
  padding: 8rpx 4rpx;
}

.dcs__month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 32rpx 8rpx;
  flex-shrink: 0;
}

.dcs__nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.dcs__month-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dcs__month-title-text,
.dcs__ym-head-text {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--color-text-primary);
}

.dcs__month-title-caret {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.dcs__weekdays {
  display: flex;
  padding: 0 16rpx;
  flex-shrink: 0;
}

.dcs__weekday {
  width: 14.2857%;
  text-align: center;
  font-size: var(--font-small);
  color: var(--color-text-tertiary);
  padding: 4rpx 0 8rpx;
}

.dcs__month-swiper {
  width: 100%;
  height: 420rpx;
  flex-shrink: 0;
}

.dcs__grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
  flex-shrink: 0;
  align-content: flex-start;
  height: 100%;
  box-sizing: border-box;
}

.dcs__cell {
  width: 14.2857%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.dcs__cell-label {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  color: var(--color-text-primary);
  line-height: 1;
}

.dcs__cell-label--today {
  color: var(--color-primary, #2f6bff);
  font-weight: 600;
}

.dcs__cell-label--selected {
  background: var(--color-primary, #2f6bff);
  color: #fff;
  font-weight: 600;
}

.dcs__time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx var(--spacing-page) 20rpx;
  padding: 24rpx 28rpx;
  background: var(--color-bg-input, #f2f3f5);
  border-radius: 16rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.dcs__time-label {
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.dcs__time-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-body);
  color: var(--color-text-primary);
  font-weight: 500;
  margin-right: 8rpx;
}

.dcs__time-chevron {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.dcs__ym-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0 8rpx;
  flex-shrink: 0;
}

.dcs__ym-head .dcs__ym-head-text {
  color: var(--color-primary, #2f6bff);
}

.dcs__wheels {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
  margin: 0 24rpx;
  box-sizing: border-box;
}

.dcs__wheels--time {
  flex: 1;
  margin-bottom: 16rpx;
}

.dcs__wheel-indicator {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  pointer-events: none;
  border-radius: 12rpx;
  background: rgba(47, 107, 255, 0.08);
  border-top: 1rpx solid var(--color-border, #eef0f3);
  border-bottom: 1rpx solid var(--color-border, #eef0f3);
  box-sizing: border-box;
}

.dcs__wheel {
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 2;
}

.dcs__wheel-item {
  text-align: center;
  font-size: var(--font-section);
  color: var(--color-text-tertiary);
}

.dcs__wheel-item--active {
  color: var(--color-text-primary);
  font-weight: 600;
}

.dcs__confirm-wrap {
  padding: 16rpx var(--spacing-page) 28rpx;
  flex-shrink: 0;
}

.dcs__confirm-btn {
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--color-primary, #2f6bff);
  color: #fff;
  font-size: var(--font-section);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dcs__info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx var(--spacing-page);
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.dcs__info-row--last {
  border-bottom: none;
}

.dcs__info-label {
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.dcs__info-value-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.dcs__info-value {
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.dcs__info-chevron {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}
