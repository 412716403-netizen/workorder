.fas {
  width: 100%;
}

.fas__overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.fas__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 35, 41, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.fas__mask--show {
  opacity: 1;
}

.fas__sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(31, 35, 41, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.fas__sheet--motion {
  transition: transform 0.3s ease;
}

.fas__sheet--show {
  transform: translateY(0);
}

.fas__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--spacing-page) 12rpx;
  flex-shrink: 0;
}

.fas__bar-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--color-text-primary);
}

.fas__bar-collapse {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
}

.fas__bar-collapse-icon {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.fas__body {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
}

.fas__empty {
  padding: 80rpx var(--spacing-page);
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.fas__list {
  padding: 8rpx 0 24rpx;
}

.fas__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx var(--spacing-page);
  box-sizing: border-box;
}

.fas__row-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.fas__row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fas__row-name {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fas__row-balance {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.fas__row-balance--neg {
  color: var(--color-danger, #ff4d4f);
}

.fas__row-check {
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
  font-size: 36rpx;
  line-height: 1;
  color: #e8a05c;
  font-weight: 700;
}
