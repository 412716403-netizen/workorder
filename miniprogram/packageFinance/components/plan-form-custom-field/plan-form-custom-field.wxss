@import '/styles/tokens.wxss';
@import '../../styles/plan-form-cell.wxss';

.pfcf__picker-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 文件字段：标签左、操作+正方形预览右 */
.pfcf .plan-form-cell--file {
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.pfcf .plan-form-cell--file .plan-form-cell__label {
  padding-top: 8rpx;
}

.pfcf__file-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.pfcf__file-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.pfcf__file-btn {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
}

.pfcf__file-btn--muted {
  color: var(--color-text-secondary, #8f959e);
  font-weight: 500;
}

.pfcf__file-hint {
  flex: none;
  width: auto;
  max-width: 100%;
  font-size: var(--font-small);
}

.pfcf__file-square {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-bg-input, #f2f3f5);
  border: 1rpx solid var(--color-border, #eef0f3);
  flex-shrink: 0;
  box-sizing: border-box;
}

.pfcf__file-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.pfcf__file-doc {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.pfcf__file-doc-label {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--color-text-secondary, #8f959e);
  text-align: center;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
