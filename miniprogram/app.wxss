@import './styles/tokens.wxss';
@import './styles/base.wxss';
@import './styles/button.wxss';
@import './styles/list.wxss';
@import './styles/form.wxss';

/* 迁移期别名：旧 apple-* 映射到 st-* 样式 */

.apple-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.apple-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-page);
  padding-bottom: calc(var(--spacing-page) + env(safe-area-inset-bottom));
}

.apple-page--center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.apple-large-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.apple-footnote {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.apple-section-label {
  margin: 40rpx 8rpx 12rpx 16rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.apple-muted {
  text-align: center;
  padding: 120rpx 48rpx;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.apple-error {
  text-align: center;
  padding: 48rpx;
  font-size: 30rpx;
  color: var(--color-danger);
}

.apple-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.apple-group--padded {
  padding: var(--spacing-card);
}

.apple-cell {
  display: flex;
  align-items: center;
  padding: 28rpx var(--spacing-card);
  min-height: 96rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border);
}

.apple-cell:last-child {
  border-bottom: none;
}

.apple-cell--disabled {
  opacity: 0.38;
}

.apple-cell__body {
  flex: 1;
  min-width: 0;
}

.apple-cell__title {
  font-size: var(--font-body);
  font-weight: 400;
  color: var(--color-text-primary);
}

.apple-cell__subtitle {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.apple-chevron {
  margin-left: 16rpx;
  font-size: 40rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.apple-btn-fill {
  width: 100%;
  margin: 0;
  padding: 26rpx 32rpx;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 600;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border: none;
  box-sizing: border-box;
}

.apple-btn-fill::after {
  border: none;
}

.apple-btn-fill[disabled] {
  opacity: 0.45;
}

.apple-btn-muted {
  width: 100%;
  margin: 0;
  padding: 26rpx 32rpx;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 500;
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.apple-btn-muted::after {
  border: none;
}

.apple-btn-danger {
  width: 100%;
  margin: 0;
  padding: 26rpx 32rpx;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 500;
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border: none;
  box-sizing: border-box;
}

.apple-btn-danger::after {
  border: none;
}

.apple-btn-compact {
  margin: 0;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-icon);
  font-size: 28rpx;
  font-weight: 600;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: none;
  flex-shrink: 0;
}

.apple-btn-compact::after {
  border: none;
}

.apple-btn-compact[disabled] {
  opacity: 0.45;
}

.apple-field-label {
  display: block;
  margin: 0 0 10rpx 4rpx;
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--color-text-secondary);
}

.apple-input {
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 28rpx;
  font-size: var(--font-body);
  color: var(--color-text-primary);
  background: var(--color-bg-input);
  border-radius: var(--radius-icon);
  border: none;
}

.apple-input-wrap {
  margin-bottom: 24rpx;
}

.apple-ph,
.apple-ph-onboard {
  color: var(--color-text-tertiary);
}

.apple-pill {
  flex-shrink: 0;
  font-size: var(--font-small);
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
}

.apple-pill--pending {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.apple-pill--approved {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.apple-pill--rejected {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

.apple-tenant-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  border-radius: var(--radius-icon);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.apple-spinner {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.apple-inset {
  margin-top: 28rpx;
  padding: 28rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-icon);
}

.apple-inset-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
}

.apple-inset-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
}

.apple-inset-meta {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}
