@import '/packageBusiness/styles/plan-create-form.wxss';

.basic-dictionary-edit-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.report-batch-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.report-batch-footer__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.report-batch-footer__btn--ghost {
  color: #ef4444;
  background: #fef2f2;
}

.report-batch-footer__btn--primary {
  color: #fff;
  background: var(--color-primary);
}

.report-batch-footer__btn--disabled {
  opacity: 0.5;
}
