<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">往来数量明细</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>
    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="单号 / 日期 / 类型"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view class="plan-tool-btn {{filterActive ? 'plan-tool-btn--active' : ''}}" bindtap="onFilterTap">
        <image class="plan-tool-btn__icon" src="/assets/icons/list-filter.png" mode="aspectFit" />
      </view>
    </view>
  
    <view wx:if="{{showFilterPanel}}" class="plan-filter-panel plan-filter-panel--header-dropdown">
      <view class="plan-filter-panel__row">
        <text class="plan-filter-panel__label">日期起</text>
        <picker mode="date" value="{{draftDateFrom}}" bindchange="onDraftDateFromChange">
          <view class="plan-filter-chip plan-filter-chip--active">{{draftDateFrom || '不限'}}</view>
        </picker>
      </view>
      <view class="plan-filter-panel__row">
        <text class="plan-filter-panel__label">日期止</text>
        <picker mode="date" value="{{draftDateTo}}" bindchange="onDraftDateToChange">
          <view class="plan-filter-chip plan-filter-chip--active">{{draftDateTo || '不限'}}</view>
        </picker>
      </view>
      <view class="plan-filter-panel__row">
        <text class="plan-filter-panel__label">单据类型</text>
        <picker
          mode="selector"
          range="{{docTypeFilterLabels}}"
          value="{{draftDocTypeIndex}}"
          bindchange="onDraftDocTypeChange"
        >
          <view class="plan-filter-chip plan-filter-chip--active">{{docTypeFilterLabels[draftDocTypeIndex] || '全部类型'}}</view>
        </picker>
      </view>
      <view class="plan-filter-panel__foot">
        <view class="plan-filter-reset" bindtap="onFilterReset">重置</view>
        <view class="plan-filter-apply" bindtap="onFilterApply">确定</view>
      </view>
    </view></view>
    
  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <view class="partner-detail-page">
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <block wx:elif="{{header}}">
      <view class="outsource-detail-hero {{showTodoBtn ? 'outsource-detail-hero--todo' : ''}}">
        <view
          wx:if="{{showTodoBtn}}"
          class="todo-entry-btn todo-entry-btn--corner"
          bindtap="onAddTodoTap"
        >待办</view>
        <text class="outsource-detail-hero__title">{{header.titleLine}}</text>
        <text class="outsource-detail-hero__sub">{{header.subtitleLine}}</text>
        <view class="outsource-detail-stats">
          <view class="outsource-detail-stat">
            <text class="outsource-detail-stat__val outsource-detail-stat__val--dispatch">{{header.dispatchTotal}}</text>
            <text class="outsource-detail-stat__label">已发出</text>
          </view>
          <view class="outsource-detail-stat">
            <text class="outsource-detail-stat__val outsource-detail-stat__val--receive">{{header.receiveTotal}}</text>
            <text class="outsource-detail-stat__label">已收回</text>
          </view>
          <view class="outsource-detail-stat">
            <text class="outsource-detail-stat__val {{header.remainingNegative ? 'outsource-detail-stat__val--warn' : ''}}">{{header.remainingTotal}}</text>
            <text class="outsource-detail-stat__label">剩余</text>
          </view>
        </view>
        <view class="partner-detail-count">共 {{docCount}} 单</view>
      </view>

      <view wx:if="{{hasAnyRows}}" class="partner-flow-table-wrap">
        <scroll-view scroll-x show-scrollbar="{{false}}" class="partner-flow-table-scroll">
          <view class="partner-flow-table {{showVariantCols ? 'partner-flow-table--variant' : ''}} {{showDeliveryDateColumn ? 'partner-flow-table--delivery' : ''}}">
            <view class="partner-flow-table__thead">
              <view class="partner-flow-table__th partner-flow-table__th--date">日期</view>
              <view class="partner-flow-table__th partner-flow-table__th--type">单据类型</view>
              <view wx:if="{{showDeliveryDateColumn}}" class="partner-flow-table__th partner-flow-table__th--delivery">交货日期</view>
              <view class="partner-flow-table__th partner-flow-table__th--qty">商品数量</view>
              <view
                wx:for="{{variantColumns}}"
                wx:key="id"
                class="partner-flow-table__th partner-flow-table__th--variant"
                style="flex: 0 0 {{item.minWidth}}rpx; width: {{item.minWidth}}rpx; max-width: {{item.minWidth}}rpx;"
              >{{item.label}}</view>
            </view>

            <block wx:if="{{rows.length}}">
              <view
                wx:for="{{rows}}"
                wx:key="rowKey"
                class="partner-flow-table__tr"
                bindtap="onRowTap"
                data-doc-no="{{item.docNo}}"
              >
                <view class="partner-flow-table__td partner-flow-table__td--date">{{item.dateDisplay}}</view>
                <view class="partner-flow-table__td partner-flow-table__td--type">
                  <view class="partner-flow-type-badges">
                    <text wx:if="{{item.hasDispatch}}" class="partner-flow-type-badge partner-flow-type-badge--dispatch">发出</text>
                    <text wx:if="{{item.hasReceive}}" class="partner-flow-type-badge partner-flow-type-badge--receive">收回</text>
                  </view>
                </view>
                <view wx:if="{{showDeliveryDateColumn}}" class="partner-flow-table__td partner-flow-table__td--delivery">{{item.deliveryDateDisplay}}</view>
                <view class="partner-flow-table__td partner-flow-table__td--qty">{{item.totalQty}}</view>
                <view
                  wx:for="{{item.variantCells}}"
                  wx:for-item="cell"
                  wx:key="id"
                  class="partner-flow-table__td partner-flow-table__td--variant {{cell.isEmpty ? 'partner-flow-table__td--empty' : ''}}"
                  style="flex: 0 0 {{cell.minWidth}}rpx; width: {{cell.minWidth}}rpx; max-width: {{cell.minWidth}}rpx;"
                >{{cell.qtyText}}</view>
              </view>

              <view
                wx:for="{{summaryRows}}"
                wx:key="label"
                class="partner-flow-table__tr partner-flow-table__tr--summary"
              >
                <view class="partner-flow-table__td partner-flow-table__td--date partner-flow-table__td--summary-label {{item.accentClass}}">{{item.label}}</view>
                <view class="partner-flow-table__td partner-flow-table__td--type partner-flow-table__td--summary-gap"></view>
                <view wx:if="{{showDeliveryDateColumn}}" class="partner-flow-table__td partner-flow-table__td--delivery partner-flow-table__td--summary-gap"></view>
                <view class="partner-flow-table__td partner-flow-table__td--qty partner-flow-table__td--summary-qty {{item.isNegative ? 'partner-flow-table__td--warn' : ''}}">{{item.total}}</view>
                <view
                  wx:for="{{item.variantCells}}"
                  wx:for-item="cell"
                  wx:key="id"
                  class="partner-flow-table__td partner-flow-table__td--variant {{cell.isEmpty ? 'partner-flow-table__td--empty' : ''}} {{cell.isNegative ? 'partner-flow-table__td--warn' : ''}}"
                  style="flex: 0 0 {{cell.minWidth}}rpx; width: {{cell.minWidth}}rpx; max-width: {{cell.minWidth}}rpx;"
                >{{cell.qtyText}}</view>
              </view>
            </block>

            <view wx:else class="partner-flow-table__empty">无匹配单据，请调整筛选条件</view>
          </view>
        </scroll-view>
      </view>

      <view wx:else class="plan-list-empty">暂无往来数量明细</view>
    </block>
  </view>
</view>
