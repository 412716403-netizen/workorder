@import '../psi-purchase-bill-flow/psi-purchase-bill-flow.wxss';

.wh-flow-filter-panel {
  margin: 0 var(--spacing-page) 16rpx;
}

.wh-flow-row {
  margin: 0 var(--spacing-page) 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.wh-flow-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.wh-flow-row__type {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.wh-flow-row__doc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wh-flow-row__meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

.wh-flow-row__main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.wh-flow-row__product {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: baseline;
}

.wh-flow-row__qty {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.wh-flow-row__qty--in {
  color: #059669;
}

.wh-flow-row__qty--out {
  color: #dc2626;
}

.wh-flow-footer {
  padding: 24rpx var(--spacing-page) 48rpx;
}

.wh-flow-footer__text {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
