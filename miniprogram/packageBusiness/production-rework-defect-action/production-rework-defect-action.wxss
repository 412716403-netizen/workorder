@import '/packageBusiness/styles/matrix-keyboard-page.wxss';
@import '/packageBusiness/styles/plan-create-form.wxss';
@import '/packageBusiness/styles/production-plans-page.wxss';
@import '/packageBusiness/styles/outsource-shared.wxss';

.defect-action-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.defect-action-scroll {
  flex: 1;
  width: 100%;
}

.defect-action-loading {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.defect-action-form {
  padding: 16rpx var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}

/* 盖过 shorthand padding，保证键盘弹出时有足够滚白 */
.defect-action-form.matrix-keyboard-page--open {
  padding-bottom: calc(580rpx + env(safe-area-inset-bottom)) !important;
}

.defect-action-mode-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.defect-action-mode {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
}

.defect-action-mode--active {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: rgba(47, 107, 255, 0.06);
}

.defect-action-mode--scrap.defect-action-mode--active {
  color: #e11d48;
  border-color: #fda4af;
  background: rgba(225, 29, 72, 0.06);
}

.defect-action-info {
  padding: 24rpx 28rpx;
}

.defect-action-info__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.defect-action-info__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.defect-action-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding: 24rpx 28rpx 12rpx;
}

.defect-action-section-head__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.defect-action-section-head__hint,
.defect-action-section-head__total {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.defect-action-section-head__total {
  color: var(--color-primary);
  font-weight: 600;
}

.defect-action-nodes-card {
  padding-bottom: 8rpx;
}

.defect-action-node-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 20rpx 16rpx;
}

.defect-action-node-chip {
  min-width: 152rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--color-border);
  background: #fff;
  text-align: center;
}

.defect-action-node-chip--on {
  border-color: var(--color-primary);
  background: rgba(47, 107, 255, 0.06);
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 255, 0.08);
}

.defect-action-node-chip__step {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
}

.defect-action-node-chip__name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.defect-action-node-other {
  padding: 0 20rpx 8rpx;
}

.defect-action-node-other__label {
  display: block;
  padding: 8rpx 8rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.defect-action-node-list {
  padding: 0;
}

.defect-action-node {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.defect-action-node:last-child {
  border-bottom: none;
}

.defect-action-node__check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

.defect-action-node__check--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.defect-action-node__body {
  flex: 1;
  min-width: 0;
}

.defect-action-node__step {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.defect-action-node__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.defect-action-node-empty {
  padding: 8rpx 28rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.defect-action-qty-card .plan-create-matrix-scroll {
  margin: 0 12rpx 16rpx;
}

.defect-action-single-qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 28rpx 24rpx;
}

.defect-action-single-qty__label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.defect-action-single-qty__input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-border);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  background: #fff;
}

.defect-action-single-qty__hint {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
