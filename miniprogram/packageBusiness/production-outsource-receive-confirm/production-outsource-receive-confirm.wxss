@import '../production-order-detail/production-order-detail.wxss';
@import '../production-order-report-batch-detail/production-order-report-batch-detail.wxss';
@import '../production-order-report/production-order-report.wxss';
@import '../production-plan-create/production-plan-create.wxss';
@import '../../styles/matrix-keyboard-page.wxss';

.outsource-receive-confirm-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.outsource-receive-confirm-line {
  margin-bottom: 32rpx;
}

.outsource-receive-confirm-line:last-child {
  margin-bottom: 0;
}

.outsource-receive-confirm-price {
  align-items: flex-start;
}

.outsource-receive-confirm-price__input {
  width: 100%;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.plan-detail-section__hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 400;
}
