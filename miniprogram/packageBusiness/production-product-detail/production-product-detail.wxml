<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">产品生产详情</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view wx:if="{{loading}}" class="plan-detail-muted">加载中…</view>

    <view wx:else class="plan-detail-page">
      <view wx:if="{{productHero}}" class="plan-detail-hero order-detail-hero">
        <view class="plan-detail-hero__left">
          <image
            wx:if="{{productHero.showProductImage}}"
            class="plan-detail-hero__img"
            src="{{productHero.productImageUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="plan-detail-hero__img plan-detail-hero__img--placeholder">
            <image class="plan-detail-hero__placeholder-icon" src="{{productHero.placeholderIconSrc}}" mode="aspectFit" />
          </view>
        </view>
        <view class="plan-detail-hero__text">
          <view class="plan-detail-hero__product-line">
            <text class="plan-detail-hero__product">{{productHero.productName}}</text>
            <text wx:if="{{productHero.showProductSku}}" class="plan-detail-hero__sku">{{productHero.productSku}}</text>
          </view>
          <view wx:if="{{productHero.showProductCustomTags}}" class="plan-detail-hero__custom-tags">
            <text
              wx:for="{{productHero.productCustomTags}}"
              wx:for-item="tag"
              wx:key="id"
              class="plan-detail-hero__tag"
            >{{tag.label}}: {{tag.display}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{summaryStats}}" class="order-detail-summary">
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">工单数</text>
          <text class="order-detail-summary__value">{{summaryStats.orderCountText}}</text>
        </view>
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">总计划量</text>
          <text class="order-detail-summary__value">{{summaryStats.totalText}}</text>
        </view>
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">入库数量</text>
          <text class="order-detail-summary__value order-detail-summary__value--success">{{summaryStats.stockInText}}</text>
        </view>
      </view>

      <view wx:if="{{showReportSummary}}" class="plan-detail-section">
        <view class="plan-detail-section__head order-detail-section__head">
          <text class="plan-detail-section__title">各工序报工汇总</text>
          <text wx:if="{{canViewReportHistory}}" class="order-detail-link" bindtap="onReportHistoryTap">报工明细流水 ›</text>
        </view>
        <view class="plan-form-card order-detail-report-table">
          <view class="order-detail-report-table__head">
            <text class="order-detail-report-table__th order-detail-report-table__th--name">工序</text>
            <text class="order-detail-report-table__th order-detail-report-table__th--num">良品</text>
            <text class="order-detail-report-table__th order-detail-report-table__th--num">不良品</text>
            <text class="order-detail-report-table__th order-detail-report-table__th--num">报损</text>
          </view>
          <view wx:for="{{reportSummaryRows}}" wx:key="nodeId" class="order-detail-report-table__row">
            <text class="order-detail-report-table__td order-detail-report-table__td--name">{{item.name}}</text>
            <text class="order-detail-report-table__td order-detail-report-table__td--num order-detail-report-table__td--good">{{item.goodText}}</text>
            <text class="order-detail-report-table__td order-detail-report-table__td--num order-detail-report-table__td--def">{{item.defText}}</text>
            <text class="order-detail-report-table__td order-detail-report-table__td--num order-detail-report-table__td--scrap">{{item.scrapText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{showMaterialSection}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">生产物料</text>
        </view>
        <text class="order-detail-section__hint">产品维度聚合（含本产品下多张工单的领退料与理论耗材）</text>
        <view class="plan-form-card order-detail-material-card">
          <scroll-view wx:if="{{materialRows.length}}" class="order-detail-material-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="order-detail-material-table">
              <view class="order-detail-material-table__head">
                <text class="order-detail-material-table__th order-detail-material-table__th--name">物料</text>
                <text class="order-detail-material-table__th order-detail-material-table__th--num">领料(+)</text>
                <text class="order-detail-material-table__th order-detail-material-table__th--num">退料(-)</text>
                <text class="order-detail-material-table__th order-detail-material-table__th--num">净领用</text>
                <text class="order-detail-material-table__th order-detail-material-table__th--num">报工耗材</text>
                <text class="order-detail-material-table__th order-detail-material-table__th--num">结余</text>
              </view>
              <view wx:for="{{materialRows}}" wx:key="productId" class="order-detail-material-table__row">
                <view class="order-detail-material-table__td order-detail-material-table__td--name">
                  <text class="order-detail-material-table__name">{{item.name}}</text>
                  <text wx:if="{{item.showSku}}" class="order-detail-material-table__sku">{{item.sku}}</text>
                </view>
                <text class="order-detail-material-table__td order-detail-material-table__td--num">{{item.issueText}}</text>
                <text class="order-detail-material-table__td order-detail-material-table__td--num">{{item.returnText}}</text>
                <text class="order-detail-material-table__td order-detail-material-table__td--num">{{item.netText}}</text>
                <text class="order-detail-material-table__td order-detail-material-table__td--num">{{item.reportCostText}}</text>
                <text class="order-detail-material-table__td order-detail-material-table__td--num {{item.surplusNeg ? 'order-detail-material-table__td--surplus-neg' : ''}}">{{item.surplusText}}</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="order-detail-empty">{{materialEmptyText}}</view>
        </view>
      </view>

      <view wx:if="{{showOutsourceSection}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">外协管理</text>
        </view>
        <scroll-view scroll-x class="order-process-scroll order-process-scroll--compact order-detail-outsource-scroll" enable-flex show-scrollbar="{{false}}">
          <view class="order-process-scroll__inner">
            <view
              wx:for="{{outsourceCards}}"
              wx:for-item="chip"
              wx:key="chipKey"
              class="order-process-chip order-process-chip--outsource {{chip.isCompleted ? 'order-process-chip--done' : ''}}"
              bindtap="onOutsourceChipTap"
              data-node-id="{{chip.nodeId}}"
              data-partner="{{chip.partner}}"
            >
              <view class="order-process-chip__head">
                <text class="order-process-chip__name">{{chip.nodeName}}</text>
                <text class="order-process-chip__name order-process-chip__partner">{{chip.partner}}</text>
              </view>
              <view class="order-process-chip__circle">
                <text class="order-process-chip__count">{{chip.received}}</text>
              </view>
              <text class="order-process-chip__meta">{{chip.metaText}}</text>
              <view class="order-process-chip__bar">
                <view class="order-process-chip__bar-fill" style="width: {{chip.progress}}%;"></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{showRelatedOrders}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">关联工单</text>
        </view>
        <view class="plan-form-card">
          <view wx:for="{{relatedOrders}}" wx:key="id" class="plan-form-cell product-detail-order-cell">
            <text class="plan-form-cell__label product-detail-order-label">{{item.orderNumber}}</text>
            <view class="plan-form-cell__value product-detail-order-meta">
              <text class="product-detail-order-qty">{{item.quantityText}}</text>
              <text wx:if="{{item.showStockIn}}" class="product-detail-order-stockin">{{item.stockInText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
