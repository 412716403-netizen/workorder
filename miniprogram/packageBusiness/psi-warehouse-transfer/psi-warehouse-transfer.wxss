@import '../production-plans/production-plans.wxss';

.wh-doc-list-page {
  padding: 0 var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
}

.wh-doc-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.wh-doc-card__title-row {
  margin-bottom: 8rpx;
}

.wh-doc-card__doc {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.wh-doc-card__route {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
}

.wh-doc-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}

.wh-doc-card__meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.wh-doc-card__note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
