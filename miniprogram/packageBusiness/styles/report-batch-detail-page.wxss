@import '/packageBusiness/styles/order-detail-page.wxss';
@import '/packageBusiness/styles/plan-create-form.wxss';

@import '/packageBusiness/styles/matrix-keyboard-page.wxss';

.plan-detail-page--keyboard {
  /* 保留别名，实际占位见 matrix-keyboard-page.wxss */
}

.report-matrix__cell {
  padding: 8rpx 6rpx;
}

.report-qty-head .plan-form-cell__label {
  margin-bottom: 0;
}

.report-qty-toggle {
  display: flex;
  gap: 8rpx;
  padding: 4rpx;
  background: var(--color-bg-page);
  border-radius: 12rpx;
}

.report-qty-toggle__item {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: 10rpx;
}

.report-qty-toggle__item--active {
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.plan-detail-matrix__qty--defective {
  color: #d97706;
}

.report-batch-hero {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
}

.report-batch-hero__left {
  width: 112rpx;
  flex-shrink: 0;
}

.report-batch-hero__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page);
  display: block;
}

.report-batch-hero__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-batch-hero__placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.35;
}

.report-batch-hero__text {
  flex: 1;
  min-width: 0;
}

.report-batch-hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.report-batch-hero__badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(47, 107, 255, 0.12);
}

.report-batch-hero__badge--mono {
  font-family: monospace;
}

.report-batch-hero__milestone {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.report-batch-hero__meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.report-batch-hero__meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.report-batch-hero__custom {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.report-batch-hero__custom-item {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.report-batch-line {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.report-batch-line:last-child {
  border-bottom: none;
}

.report-batch-line__head {
  margin-bottom: 12rpx;
}

.report-batch-line__product {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-batch-line__variant {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.report-batch-line__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.report-batch-line__cell {
  min-width: 140rpx;
}

.report-batch-line__label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.report-batch-line__value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-batch-line__value--good {
  color: var(--color-success);
}

.report-batch-line__value--amount {
  color: var(--color-primary-dark);
}

.report-batch-line__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #d97706;
}

.report-batch-edit__input {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--color-bg-page);
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.report-batch-edit-line {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.report-batch-edit-line__title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-batch-edit-line__row {
  display: flex;
  gap: 16rpx;
}

.report-batch-edit-line__field {
  flex: 1;
}

.report-batch-edit-line__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.report-batch-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 150;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.report-batch-footer__inner {
  display: flex;
  gap: 16rpx;
}

.report-batch-footer__btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-button);
  font-size: 28rpx;
  font-weight: 600;
}

.report-batch-footer__btn--ghost {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.report-batch-footer__btn--primary {
  background: var(--color-primary);
  color: #fff;
}

.report-batch-footer__btn--danger {
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-danger);
}

.report-batch-footer__btn--disabled {
  opacity: 0.5;
}
