/* 产品分类标签选择（对齐 Web 业务分类 pill） */
.category-select {
  padding: 20rpx var(--spacing-card) 8rpx;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.category-select__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.category-select__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 16rpx;
}

.category-select__pill {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #475569;
  background: #fff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.category-select__pill--on {
  color: #fff;
  background: #4f46e5;
  border-color: #4f46e5;
}

.category-select__pill:active {
  opacity: 0.88;
}

.category-select__empty {
  padding-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
