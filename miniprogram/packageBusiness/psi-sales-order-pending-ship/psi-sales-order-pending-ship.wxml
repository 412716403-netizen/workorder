<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">待发货清单</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="单号 / 客户 / 产品 / 仓库"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <view class="so-pending-page">
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{rows.length}}">
      <view wx:for="{{rows}}" wx:key="groupKey" class="so-pending-row">
        <view class="so-pending-row__check" catchtap="onToggleSelect" data-group-key="{{item.groupKey}}">
          <view class="so-pending-row__checkbox {{item.checked ? 'so-pending-row__checkbox--on' : ''}}"></view>
        </view>
        <view class="so-pending-row__body" bindtap="onRowTap" data-group-key="{{item.groupKey}}">
          <view class="so-pending-row__main">
            <view class="report-history-row__thumb so-pending-row__thumb">
              <image
                wx:if="{{item.showProductImage}}"
                class="report-history-row__img"
                src="{{item.productImageUrl}}"
                mode="aspectFill"
                data-group-key="{{item.groupKey}}"
                binderror="onProductImageError"
              />
              <view wx:else class="report-history-row__img report-history-row__img--placeholder">
                <image class="report-history-row__placeholder-icon" src="{{item.placeholderIconSrc}}" mode="aspectFit" />
              </view>
            </view>
            <view class="so-pending-row__content">
              <view class="so-pending-row__head">
                <view class="so-pending-row__head-main">
                  <text class="so-pending-row__partner">{{item.partner}}</text>
                  <text class="so-pending-row__head-dot">·</text>
                  <text class="so-pending-row__doc">{{item.docNumber}}</text>
                </view>
                <text class="so-pending-row__qty">{{item.qtyText}}</text>
              </view>
              <view class="so-pending-row__product">
                <text class="report-history-row__product-name">{{item.productName}}</text>
                <text wx:if="{{item.showProductSku}}" class="report-history-row__sku">{{item.productSku}}</text>
              </view>
              <view class="so-pending-row__foot">
                <text class="so-pending-row__wh">仓库 {{item.warehouseName}}</text>
                <view
                  class="so-pending-row__detail-btn"
                  catchtap="onDetailTap"
                  data-doc-number="{{item.docNumber}}"
                  data-line-group-id="{{item.lineGroupId}}"
                >详情</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <empty-state wx:else text="{{emptyText}}" />
  </view>

  <view wx:if="{{rows.length}}" class="so-pending-footer">
    <view class="so-pending-footer__inner">
      <view class="so-pending-footer__hint">
        <text class="so-pending-footer__hint-label">已选</text>
        <text class="so-pending-footer__hint-count {{selectedCount > 0 ? 'so-pending-footer__hint-count--active' : ''}}">{{selectedCount}}</text>
        <text class="so-pending-footer__hint-label">项</text>
      </view>
      <button
        class="so-pending-footer__btn"
        hover-class="so-pending-footer__btn--hover"
        loading="{{submitting}}"
        disabled="{{submitting || selectedCount === 0}}"
        bindtap="onGenerateBill"
      >{{submitting ? '生成中…' : '生成销售单'}}</button>
    </view>
  </view>
</view>
