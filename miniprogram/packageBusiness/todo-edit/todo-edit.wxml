<view class="plan-create-shell">
  <view class="plan-create-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-create-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-create-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-create-header__title">{{title}}</text>
      <view class="plan-create-header__back plan-create-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-create-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-create-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view class="plan-create-page">
      <view
        wx:if="{{docLabel}}"
        class="todo-edit-doc {{canJumpDoc ? 'todo-edit-doc--link' : ''}}"
        bindtap="onDocTap"
      >
        <view class="todo-edit-doc__body">
          <text class="todo-edit-doc__label">关联单据</text>
          <text class="todo-edit-doc__title">{{docLabel}}</text>
        </view>
        <text wx:if="{{canJumpDoc}}" class="todo-edit-doc__chevron">›</text>
      </view>

      <view class="plan-form-card">
        <view class="plan-form-cell plan-form-cell--textarea plan-form-cell--last">
          <textarea
            class="todo-edit-textarea"
            value="{{note}}"
            maxlength="{{noteMax}}"
            placeholder="填写要跟进的事项备注…"
            placeholder-class="todo-edit-textarea__ph"
            bindinput="onNoteInput"
            auto-height
          />
        </view>
      </view>

      <view class="plan-form-card">
        <view class="todo-edit-remind" bindtap="onRemindToggle">
          <text class="todo-edit-remind__label">定时提醒</text>
          <view class="todo-edit-switch {{remindEnabled ? 'todo-edit-switch--on' : ''}}">
            <view class="todo-edit-switch__knob"></view>
          </view>
        </view>
        <datetime-calendar-select
          wx:if="{{remindEnabled}}"
          last="{{true}}"
          label="提醒时间"
          date="{{remindDate}}"
          time="{{remindTime}}"
          placeholder="请选择"
          bind:change="onRemindDateTimeChange"
          bind:sheetopen="onPickerSheetOpen"
          bind:sheetclose="onPickerSheetClose"
        />
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!pickerSheetOpen}}" class="report-batch-footer">
    <view class="report-batch-footer__inner">
      <block wx:if="{{isEdit}}">
        <view
          class="report-batch-footer__btn report-batch-footer__btn--danger {{deleting ? 'report-batch-footer__btn--disabled' : ''}}"
          bindtap="onDeleteTap"
        >删除</view>
        <view
          class="report-batch-footer__btn report-batch-footer__btn--primary {{submitting ? 'report-batch-footer__btn--disabled' : ''}}"
          bindtap="onSubmit"
        >保存</view>
      </block>
      <block wx:else>
        <view class="report-batch-footer__btn report-batch-footer__btn--ghost" bindtap="onHeaderBack">取消</view>
        <view
          class="report-batch-footer__btn report-batch-footer__btn--primary {{submitting ? 'report-batch-footer__btn--disabled' : ''}}"
          bindtap="onSubmit"
        >加入待办</view>
      </block>
    </view>
  </view>
</view>
