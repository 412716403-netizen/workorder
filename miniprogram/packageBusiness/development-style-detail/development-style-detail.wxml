<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">款式详情</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{detail}}" class="plan-detail-page dev-detail-page">
      <view class="dev-detail-hero">
        <view class="dev-detail-hero__top">
          <view
            class="dev-detail-hero__product {{detail.actions.showEdit ? 'dev-detail-hero__product--tappable' : ''}}"
            bindtap="onProductTap"
          >
            <view class="dev-detail-hero__media">
              <image
                wx:if="{{detail.showProductImage}}"
                class="dev-detail-hero__img"
                src="{{detail.productImageUrl}}"
                mode="aspectFill"
                binderror="onImageError"
              />
              <view wx:else class="dev-detail-hero__img dev-detail-hero__img--ph">
                <image class="dev-detail-hero__ph-icon" src="{{detail.placeholderIconSrc}}" mode="aspectFit" />
              </view>
            </view>

            <view class="dev-detail-hero__main">
              <view class="dev-detail-hero__title-row">
                <text class="dev-detail-hero__name">{{detail.productName}}</text>
                <text wx:if="{{detail.showProductSku}}" class="dev-detail-hero__sku">{{detail.productSku}}</text>
              </view>
              <view class="dev-detail-hero__badges">
                <text class="dev-status-badge dev-status-badge--{{detail.statusTone}}">{{detail.statusLabel}}</text>
              </view>
              <view wx:if="{{detail.showCustomer}}" class="dev-detail-hero__customer">
                客户 · {{detail.customerName}}
              </view>
            </view>
          </view>

          <view wx:if="{{detail.hasProductActions || showTodoBtn}}" class="dev-hero-actions">
            <view
              wx:if="{{showTodoBtn}}"
              class="dev-hero-outline-btn"
              catchtap="onAddTodoTap"
            >待办</view>
            <view
              wx:if="{{detail.actions.showArchive}}"
              class="dev-hero-outline-btn"
              bindtap="onArchiveTap"
            >归档</view>
            <view
              wx:if="{{detail.actions.showRestore}}"
              class="dev-hero-outline-btn"
              bindtap="onRestoreTap"
            >返回开发</view>
            <view
              wx:if="{{detail.actions.showPublish}}"
              class="dev-hero-outline-btn"
              bindtap="onPublishTap"
            >生成商品</view>
          </view>
        </view>
      </view>

      <view class="dev-section-card">
        <view class="dev-section-card__head">
          <text class="dev-section-card__title">样品开发记录</text>
          <view class="dev-detail-section-actions">
            <view
              wx:if="{{activeSample}}"
              class="dev-hero-outline-btn"
              bindtap="onLogsTap"
            >日志</view>
            <view
              wx:if="{{showMaterialSection}}"
              class="dev-hero-outline-btn"
              bindtap="onMaterialTap"
            >开发物料</view>
            <view
              wx:if="{{detail.actions.showBom}}"
              class="dev-hero-outline-btn dev-hero-outline-btn--amber"
              bindtap="onBomTap"
            >BOM</view>
          </view>
        </view>

        <view wx:if="{{detail.samples.length}}" class="dev-sample-tabs-row">
          <scroll-view class="dev-sample-tabs" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="dev-sample-tabs__inner">
              <view
                wx:for="{{detail.samples}}"
                wx:key="id"
                class="dev-sample-tab {{activeSampleId === item.id ? 'dev-sample-tab--active' : ''}}"
                data-id="{{item.id}}"
                bindtap="onSampleTabTap"
              >{{item.name}}</view>
              <view
                wx:if="{{detail.actions.showAddSample}}"
                class="dev-sample-tab dev-sample-tab--add"
                bindtap="onAddSampleOpen"
              >＋</view>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{!detail.samples.length}}" class="dev-empty-block">
          <text class="dev-empty-block__text">暂无样品轮次</text>
          <text class="dev-empty-block__hint">创建头样后即可登记开发节点</text>
          <view
            wx:if="{{detail.actions.showAddSample}}"
            class="dev-empty-block__cta"
            bindtap="onAddSampleOpen"
          >＋ 创建头样</view>
        </view>

        <block wx:elif="{{activeSample}}">
          <view class="dev-sample-meta">
            <text wx:if="{{activeSample.variantLabel}}" class="dev-sample-meta__spec">规格 · {{activeSample.variantLabel}}</text>
            <text wx:else class="dev-sample-meta__spec">开发节点进度</text>
            <view
              wx:if="{{detail.actions.showDeleteSample}}"
              class="dev-sample-delete"
              bindtap="onDeleteSampleTap"
              aria-label="删除样品"
            >
              <image class="dev-sample-delete__icon" src="/assets/icons/trash-2.png" mode="aspectFit" />
            </view>
          </view>

          <view class="dev-timeline">
            <view
              wx:for="{{activeSample.stageRows}}"
              wx:key="id"
              class="dev-timeline__item {{item.statusClass}}"
              data-id="{{item.id}}"
              bindtap="onStageTap"
            >
              <view class="dev-timeline__rail">
                <view class="dev-timeline__dot">{{item.orderLabel}}</view>
                <view wx:if="{{!item.isLast}}" class="dev-timeline__line"></view>
              </view>
              <view class="dev-timeline__card">
                <view class="dev-timeline__head">
                  <text class="dev-timeline__name">{{item.name}}</text>
                  <text class="dev-timeline__status">{{item.statusLabel}}</text>
                </view>
                <view wx:if="{{item.fieldThumbs.length}}" class="dev-timeline__thumbs">
                  <view
                    wx:for="{{item.fieldThumbs}}"
                    wx:for-item="thumb"
                    wx:key="id"
                    class="dev-timeline__thumb-wrap"
                  >
                    <image
                      class="dev-timeline__thumb"
                      src="{{thumb.src}}"
                      mode="aspectFill"
                      data-src="{{thumb.src}}"
                      catchtap="onThumbPreview"
                    />
                    <text class="dev-timeline__thumb-label">{{thumb.label}}</text>
                  </view>
                </view>
                <view wx:if="{{item.fieldPreview}}" class="dev-timeline__preview">{{item.fieldPreview}}</view>
                <view class="dev-timeline__foot">
                  <text>{{item.updatedAtLabel}}</text>
                  <text class="dev-timeline__cta">点按登记 ›</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{addSampleOpen}}" class="dev-styles-sheet-mask" bindtap="onAddSampleClose" catchtouchmove="noop">
    <view class="dev-styles-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="dev-styles-sheet__handle"></view>
      <view class="dev-styles-sheet__title">新增样品轮次</view>
      <view class="dev-styles-sheet__label">名称</view>
      <input class="dev-sample-input" value="{{sampleName}}" bindinput="onSampleNameInput" placeholder="如：头样" />
      <block wx:if="{{detail.hasVariants}}">
        <view class="dev-styles-sheet__label">颜色 × 尺码 <text class="dev-styles-sheet__req">*</text></view>
        <view class="category-select category-select--inset">
          <view wx:if="{{sampleVariantOptions.length}}" class="category-select__pills">
            <view
              wx:for="{{sampleVariantOptions}}"
              wx:key="key"
              class="category-select__pill {{item.selected ? 'category-select__pill--on' : ''}}"
              data-index="{{index}}"
              catchtap="onSampleVariantTap"
            >{{item.label}}</view>
          </view>
          <view wx:else class="category-select__empty">暂无可选颜色尺码</view>
        </view>
      </block>
      <view class="dev-sample-confirm" catchtap="onAddSampleConfirm">确定</view>
    </view>
  </view>

  <view wx:if="{{logSheetOpen}}" class="dev-styles-sheet-mask" bindtap="onLogsClose" catchtouchmove="noop">
    <view class="dev-styles-sheet" catchtap="noop" catchtouchmove="noop">
      <view class="dev-styles-sheet__handle"></view>
      <view class="dev-styles-sheet__title">版本日志</view>
      <view wx:if="{{!logRows.length}}" class="plan-detail-muted">暂无日志</view>
      <view wx:for="{{logRows}}" wx:key="id" class="dev-log-row">
        <view class="dev-log-row__action">{{item.action}}</view>
        <view class="dev-log-row__detail">{{item.detail}}</view>
        <view class="dev-log-row__meta">{{item.user}} · {{item.time}}</view>
      </view>
    </view>
  </view>
</view>
