<view class="plan-create-shell">
  <view class="plan-create-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-create-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-create-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-create-header__title">{{pageTitle}}</text>
      <view class="plan-create-header__back plan-create-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-create-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view class="plan-create-scroll" scroll-y style="height: {{scrollHeight}}px;" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="plan-create-muted">加载中…</view>

    <view wx:else class="plan-create-page basic-partner-edit-page">
      <view class="plan-form-card">
        <view class="plan-form-cell plan-form-cell--section">
          <text class="plan-form-cell__label">单位基础档案</text>
        </view>

        <view class="category-select">
          <text class="category-select__label"><text wx:if="{{!isPersisted}}" class="plan-form-cell__req">*</text>单位分类</text>
          <view wx:if="{{categoryOptions.length}}" class="category-select__pills">
            <view
              wx:for="{{categoryOptions}}"
              wx:key="id"
              class="category-select__pill {{item.selected ? 'category-select__pill--on' : ''}}"
              data-id="{{item.id}}"
              bindtap="onCategoryTap"
            >{{item.name}}</view>
          </view>
          <view wx:else class="category-select__empty">暂无单位分类，请先在系统设置中添加</view>
        </view>

        <view class="plan-form-cell plan-form-cell--input">
          <text class="plan-form-cell__label"><text class="plan-form-cell__req">*</text>单位名称</text>
          <input
            class="plan-form-cell__input"
            value="{{form.name}}"
            bindinput="onNameInput"
            placeholder="公司或个人名称"
            placeholder-class="plan-form-cell__ph"
          />
        </view>

        <view wx:if="{{isPersisted && showListNo}}" class="plan-form-cell plan-form-cell--input">
          <text class="plan-form-cell__label">单位编号</text>
          <view>
            <text class="basic-partner-edit__list-no">{{listNoText}}</text>
            <text class="basic-partner-edit__list-no-hint">自动分配 · 不可修改</text>
          </view>
        </view>

        <view wx:if="{{showCollab}}" class="plan-form-cell plan-form-cell--input">
          <text class="plan-form-cell__label">协作关联</text>
          <text class="basic-partner-edit__collab">已关联协作企业</text>
        </view>
      </view>

      <view wx:if="{{customFields.length}}" class="plan-form-card">
        <view class="plan-form-cell plan-form-cell--section">
          <text class="plan-form-cell__label">扩展属性</text>
        </view>
        <plan-form-custom-field
          fields="{{customFields}}"
          values="{{form.customData}}"
          bind:change="onCustomFieldsChange"
        />
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading}}" class="report-batch-footer">
    <view
      wx:if="{{canDelete && isPersisted}}"
      class="report-batch-footer__btn report-batch-footer__btn--ghost {{submitting ? 'report-batch-footer__btn--disabled' : ''}}"
      bindtap="onDeleteTap"
    >删除</view>
    <view
      class="report-batch-footer__btn report-batch-footer__btn--primary {{submitting ? 'report-batch-footer__btn--disabled' : ''}}"
      bindtap="onSaveTap"
    >{{submitting ? '保存中…' : '保存资料'}}</view>
  </view>
</view>
