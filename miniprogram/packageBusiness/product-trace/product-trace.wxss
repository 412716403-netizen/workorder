@import '../production-plan-create/production-plan-create.wxss';
@import '../../styles/scan-primary-btn.wxss';

.trace-intro-card {
  padding: 24rpx var(--spacing-card);
}

.trace-intro-card__hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.trace-empty-hint {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.trace-status-card,
.trace-error-card,
.trace-void-card {
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e8eaed;
  text-align: center;
}

.trace-status-card__text {
  font-size: 28rpx;
  color: #8f959e;
}

.trace-error-card {
  border-color: #fecdd3;
  background: #fff1f2;
}

.trace-error-card__text {
  font-size: 28rpx;
  color: #e11d48;
}

.trace-void-card {
  border-color: #fde68a;
  background: #fffbeb;
}

.trace-void-card__text {
  font-size: 28rpx;
  color: #b45309;
}

.trace-summary-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e8eaed;
}

.trace-summary-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.trace-summary-card__badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 20rpx;
  font-weight: 700;
}

.trace-summary-card__serial {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.trace-summary-card__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
}

.trace-summary-card__field {
  min-width: 0;
}

.trace-summary-card__label {
  display: block;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #8f959e;
}

.trace-summary-card__value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}

.trace-summary-card__ctx {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f2;
  font-size: 24rpx;
  color: #646a73;
  line-height: 1.5;
}

.trace-summary-card__ctx-label {
  font-weight: 700;
  color: #8f959e;
}

.trace-timeline-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e8eaed;
}

.trace-timeline-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.trace-timeline-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.trace-timeline-card__serial {
  font-size: 26rpx;
  font-weight: 700;
  color: #4f46e5;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.trace-timeline-card__stats {
  display: block;
  margin-bottom: 20rpx;
  font-size: 20rpx;
  color: #8f959e;
}

.trace-timeline-card__empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #bbbfc4;
}

.trace-timeline {
  position: relative;
  padding-left: 40rpx;
}

.trace-timeline::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: #e8eaed;
}

.trace-timeline__item {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.trace-timeline__dot {
  position: absolute;
  left: -34rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.trace-dot--indigo { background: #6366f1; }
.trace-dot--amber { background: #f59e0b; }
.trace-dot--rose { background: #f43f5e; }
.trace-dot--emerald { background: #10b981; }
.trace-dot--sky { background: #0ea5e9; }
.trace-dot--slate { background: #94a3b8; }

.trace-timeline__icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-top: 2rpx;
  border-radius: 16rpx;
}

.trace-icon--indigo { background: #6366f1; }
.trace-icon--amber { background: #f59e0b; }
.trace-icon--rose { background: #f43f5e; }
.trace-icon--emerald { background: #10b981; }
.trace-icon--sky { background: #0ea5e9; }
.trace-icon--slate { background: #94a3b8; }

.trace-timeline__body {
  flex: 1;
  min-width: 0;
}

.trace-timeline__title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 12rpx;
}

.trace-timeline__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2329;
}

.trace-timeline__time {
  font-size: 20rpx;
  color: #8f959e;
}

.trace-timeline__tenant {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  font-size: 20rpx;
  font-weight: 600;
  color: #646a73;
}

.trace-timeline__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #646a73;
}

.trace-timeline__notes {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8f959e;
  line-height: 1.4;
}

.trace-load-more {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.trace-load-more__btn {
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e8eaed;
  background: #f7f8fa;
  font-size: 24rpx;
  font-weight: 600;
  color: #646a73;
}

.trace-load-more__btn--disabled {
  opacity: 0.6;
}

.trace-timeline-card__note {
  display: block;
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #8f959e;
  line-height: 1.5;
}
