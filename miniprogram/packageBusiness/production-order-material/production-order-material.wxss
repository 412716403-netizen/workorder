@import '../production-plans/production-plans.wxss';
@import '../../styles/doc-entry-datetime.wxss';

.material-issue-page {
  padding: 0 var(--spacing-page) calc(160rpx + env(safe-area-inset-bottom));
}

.material-issue-hero {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-issue-hero__partner {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.material-issue-hero__partner-picker {
  margin-bottom: 16rpx;
}

.material-issue-hero__partner-picker .material-issue-wh__label {
  margin-bottom: 8rpx;
}

.material-issue-hero__partner-picker .material-issue-wh__picker {
  background: var(--color-bg-page);
  border-radius: 12rpx;
}

.material-issue-hero__line {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
  gap: 0;
  min-width: 0;
  overflow: hidden;
}

.material-issue-hero__order {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.material-issue-hero__sep {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.material-issue-entry-time {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-issue-hero__product {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-issue-hero__sku {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-issue-hero__subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.material-issue-wh {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-issue-wh__label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.material-issue-wh__picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: #fff;
}

.material-issue-table-scroll {
  width: 100%;
  white-space: nowrap;
}

.material-issue-table {
  display: inline-block;
  min-width: 100%;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}

.material-issue-table__thead,
.material-issue-table__tr {
  display: flex;
  align-items: stretch;
  min-width: 760rpx;
}

.material-issue-table--batch .material-issue-table__thead,
.material-issue-table--batch .material-issue-table__tr {
  min-width: 960rpx;
}

.material-issue-table--return-outsource .material-issue-table__thead,
.material-issue-table--return-outsource .material-issue-table__tr {
  min-width: 1080rpx;
}

.material-issue-table--return-outsource.material-issue-table--batch .material-issue-table__thead,
.material-issue-table--return-outsource.material-issue-table--batch .material-issue-table__tr {
  min-width: 1280rpx;
}

.material-issue-table--return-internal .material-issue-table__thead,
.material-issue-table--return-internal .material-issue-table__tr {
  min-width: 1120rpx;
}

.material-issue-table--return-internal.material-issue-table--batch .material-issue-table__thead,
.material-issue-table--return-internal.material-issue-table--batch .material-issue-table__tr {
  min-width: 1320rpx;
}

.material-issue-table__th--stat,
.material-issue-table__td--stat {
  width: 100rpx;
  text-align: right;
}

.material-issue-table__th--highlight,
.material-issue-table__td--stat-surplus {
  color: #059669;
}

.material-issue-table__td--stat-dispatch {
  color: #4f46e5;
}

.material-issue-table__td--stat-consume {
  color: #d97706;
}

.material-issue-table__td--stat {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.material-issue-table__thead {
  background: rgba(248, 250, 252, 0.95);
  border-bottom: 1rpx solid var(--color-border);
}

.material-issue-table__tr {
  border-bottom: 1rpx solid rgba(241, 245, 249, 0.9);
}

.material-issue-table__tr:last-child {
  border-bottom: none;
}

.material-issue-table__th,
.material-issue-table__td {
  padding: 20rpx 16rpx;
  flex-shrink: 0;
  white-space: normal;
}

.material-issue-table__th {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  letter-spacing: 0.04em;
}

.material-issue-table__th--name,
.material-issue-table__td--name {
  width: 280rpx;
  flex: 1 1 280rpx;
  min-width: 220rpx;
}

.material-issue-table__th--num,
.material-issue-table__td--num {
  width: 120rpx;
  text-align: right;
}

.material-issue-table__th--progress,
.material-issue-table__td--progress {
  width: 220rpx;
}

.material-issue-table__th--batch,
.material-issue-table__td--batch {
  width: 200rpx;
}

.material-issue-table__th--input,
.material-issue-table__td--input {
  width: 160rpx;
}

.material-issue-table__th--action,
.material-issue-table__td--action {
  width: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.material-issue-row-delete {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #e11d48;
  background: rgba(225, 29, 72, 0.06);
}

.material-issue-row-delete:active {
  background: rgba(225, 29, 72, 0.14);
}

.material-issue-batch-picker {
  width: 100%;
  min-height: 72rpx;
  line-height: 1.3;
  padding: 12rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  background: #fff;
  box-sizing: border-box;
  word-break: break-all;
}

.material-issue-batch-picker--readonly {
  line-height: 72rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

.material-issue-table__td--num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: right;
}

.material-issue-hero__line--tap:active {
  opacity: 0.72;
}

.material-issue-table__td--tap:active {
  background: rgba(99, 102, 241, 0.06);
}

/* 名称与编号上下排布，避免单行挤裁导致只见编号尾部（对齐 production-stock-out / 工单物料表） */
.material-issue-table__name-line {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  min-width: 0;
  max-width: 100%;
}

.material-issue-table__name {
  display: block;
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: normal;
  word-break: break-all;
  line-height: 1.35;
}

.material-issue-table__sku {
  display: block;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: normal;
  word-break: break-all;
  line-height: 1.3;
}

.material-issue-table__tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.material-issue-table__tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #4338ca;
  background: #eef2ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.material-issue-progress__bar {
  height: 8rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
}

.material-issue-progress__fill {
  height: 100%;
}

.material-issue-progress__fill--blue {
  background: #6366f1;
  border-radius: 999rpx;
}

.material-issue-progress__fill--green {
  background: #10b981;
}

.material-issue-progress__fill--red {
  background: #f43f5e;
}

.material-issue-progress__label {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.material-issue-progress__label--warn {
  color: #e11d48;
}

.material-issue-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
  background: #fff;
  box-sizing: border-box;
}

.material-issue-input--readonly {
  line-height: 72rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

.material-issue-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--color-border);
  z-index: 20;
}

.material-issue-submit {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.material-issue-submit--disabled {
  opacity: 0.5;
}

.material-issue-submit--return {
  background: #059669;
}

/* 兼容确认页引用 */
.material-page {
  padding: 0 var(--spacing-page) calc(32rpx + env(safe-area-inset-bottom));
}

.material-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.material-row__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.material-row__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.material-row__form {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.material-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.material-submit {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.material-submit--disabled {
  opacity: 0.5;
}
