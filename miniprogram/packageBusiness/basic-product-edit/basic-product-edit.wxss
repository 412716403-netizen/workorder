@import '/styles/plan-create-form.wxss';
@import '/styles/category-select-pills.wxss';

.basic-product-edit-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.basic-product-edit__name-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.basic-product-edit__refresh-code {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: -8rpx -8rpx -8rpx 0;
  border-radius: 12rpx;
}

.basic-product-edit__refresh-code--hover {
  background: rgba(47, 107, 255, 0.08);
}

.basic-product-edit__refresh-code-icon {
  width: 32rpx;
  height: 32rpx;
}

.basic-product-edit__image-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.basic-product-edit__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
  overflow: hidden;
}

.basic-product-edit__image-clear {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  background: #f8fafc;
  border-radius: 12rpx;
}

.basic-product-edit__image-img {
  width: 100%;
  height: 100%;
}

.basic-product-edit__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.basic-product-edit__section-title {
  margin: 24rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.basic-product-edit__lock {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
}

.basic-product-edit__node-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.basic-product-edit__node-chip {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
}

.basic-product-edit__node-chip--on {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.basic-product-edit__node-chip--disabled {
  opacity: 0.5;
}

.basic-product-edit__node-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.basic-product-edit__node-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}

.basic-product-edit__node-move {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: #eef2ff;
  border-radius: 8rpx;
}

.basic-product-edit__weight-grid {
  margin-top: 16rpx;
}

.basic-product-edit__weight-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.basic-product-edit__weight-label {
  flex: 1;
  font-size: 24rpx;
}

.basic-product-edit__weight-input {
  width: 160rpx;
  height: 64rpx;
  padding: 0 16rpx;
  text-align: right;
  font-size: 26rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.basic-product-edit__desktop-hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.report-batch-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.report-batch-footer__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.report-batch-footer__btn--ghost {
  color: #ef4444;
  background: #fef2f2;
}

.report-batch-footer__btn--primary {
  color: #fff;
  background: var(--color-primary);
}

.report-batch-footer__btn--disabled {
  opacity: 0.5;
}
