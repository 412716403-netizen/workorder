@import '/styles/psi-purchase-order-detail-page.wxss';

.kb-product-page {
  padding: 0 var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.kb-product-page__category {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.plan-form-cell__value {
  word-break: break-word;
  white-space: pre-wrap;
}

.plan-form-cell__value--empty {
  color: var(--color-text-tertiary);
  font-style: italic;
}

.plan-form-cell__value--link {
  color: var(--color-primary, #4f46e5);
  font-weight: 600;
}

.plan-form-cell__value--thumbs {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.kb-custom-thumbs {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.kb-custom-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  border: 1rpx solid var(--color-border, #eef0f3);
}

.kb-custom-file-link {
  font-size: 26rpx;
}

.kb-product-empty {
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.kb-process-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kb-process-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--color-border, #eef0f3);
  overflow: hidden;
}

.kb-process-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
}

.kb-process-card__index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
  background: var(--color-primary);
  border-radius: 10rpx;
}

.kb-process-card__name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.kb-process-card__bom {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: #eef2ff;
  border-radius: 8rpx;
}

.kb-process-card__rate {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
}

.kb-bom-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.kb-bom-tab {
  display: inline-block;
  margin-right: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
  border-radius: 14rpx;
}

.kb-bom-tab--empty {
  color: var(--color-text-tertiary);
  background: #f8fafc;
  border-color: var(--color-border, #eef0f3);
}

.kb-bom-tab--active {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.kb-bom-tab__hint {
  font-size: 20rpx;
  font-weight: 600;
}

.kb-bom-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kb-bom-group {
  padding: 20rpx;
  background: #f8fafc;
  border: 1rpx solid var(--color-border, #eef0f3);
  border-radius: 16rpx;
}

.kb-bom-group__head {
  margin-bottom: 12rpx;
}

.kb-bom-group__node {
  display: block;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.kb-bom-group__name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.kb-bom-item {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border: 1rpx solid var(--color-border, #eef0f3);
  border-radius: 12rpx;
}

.kb-bom-item__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.kb-bom-item__text {
  flex: 1;
  min-width: 0;
}

.kb-bom-item__name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-bom-item__sku {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.kb-bom-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
}

.kb-bom-item__tag {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #f8fafc;
  font-size: 18rpx;
  font-weight: 700;
  color: #64748b;
}

.kb-bom-item__qty {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.kb-bom-item__note {
  display: block;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.kb-bom-item__name--link {
  color: var(--color-primary);
}

.kb-where-used {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.kb-where-used__row {
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid var(--color-border, #eef0f3);
  border-radius: 12rpx;
}

.kb-where-used__name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-where-used__name--link {
  color: var(--color-primary);
}

.kb-where-used__sku {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.kb-where-used__toggle {
  margin-top: 12rpx;
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}
