.settings-cf-editor {
  padding: 0 var(--spacing-card) var(--spacing-card);
}

.settings-cf-field {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
}

.settings-cf-field__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.settings-cf-field__remove {
  flex-shrink: 0;
  margin-left: auto;
  padding: 8rpx 20rpx;
  font-size: var(--font-small);
  font-weight: 500;
  color: #ef4444;
  background: #fef2f2;
  border-radius: 999rpx;
  line-height: 1.4;
}

.settings-cf-field__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 72rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.settings-cf-field__row:last-of-type {
  border-bottom: none;
}

.settings-cf-field__label {
  flex-shrink: 0;
  width: 96rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.settings-cf-field__input {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-primary);
  text-align: right;
}

.settings-cf-field__ph {
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.settings-cf-field__row--picker {
  align-items: stretch;
}

.settings-cf-field__row--picker picker {
  flex: 1;
  min-width: 0;
}

.settings-cf-field__picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 48rpx;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-primary);
}

.settings-cf-field__picker--disabled {
  color: var(--color-text-tertiary);
}

.settings-cf-field__picker-chev {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
}

.settings-cf-field__hint {
  margin-top: 12rpx;
  font-size: var(--font-small);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.settings-cf-field__select {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
}

.settings-cf-field__select-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.settings-cf-field__select-title {
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.settings-cf-field__select-count {
  font-size: var(--font-small);
  color: var(--color-text-tertiary);
}

.settings-cf-field__select-empty {
  margin-bottom: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
  border-radius: 12rpx;
}

.settings-cf-field__opt-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.settings-cf-field__opt-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settings-cf-field__opt-index {
  flex-shrink: 0;
  width: 36rpx;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 72rpx;
}

.settings-cf-field__opt-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  font-size: var(--font-body);
  line-height: 72rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.settings-cf-field__opt-ph {
  color: var(--color-text-tertiary);
  font-size: var(--font-body);
}

.settings-cf-field__opt-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.settings-cf-field__opt-remove--hover {
  background: #fef2f2;
  border-color: #fecaca;
}

.settings-cf-field__opt-remove-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.settings-cf-field__add-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 18rpx 0;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.06);
  border-radius: 12rpx;
}

.settings-cf-field__add-opt-icon {
  font-size: 32rpx;
  line-height: 1;
}

.settings-cf-field__checks {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  flex: 1;
  min-width: 0;
}

.settings-cf-field__check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.settings-cf-field__check checkbox {
  transform: scale(0.9);
}

.settings-cf-editor__add {
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-bg-page);
  border: 1rpx dashed var(--color-border);
  border-radius: 16rpx;
}
