@import '../../../components/searchable-partner-select/searchable-partner-select.wxss';

.unit-select__list {
  padding-top: 8rpx;
}

.unit-select__pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.unit-select__chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #646a73);
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.unit-select__chip--on {
  color: var(--color-primary, #2f6bff);
  background: rgba(47, 107, 255, 0.1);
  border-color: rgba(47, 107, 255, 0.45);
}

.unit-select__chip-name {
  line-height: 1.2;
}

.unit-select__chip-check {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary, #2f6bff);
  line-height: 1;
}

.unit-select__quick {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}

.unit-select__quick-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.unit-select__quick-btn {
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary, #2f6bff);
  border-radius: 12rpx;
}

.unit-select__add-row {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
  border-top: 1rpx solid #f3f4f6;
}
