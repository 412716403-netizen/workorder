@import '../../styles/list.wxss';
@import '../../styles/plan-form-cell.wxss';
@import '../../styles/todo-entry.wxss';

.plan-detail-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.plan-detail-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-bottom: 12rpx;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
}

.plan-detail-header__bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 8rpx;
  box-sizing: border-box;
}

.plan-detail-header__back {
  width: 64rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.98);
  line-height: 1;
}

.plan-detail-header__back--placeholder {
  visibility: hidden;
  pointer-events: none;
}

.plan-detail-header__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-detail-header-spacer {
  flex-shrink: 0;
}

.plan-detail-scroll {
  flex: 1;
  width: 100%;
}

.plan-detail-page {
  padding: 16rpx var(--spacing-page) calc(32rpx + env(safe-area-inset-bottom));
}

.plan-detail-hero {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
}

.plan-detail-hero__img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--color-bg-page);
}

.plan-detail-hero__img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-detail-hero__placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.35;
}

.plan-detail-hero__text {
  flex: 1;
  min-width: 0;
}

.plan-detail-hero__left {
  width: 112rpx;
  flex-shrink: 0;
}

.plan-detail-hero__product-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}

.plan-detail-hero__product {
  flex-shrink: 1;
  min-width: 0;
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-detail-hero__product--link {
  color: var(--color-primary, #4f46e5);
}

.plan-detail-hero__sku {
  flex-shrink: 0;
  max-width: 48%;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-detail-hero__tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-detail-hero__custom-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  min-width: 0;
}

.plan-detail-section {
  margin-bottom: 28rpx;
}

.plan-detail-section__head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.plan-detail-section__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.plan-detail-section__sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.plan-form-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.plan-detail-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  font-style: italic;
}

.plan-detail-qty-total {
  padding: 32rpx var(--spacing-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.plan-detail-qty-total__label {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-detail-qty-total__value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.plan-detail-process-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-detail-process {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
}

.plan-detail-process--active {
  background: var(--color-bg-card);
  border-color: rgba(79, 70, 229, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.08);
}

.plan-detail-process__idx {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--color-bg-page);
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plan-detail-process--active .plan-detail-process__idx {
  background: var(--color-primary);
  color: #fff;
}

.plan-detail-process__body {
  flex: 1;
  min-width: 0;
}

.plan-detail-process__name {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.plan-detail-process__meta {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
  font-size: var(--font-caption);
}

.plan-detail-process__meta-label {
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.plan-detail-process__meta-value {
  color: var(--color-text-secondary);
  flex: 1;
}

.plan-detail-material-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.plan-detail-empty--bom {
  padding: 64rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
}

.plan-detail-material-loading {
  padding: 56rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-muted);
  background: var(--color-bg-card);
  border-radius: 20rpx;
}

.plan-detail-bom-scroll-outer {
  position: relative;
}

.plan-detail-bom-scroll {
  width: 100%;
}

.plan-detail-bom-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 48rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.92) 100%);
}

.plan-detail-bom-table {
  display: inline-block;
  min-width: 100%;
}

.plan-detail-bom-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--color-border);
}

.plan-detail-bom-row:last-child {
  border-bottom: none;
}

.plan-detail-bom-row--head {
  background: #f8fafc;
  border-bottom: 2rpx solid var(--color-border);
}

.plan-detail-bom-row--alt {
  background: rgba(248, 250, 252, 0.45);
}

.plan-detail-bom-row--sub {
  background: rgba(234, 241, 255, 0.35);
}

.plan-detail-bom-row--sub.plan-detail-bom-row--alt {
  background: rgba(234, 241, 255, 0.5);
}

.plan-detail-bom-col {
  flex-shrink: 0;
  padding: 20rpx 14rpx;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(238, 240, 243, 0.9);
}

.plan-detail-bom-col:last-child {
  border-right: none;
}

.plan-detail-bom-col--vcenter {
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-detail-bom-col--material {
  width: 340rpx;
}

.plan-detail-bom-col--sticky {
  background: inherit;
  box-shadow: 6rpx 0 16rpx rgba(31, 35, 41, 0.04);
  z-index: 1;
}

.plan-detail-bom-row--head .plan-detail-bom-col--sticky {
  background: #f8fafc;
}

.plan-detail-bom-col--loss {
  width: 112rpx;
}

.plan-detail-bom-col--num {
  width: 168rpx;
}

.plan-detail-bom-col--stock {
  width: 148rpx;
}

.plan-detail-bom-col--short {
  width: 148rpx;
}

.plan-detail-bom-col--plan {
  width: 168rpx;
}

.plan-detail-bom-col--status {
  width: 248rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.plan-detail-bom-th {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.plan-detail-bom-th-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  line-height: 1.3;
}

.plan-detail-bom-level {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.plan-detail-bom-level__bar {
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
  flex-shrink: 0;
}

.plan-detail-bom-level text {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 1rpx;
}

.plan-detail-bom-material-name {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.plan-detail-bom-material-sku {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.plan-detail-bom-tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.plan-detail-bom-tag {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-border);
}

.plan-detail-bom-num {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.plan-detail-bom-num--success {
  color: var(--color-success);
}

.plan-detail-bom-num--danger {
  color: var(--color-danger);
}

.plan-detail-bom-num--primary {
  color: var(--color-primary);
}

.plan-detail-bom-chip {
  display: inline-block;
  min-width: 56rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.plan-detail-bom-chip--muted {
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
}

.plan-detail-bom-chip--dash {
  color: var(--color-text-tertiary);
}

.plan-detail-bom-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.plan-detail-bom-badge--ok {
  color: var(--color-success);
  background: var(--color-success-bg);
}

.plan-detail-bom-badge--success {
  color: #15803d;
  background: rgba(52, 199, 89, 0.14);
}

.plan-detail-bom-badge--info {
  color: var(--color-text-secondary);
  background: var(--color-bg-input);
}

.plan-detail-bom-badge--muted {
  color: var(--color-text-tertiary);
  background: var(--color-bg-page);
}

.plan-detail-bom-qty-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: var(--color-bg-input);
  border: 1rpx solid var(--color-border);
}

.plan-detail-bom-qty-pill__text {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.plan-detail-bom-status-card {
  width: 100%;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.plan-detail-bom-status-card__label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.plan-detail-progress__track {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  overflow: hidden;
}

.plan-detail-progress__track--split {
  display: flex;
}

.plan-detail-progress__bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
  transition: width 0.2s ease;
}

.plan-detail-progress__bar--complete {
  background: #52c41a;
}

.plan-detail-progress__bar--ordered {
  border-radius: 999rpx 0 0 999rpx;
}

.plan-detail-progress__bar--over {
  border-radius: 0 999rpx 999rpx 0;
  background: #fa8c16;
}

.plan-detail-progress__text {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  text-align: right;
}

.plan-detail-progress__text--done {
  color: #52c41a;
}

.plan-detail-matrix-wrap {
  border-bottom: none;
}

.plan-form-cell--matrix-head {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.plan-detail-matrix-scroll {
  width: 100%;
}

.plan-detail-matrix {
  min-width: 100%;
  display: inline-block;
  padding: 0 var(--spacing-card) 16rpx;
  box-sizing: border-box;
}

.plan-detail-matrix__head,
.plan-detail-matrix__row {
  display: flex;
  align-items: stretch;
}

.plan-detail-matrix__head {
  background: var(--color-bg-page);
  border-radius: 12rpx 12rpx 0 0;
}

.plan-detail-matrix__corner,
.plan-detail-matrix__color {
  width: 160rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.plan-detail-matrix__corner {
  padding: 16rpx 12rpx;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.plan-detail-matrix__size {
  flex: 1;
  min-width: 88rpx;
  max-width: 120rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: var(--font-small);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.plan-detail-matrix__row {
  border-bottom: 1rpx solid var(--color-border);
}

.plan-detail-matrix__row:last-child {
  border-bottom: none;
}

.plan-detail-matrix__color {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 12rpx;
}

.plan-detail-matrix__swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.plan-detail-matrix__color-text {
  font-size: var(--font-caption);
  color: var(--color-text-primary);
}

.plan-detail-matrix__cell {
  flex: 1;
  min-width: 88rpx;
  max-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
}

.plan-detail-matrix__qty {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-primary);
}

.plan-detail-matrix__dash {
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
}

.plan-detail-muted {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.plan-detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx var(--spacing-page) calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.plan-detail-submit {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary-gradient-start), var(--color-primary-gradient-end));
  border: none;
}

.plan-detail-submit::after {
  border: none;
}

.plan-detail-submit--amber {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}
