@import '../../styles/plan-list-shell.wxss';

.settings-archive-page {
  padding: 16rpx var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.settings-archive-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.settings-archive-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.settings-archive-card__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.settings-archive-card__text {
  flex: 1;
  min-width: 0;
}

.settings-archive-card__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.settings-archive-card__name {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.settings-archive-card__tag {
  padding: 4rpx 14rpx;
  font-size: var(--font-small);
  font-weight: 500;
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.1);
  border-radius: 999rpx;
  line-height: 1.4;
}

.settings-archive-card__sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.settings-archive-card__chev {
  flex-shrink: 0;
  font-size: 44rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.settings-archive-card__actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.settings-archive-card__move {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: rgba(47, 107, 255, 0.08);
  border-radius: 12rpx;
}
