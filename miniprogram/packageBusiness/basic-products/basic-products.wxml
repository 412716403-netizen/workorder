<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">产品档案</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="搜索名称、编号、备注…"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view
        wx:if="{{canCreate}}"
        class="plan-tool-btn"
        bindtap="onCreateTap"
      >
        <image class="plan-tool-btn__icon" src="/assets/icons/file-plus.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    wx:if="{{categoryTabs.length}}"
    class="basic-products-cats"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{categoryTabs}}"
      wx:key="id"
      class="basic-products-cat {{item.active ? 'basic-products-cat--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.label}} ({{item.count}})</view>
  </scroll-view>

  <view wx:if="{{searchHint}}" class="basic-products-hint">{{searchHint}}</view>

  <view class="basic-products-page">
    <empty-state wx:if="{{loading && !rows.length}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{rows.length}}">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="basic-products-row"
        data-id="{{item.id}}"
        bindtap="onRowTap"
      >
        <view class="basic-products-row__body">
          <view class="basic-products-row__left">
            <view class="report-history-row__thumb">
              <image
                wx:if="{{item.showProductImage}}"
                class="report-history-row__img"
                src="{{item.productImageUrl}}"
                mode="aspectFill"
                data-id="{{item.id}}"
                binderror="onProductImageError"
              />
              <view wx:else class="report-history-row__img report-history-row__img--placeholder">
                <image class="report-history-row__placeholder-icon" src="{{item.placeholderIconSrc}}" mode="aspectFit" />
              </view>
            </view>
          </view>

          <view class="basic-products-row__content">
            <view class="basic-products-row__head">
              <view class="basic-products-row__title-wrap">
                <text class="report-history-row__product-name">{{item.productName}}</text>
                <text wx:if="{{item.showProductSku}}" class="report-history-row__sku">{{item.productSku}}</text>
                <text wx:if="{{item.showDisabledBadge}}" class="basic-products-row__disabled">已禁用</text>
              </view>
              <view
                wx:if="{{canEdit}}"
                class="basic-products-toggle {{item.enabled ? 'basic-products-toggle--on' : ''}}"
                data-id="{{item.id}}"
                catchtap="onToggleEnabled"
              >
                <view class="basic-products-toggle__knob"></view>
              </view>
            </view>

            <view wx:if="{{item.showCategory}}" class="basic-products-row__cat">
              <text class="basic-products-row__cat-pill">{{item.categoryName}}</text>
            </view>

            <view wx:if="{{item.showCustomTags}}" class="basic-products-row__tags">
              <text
                wx:for="{{item.customTags}}"
                wx:for-item="tag"
                wx:key="id"
                class="basic-products-row__tag"
              >{{tag.label}}: {{tag.display}}</text>
            </view>

            <view class="basic-products-row__stats">
              <text class="basic-products-row__stat">变体 {{item.variantCountText}}</text>
              <text class="basic-products-row__price">{{item.priceText}}</text>
              <text wx:if="{{item.showPrice}}" class="basic-products-row__price-label">{{item.priceLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{totalPages > 1}}" class="basic-products-pager">
        <view
          class="basic-products-pager__btn {{page <= 1 ? 'basic-products-pager__btn--disabled' : ''}}"
          bindtap="onPrevPage"
        >上一页</view>
        <text class="basic-products-pager__info">{{page}} / {{totalPages}} · 共 {{filteredTotal}} 条</text>
        <view
          class="basic-products-pager__btn {{page >= totalPages ? 'basic-products-pager__btn--disabled' : ''}}"
          bindtap="onNextPage"
        >下一页</view>
      </view>
      <view wx:else class="plan-list-footer">共 {{filteredTotal}} 条产品</view>
    </view>

    <empty-state wx:else text="{{emptyText}}" />
  </view>
</view>
