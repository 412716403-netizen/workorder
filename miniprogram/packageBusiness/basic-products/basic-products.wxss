@import '../production-plans/production-plans.wxss';
@import '../production-order-report-history/production-order-report-history.wxss';

.basic-products-cats {
  white-space: nowrap;
  padding: 12rpx var(--spacing-page) 0;
  box-sizing: border-box;
}

.basic-products-cat {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.basic-products-cat--active {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.basic-products-hint {
  padding: 0 var(--spacing-page) 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.basic-products-page {
  padding: 0 var(--spacing-page) calc(120rpx + env(safe-area-inset-bottom));
}

.basic-products-row {
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
}

.basic-products-row__body {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.basic-products-row__left {
  flex-shrink: 0;
  width: 96rpx;
}

.basic-products-row__left .report-history-row__img {
  width: 96rpx;
  height: 96rpx;
}

.basic-products-row__content {
  flex: 1;
  min-width: 0;
}

.basic-products-row__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.basic-products-row__title-wrap {
  flex: 1;
  min-width: 0;
}

.basic-products-row__disabled {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-tertiary);
  background: #f3f4f6;
  border-radius: 6rpx;
  vertical-align: middle;
}

.basic-products-toggle {
  flex-shrink: 0;
  position: relative;
  width: 72rpx;
  height: 40rpx;
  background: #cbd5e1;
  border-radius: 999rpx;
  transition: background 0.2s;
}

.basic-products-toggle--on {
  background: var(--color-primary);
}

.basic-products-toggle__knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s;
}

.basic-products-toggle--on .basic-products-toggle__knob {
  transform: translateX(32rpx);
}

.basic-products-row__cat {
  margin-bottom: 8rpx;
}

.basic-products-row__cat-pill {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
  border-radius: 8rpx;
}

.basic-products-row__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.basic-products-row__tag {
  padding: 4rpx 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: #f8fafc;
  border-radius: 6rpx;
}

.basic-products-row__stats {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
}

.basic-products-row__stat {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.basic-products-row__stat--bom {
  color: #059669;
}

.basic-products-row__price {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.basic-products-row__price-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.basic-products-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
}

.basic-products-pager__btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #eef2ff;
  border-radius: 12rpx;
}

.basic-products-pager__btn--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.basic-products-pager__info {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
