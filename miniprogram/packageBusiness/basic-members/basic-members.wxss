@import '../basic-products/basic-products.wxss';

/* Tab 位于蓝区下方，样式与间距对齐合作单位分类 Tab */
.basic-members-segment {
  padding-top: 20rpx;
  padding-bottom: 4rpx;
}

.basic-members-segment__item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.basic-members-segment__badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
  color: #fff;
  background: #ef4444;
}

.basic-products-cat--active .basic-members-segment__badge {
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-primary);
}

.basic-members-page {
  padding: 0 var(--spacing-page) calc(24rpx + env(safe-area-inset-bottom));
}

.basic-members-summary {
  padding: 8rpx 4rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.basic-members-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.basic-members-row__avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.basic-members-row__body {
  flex: 1;
  min-width: 0;
}

.basic-members-row__head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 12rpx;
  margin-bottom: 6rpx;
}

.basic-members-row__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.basic-members-row__sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.basic-members-row__role-pill {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: 999rpx;
}

.basic-members-row__role-pill--muted {
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border-color: var(--color-border);
}

.basic-members-row__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.basic-members-row__action {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.basic-members-row__action--blue {
  color: #2563eb;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.basic-members-row__action--danger {
  color: #dc2626;
  background: #fef2f2;
  border-color: #fecaca;
}

.basic-members-app-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.basic-members-app-row__body {
  flex: 1;
  min-width: 0;
}

.basic-members-app-row__message {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.basic-members-app-row__btns {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.basic-members-app-row__btn {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 12rpx;
}

.basic-members-app-row__btn--approve {
  color: #fff;
  background: #16a34a;
}

.basic-members-app-row__btn--reject {
  color: #dc2626;
  background: #fee2e2;
}

.basic-members-invite {
  padding-top: 8rpx;
}

.basic-members-invite__card {
  padding: 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.basic-members-invite__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.basic-members-invite__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.basic-members-invite__tenant {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.basic-members-invite__code-wrap {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
}

.basic-members-invite__code {
  font-size: 40rpx;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0.12em;
  color: var(--color-text-primary);
  word-break: break-all;
}

.basic-members-invite__copy {
  margin-top: 24rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
  border-radius: var(--radius-card);
}
