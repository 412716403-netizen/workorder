<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">{{editing ? '外协 · 编辑' : '外协详情'}}</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    enhanced
    scroll-top="{{matrixScrollTop}}"
    scroll-with-animation="{{false}}"
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{!detail}}" class="plan-detail-muted">未找到外协记录</view>

    <view wx:else class="plan-detail-page outsource-flow-detail-page {{matrixKeyboardVisible ? 'matrix-keyboard-page--open' : ''}}" bindtap="onMatrixOutsideTap">
      <view class="report-batch-hero">
        <view class="report-batch-hero__left">
          <image
            wx:if="{{detail.showProductImage}}"
            class="report-batch-hero__img"
            src="{{detail.productImageUrl}}"
            mode="aspectFill"
            binderror="onProductImageError"
          />
          <view wx:else class="report-batch-hero__img report-batch-hero__img--placeholder">
            <image class="report-batch-hero__placeholder-icon" src="{{detail.placeholderIconSrc}}" mode="aspectFit" />
          </view>
        </view>
        <view class="report-batch-hero__text">
          <view class="report-batch-hero__badges">
            <text class="report-batch-hero__badge report-batch-hero__badge--mono">{{detail.docNo}}</text>
            <text wx:if="{{detail.showOrderNumber}}" class="report-batch-hero__badge">{{detail.orderNumber}}</text>
            <text class="report-batch-hero__badge outsource-flow-detail__type">{{detail.typeLabel}}</text>
          </view>
          <text class="report-batch-hero__milestone">{{detail.productName}}<text wx:if="{{detail.showProductSku}}" class="list-product-sku"> {{detail.productSku}}</text></text>
          <view class="outsource-flow-detail__milestone">
            <text>工序：{{detail.milestoneName}}</text>
            <text wx:if="{{detail.showPartner}}" class="outsource-flow-detail__partner"> · {{detail.partner}}</text>
          </view>
          <view class="report-batch-hero__meta">
            <text class="report-batch-hero__meta-item">{{detail.timeLabel}}</text>
            <text wx:if="{{detail.operator && detail.operator !== '—'}}" class="report-batch-hero__meta-item">经办：{{detail.operator}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!editing}}" class="order-detail-summary">
        <view wx:if="{{detail.hasDispatch}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">外协发出</text>
          <text class="order-detail-summary__value">{{detail.dispatchTotalText}}</text>
        </view>
        <view wx:if="{{detail.hasReceive}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">外协收回</text>
          <text class="order-detail-summary__value order-detail-summary__value--success">{{detail.receiveTotalText}}</text>
        </view>
        <view wx:if="{{detail.showReceiveUnitPrice}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">单价</text>
          <text class="order-detail-summary__value">{{detail.receiveUnitPriceText}}</text>
        </view>
        <view wx:if="{{detail.showTotalAmount}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">单据金额</text>
          <text class="order-detail-summary__value order-detail-summary__value--success">{{detail.totalAmountText}}</text>
        </view>
      </view>

      <view wx:if="{{editing}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">编辑外协</text>
        </view>
        <view class="plan-form-card">
          <searchable-partner-select
            cell="{{true}}"
            required="{{true}}"
            label="合作单位"
            partners="{{partners}}"
            categories="{{partnerCategories}}"
            value="{{partnerName}}"
            placeholder="{{partners.length ? '请选择合作单位' : '暂无合作单位'}}"
            disabled="{{!partners.length}}"
            bind:change="onPartnerChange"
            bind:created="onPartnerCreated"
          />
          <datetime-calendar-select
            label="外协时间"
            date="{{detail.editDate}}"
            time="{{detail.editTime}}"
            bind:change="onEditDateTimeChange"
            bind:sheetopen="onPickerSheetOpen"
            bind:sheetclose="onPickerSheetClose"
          />
          <view class="plan-form-cell plan-form-cell--last">
            <text class="plan-form-cell__label">经办人</text>
            <input class="report-batch-edit__input" value="{{detail.editOperator}}" bindinput="onEditOperatorInput" placeholder="经办人" />
          </view>
        </view>
      </view>

      <view wx:if="{{detail.hasDispatch}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">发出明细</text>
          <text class="plan-detail-section__sub">{{detail.dispatchTotalText}}</text>
        </view>

        <view wx:if="{{!editing && detail.dispatchSection.showMatrix && detail.dispatchSection.matrixLayout}}" class="plan-form-card">
          <view class="plan-detail-matrix-wrap">
            <scroll-view class="plan-detail-matrix-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="plan-detail-matrix">
                <view class="plan-detail-matrix__head">
                  <view class="plan-detail-matrix__corner">颜色</view>
                  <view wx:for="{{detail.dispatchSection.matrixLayout.sizeColumns}}" wx:for-item="col" wx:key="id" class="plan-detail-matrix__size">{{col.header}}</view>
                </view>
                <view wx:for="{{detail.dispatchSection.matrixLayout.colorRows}}" wx:for-item="colorRow" wx:key="key" class="plan-detail-matrix__row">
                  <view class="plan-detail-matrix__color">
                    <view wx:if="{{colorRow.colorSwatch}}" class="plan-detail-matrix__swatch" style="background-color: {{colorRow.colorSwatch}};"></view>
                    <text class="plan-detail-matrix__color-text">{{colorRow.colorLabel}}</text>
                  </view>
                  <view wx:for="{{colorRow.cells}}" wx:for-item="cell" wx:key="index" class="plan-detail-matrix__cell">
                    <text wx:if="{{cell.variantId && cell.quantity}}" class="plan-detail-matrix__qty">{{cell.quantity}}</text>
                    <text wx:elif="{{cell.variantId}}" class="plan-detail-matrix__dash">0</text>
                    <text wx:else class="plan-detail-matrix__dash">—</text>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>

        <view wx:if="{{editing && dispatchUseMatrix && dispatchEditMatrixLayout}}" class="plan-form-card">
          <scroll-view class="plan-create-matrix-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="plan-create-matrix report-matrix">
              <view class="plan-create-matrix__head">
                <view class="plan-create-matrix__corner">颜色</view>
                <view wx:for="{{dispatchEditMatrixLayout.sizeColumns}}" wx:key="id" class="plan-create-matrix__size">{{item.header}}</view>
              </view>
              <view wx:for="{{dispatchEditMatrixLayout.colorRows}}" wx:for-item="row" wx:key="key" class="plan-create-matrix__row">
                <view class="plan-create-matrix__color">
                  <view wx:if="{{row.colorSwatch}}" class="plan-create-matrix__swatch" style="background-color: {{row.colorSwatch}};" />
                  <text class="plan-create-matrix__color-text">{{row.colorLabel}}</text>
                </view>
                <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="plan-create-matrix__cell report-matrix__cell">
                  <view
                    wx:if="{{cell.variantId}}"
                    class="plan-create-matrix__input {{activeEditSection === 'dispatch' && activeMatrixVariantId === cell.variantId ? 'plan-create-matrix__input--active' : ''}} {{activeEditSection === 'dispatch' && activeMatrixVariantId === cell.variantId && matrixInputReplaceAll && cell.quantity ? 'plan-create-matrix__input--replace' : ''}} {{cell.quantity ? 'plan-create-matrix__input--filled' : 'plan-create-matrix__input--empty'}}"
                    data-section="dispatch"
                    data-variant-id="{{cell.variantId}}"
                    catchtap="onMatrixCellTap"
                  >{{cell.quantity}}</view>
                  <text wx:else class="plan-create-matrix__dash">—</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{editing && !dispatchUseMatrix && editDispatchLineItems.length}}" class="plan-form-card">
          <view wx:for="{{editDispatchLineItems}}" wx:key="recordId" class="report-batch-edit-line">
            <view class="report-batch-edit-line__row">
              <view class="report-batch-edit-line__field">
                <text class="report-batch-edit-line__label">发出数量</text>
                <input class="report-batch-edit__input" type="number" value="{{item.editQty}}" data-index="{{index}}" bindinput="onDispatchLineQtyInput" />
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{editing && !dispatchUseMatrix && !editDispatchLineItems.length}}" class="plan-form-card">
          <view class="plan-form-cell plan-form-cell--last plan-form-cell--input">
            <text class="plan-form-cell__label">发出数量</text>
            <input class="report-batch-edit__input" type="digit" value="{{editDispatchSingleQty}}" bindinput="onDispatchSingleQtyInput" />
          </view>
        </view>

        <view wx:if="{{!editing && detail.dispatchSection.showLineItems}}" class="plan-form-card">
          <view wx:for="{{detail.dispatchSection.lineItems}}" wx:key="id" class="report-batch-line">
            <view class="report-batch-line__head">
              <text class="report-batch-line__product">{{item.productName}}</text>
              <text wx:if="{{item.showVariantLabel}}" class="report-batch-line__variant">{{item.variantLabel}}</text>
            </view>
            <view class="report-batch-line__grid">
              <view class="report-batch-line__cell">
                <text class="report-batch-line__label">数量</text>
                <text class="report-batch-line__value report-batch-line__value--good">{{item.qtyText}}</text>
              </view>
              <view wx:if="{{item.showUnitPrice}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">单价</text>
                <text class="report-batch-line__value">{{item.unitPriceText}}</text>
              </view>
              <view wx:if="{{item.showAmount}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">金额</text>
                <text class="report-batch-line__value report-batch-line__value--amount">{{item.amountText}}</text>
              </view>
              <view wx:if="{{item.showWeight}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">重量</text>
                <text class="report-batch-line__value">{{item.weightText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{detail.hasReceive}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">收回明细</text>
          <text class="plan-detail-section__sub">{{detail.receiveTotalText}}</text>
        </view>

        <view wx:if="{{!editing && detail.receiveSection.showMatrix && detail.receiveSection.matrixLayout}}" class="plan-form-card">
          <view class="plan-detail-matrix-wrap">
            <scroll-view class="plan-detail-matrix-scroll" scroll-x show-scrollbar="{{false}}">
              <view class="plan-detail-matrix">
                <view class="plan-detail-matrix__head">
                  <view class="plan-detail-matrix__corner">颜色</view>
                  <view wx:for="{{detail.receiveSection.matrixLayout.sizeColumns}}" wx:for-item="col" wx:key="id" class="plan-detail-matrix__size">{{col.header}}</view>
                </view>
                <view wx:for="{{detail.receiveSection.matrixLayout.colorRows}}" wx:for-item="colorRow" wx:key="key" class="plan-detail-matrix__row">
                  <view class="plan-detail-matrix__color">
                    <view wx:if="{{colorRow.colorSwatch}}" class="plan-detail-matrix__swatch" style="background-color: {{colorRow.colorSwatch}};"></view>
                    <text class="plan-detail-matrix__color-text">{{colorRow.colorLabel}}</text>
                  </view>
                  <view wx:for="{{colorRow.cells}}" wx:for-item="cell" wx:key="index" class="plan-detail-matrix__cell">
                    <text wx:if="{{cell.variantId && cell.quantity}}" class="plan-detail-matrix__qty">{{cell.quantity}}</text>
                    <text wx:elif="{{cell.variantId}}" class="plan-detail-matrix__dash">0</text>
                    <text wx:else class="plan-detail-matrix__dash">—</text>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>

        <view wx:if="{{editing && receiveUseMatrix && receiveEditMatrixLayout}}" class="plan-form-card">
          <scroll-view class="plan-create-matrix-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="plan-create-matrix report-matrix">
              <view class="plan-create-matrix__head">
                <view class="plan-create-matrix__corner">颜色</view>
                <view wx:for="{{receiveEditMatrixLayout.sizeColumns}}" wx:key="id" class="plan-create-matrix__size">{{item.header}}</view>
              </view>
              <view wx:for="{{receiveEditMatrixLayout.colorRows}}" wx:for-item="row" wx:key="key" class="plan-create-matrix__row">
                <view class="plan-create-matrix__color">
                  <view wx:if="{{row.colorSwatch}}" class="plan-create-matrix__swatch" style="background-color: {{row.colorSwatch}};" />
                  <text class="plan-create-matrix__color-text">{{row.colorLabel}}</text>
                </view>
                <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="plan-create-matrix__cell report-matrix__cell">
                  <view
                    wx:if="{{cell.variantId}}"
                    class="plan-create-matrix__input {{activeEditSection === 'receive' && activeMatrixVariantId === cell.variantId ? 'plan-create-matrix__input--active' : ''}} {{activeEditSection === 'receive' && activeMatrixVariantId === cell.variantId && matrixInputReplaceAll && cell.quantity ? 'plan-create-matrix__input--replace' : ''}} {{cell.quantity ? 'plan-create-matrix__input--filled' : 'plan-create-matrix__input--empty'}}"
                    data-section="receive"
                    data-variant-id="{{cell.variantId}}"
                    catchtap="onMatrixCellTap"
                  >{{cell.quantity}}</view>
                  <text wx:else class="plan-create-matrix__dash">—</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{editing && !receiveUseMatrix && editReceiveLineItems.length}}" class="plan-form-card">
          <view wx:for="{{editReceiveLineItems}}" wx:key="recordId" class="report-batch-edit-line">
            <view class="report-batch-edit-line__row">
              <view class="report-batch-edit-line__field">
                <text class="report-batch-edit-line__label">收回数量</text>
                <input class="report-batch-edit__input" type="number" value="{{item.editQty}}" data-index="{{index}}" bindinput="onReceiveLineQtyInput" />
              </view>
              <view wx:if="{{canViewAmount}}" class="report-batch-edit-line__field">
                <text class="report-batch-edit-line__label">单价</text>
                <input class="report-batch-edit__input" type="digit" value="{{item.editUnitPrice}}" data-index="{{index}}" bindinput="onReceiveLinePriceInput" />
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{editing && !receiveUseMatrix && !editReceiveLineItems.length}}" class="plan-form-card">
          <view class="plan-form-cell {{canViewAmount ? '' : 'plan-form-cell--last'}} plan-form-cell--input">
            <text class="plan-form-cell__label">收回数量</text>
            <input class="report-batch-edit__input" type="digit" value="{{editReceiveSingleQty}}" bindinput="onReceiveSingleQtyInput" />
          </view>
          <view wx:if="{{canViewAmount}}" class="plan-form-cell plan-form-cell--last plan-form-cell--input">
            <text class="plan-form-cell__label">单价</text>
            <input class="report-batch-edit__input" type="digit" value="{{editReceiveUnitPrice}}" bindinput="onReceiveSinglePriceInput" />
          </view>
        </view>

        <view wx:if="{{!editing && detail.receiveSection.showLineItems}}" class="plan-form-card">
          <view wx:for="{{detail.receiveSection.lineItems}}" wx:key="id" class="report-batch-line">
            <view class="report-batch-line__head">
              <text class="report-batch-line__product">{{item.productName}}</text>
              <text wx:if="{{item.showVariantLabel}}" class="report-batch-line__variant">{{item.variantLabel}}</text>
            </view>
            <view class="report-batch-line__grid">
              <view class="report-batch-line__cell">
                <text class="report-batch-line__label">数量</text>
                <text class="report-batch-line__value report-batch-line__value--good">{{item.qtyText}}</text>
              </view>
              <view wx:if="{{item.showUnitPrice}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">单价</text>
                <text class="report-batch-line__value">{{item.unitPriceText}}</text>
              </view>
              <view wx:if="{{item.showAmount}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">金额</text>
                <text class="report-batch-line__value report-batch-line__value--amount">{{item.amountText}}</text>
              </view>
              <view wx:if="{{item.showWeight}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">重量</text>
                <text class="report-batch-line__value">{{item.weightText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <view wx:if="{{showFooter && !loading && detail && !matrixKeyboardVisible && !pickerSheetOpen}}" class="report-batch-footer">
    <view wx:if="{{editing}}" class="report-batch-footer__inner">
      <view class="report-batch-footer__btn report-batch-footer__btn--ghost" bindtap="onCancelEdit">取消</view>
      <view class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onSaveEdit">{{saving ? '保存中…' : '保存'}}</view>
    </view>
    <view wx:else class="report-batch-footer__inner">
      <view wx:if="{{canDelete}}" class="report-batch-footer__btn report-batch-footer__btn--danger" bindtap="onDeleteTap">删除</view>
      <view wx:if="{{canEdit}}" class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onEnterEdit">编辑</view>
    </view>
  </view>

  <matrix-qty-keyboard
    visible="{{matrixKeyboardVisible}}"
    bind:action="onMatrixKeyboardAction"
  />
</view>
