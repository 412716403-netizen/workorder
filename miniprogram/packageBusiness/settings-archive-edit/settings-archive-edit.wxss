@import '../../packageBusiness/production-plan-create/production-plan-create.wxss';

.plan-form-card--flush-bottom {
  padding-bottom: 0;
  overflow: hidden;
}

.settings-edit-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 20rpx var(--spacing-card);
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.settings-edit-toggle:last-child {
  border-bottom: none;
}

.settings-edit-toggle--blocked {
  opacity: 0.55;
}

.settings-edit-toggle__label {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.report-batch-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.report-batch-footer__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.report-batch-footer__btn--ghost {
  color: #ef4444;
  background: #fef2f2;
}

.report-batch-footer__btn--primary {
  color: #fff;
  background: var(--color-primary);
}

.report-batch-footer__btn--disabled {
  opacity: 0.45;
}
