@import "/styles/plan-list-shell.wxss";

.dev-tpl-page {
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.dev-tpl-hint {
  margin: 8rpx 0 24rpx;
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-tertiary, #8f959e);
  background: #f8fafc;
  border-radius: 12rpx;
}

.dev-tpl-card {
  margin-bottom: 20rpx;
  padding: 8rpx 0 4rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.dev-tpl-card__main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
}

.dev-tpl-card__idx {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary, #2f6bff);
  background: rgba(47, 107, 255, 0.1);
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.dev-tpl-card__body {
  flex: 1;
  min-width: 0;
}

.dev-tpl-card__title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dev-tpl-card__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary, #1f2329);
  word-break: break-all;
}

.dev-tpl-card__chevron {
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 300;
  color: #c9cdd4;
  line-height: 1;
}

.dev-tpl-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8f959e);
}

.dev-tpl-card__fields {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.dev-tpl-card__field-chip {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #646a73);
  background: #f2f3f5;
  border-radius: 999rpx;
}

.dev-tpl-card__field-more {
  padding: 6rpx 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-tertiary, #8f959e);
}

.dev-tpl-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 4rpx 20rpx 16rpx;
  border-top: 1rpx solid #f3f4f6;
  margin-top: 4rpx;
}

.dev-tpl-card__btn {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
  background: rgba(47, 107, 255, 0.06);
  border-radius: 10rpx;
}

.dev-tpl-card__btn--danger {
  color: #d92d20;
  background: rgba(217, 45, 32, 0.06);
}

.dev-tpl-empty {
  padding-top: 48rpx;
}

.dev-tpl-empty__cta {
  margin: 8rpx auto 0;
  width: fit-content;
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary, #2f6bff);
  border-radius: 999rpx;
}
