<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">{{editing ? '领退料 · 编辑' : '领退料详情'}}</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view wx:if="{{loading}}">
      <empty-state loading="{{true}}" text="加载中…" />
    </view>

    <view wx:elif="{{!detail}}" class="plan-detail-muted">未找到记录</view>

    <view wx:else class="plan-detail-page stock-in-detail-page">
      <view class="report-batch-hero">
        <view class="report-batch-hero__left">
          <view class="report-batch-hero__img report-batch-hero__img--placeholder">
            <image
              class="report-batch-hero__placeholder-icon"
              src="{{detail.type === 'STOCK_RETURN' ? '/assets/icons/arrow-down-to-line.png' : '/assets/icons/arrow-up-from-line.png'}}"
              mode="aspectFit"
            />
          </view>
        </view>
        <view class="report-batch-hero__text">
          <view class="report-batch-hero__badges">
            <text class="report-batch-hero__badge report-batch-hero__badge--mono">{{detail.docNo}}</text>
            <text class="material-detail-type {{detail.type === 'STOCK_RETURN' ? 'material-detail-type--return' : ''}}">{{detail.typeLabel}}</text>
          </view>
          <view class="report-batch-hero__milestone">
            <text>{{detail.productName}}</text>
            <text wx:if="{{detail.showProductSku}}" class="stock-in-detail-sku"> · {{detail.productSku}}</text>
          </view>
          <view class="report-batch-hero__meta">
            <text wx:if="{{detail.showOrderNumber}}" class="report-batch-hero__meta-item">{{detail.orderNumber}}</text>
            <text class="report-batch-hero__meta-item">{{detail.timeLabel}}</text>
            <text class="report-batch-hero__meta-item">经办：{{detail.operator}}</text>
          </view>
        </view>
      </view>

      <view class="order-detail-summary">
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">合计数量</text>
          <text class="order-detail-summary__value {{detail.type === 'STOCK_RETURN' ? 'order-detail-summary__value--danger' : 'order-detail-summary__value--success'}}">{{detail.totalQtyText}}</text>
        </view>
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">仓库</text>
          <text class="order-detail-summary__value">{{detail.warehouseName || '—'}}</text>
        </view>
      </view>

      <view wx:if="{{detail.showReason || detail.showPartner}}" class="plan-detail-section">
        <view class="plan-form-card">
          <view wx:if="{{detail.showReason}}" class="material-detail-line">
            <text class="material-detail-line__name">备注</text>
            <text class="material-detail-line__qty">{{detail.reason}}</text>
          </view>
          <view wx:if="{{detail.showPartner}}" class="material-detail-line">
            <text class="material-detail-line__name">加工厂</text>
            <text class="material-detail-line__qty">{{detail.partner}}</text>
          </view>
        </view>
      </view>

      <view class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">物料明细</text>
        </view>
        <view wx:if="{{editing}}" class="plan-form-card">
          <picker mode="selector" range="{{warehouseNames}}" value="{{warehousePickerIndex}}" bindchange="onWarehouseChange">
            <view class="plan-form-cell">
              <text class="plan-form-cell__label">仓库</text>
              <text class="plan-form-cell__value">{{editWarehouseName || '请选择'}}</text>
              <text class="plan-form-cell__chevron">›</text>
            </view>
          </picker>
          <view wx:for="{{editLineItems}}" wx:key="id" class="material-detail-edit-line">
            <text class="material-detail-edit-line__name">{{detail.lineItems[index].name}}</text>
            <input class="material-detail-edit-line__input" type="digit" value="{{item.editQty}}" data-index="{{index}}" bindinput="onLineQtyInput" />
          </view>
        </view>
        <view wx:else class="plan-form-card">
          <view wx:for="{{detail.lineItems}}" wx:key="id" class="material-detail-line">
            <view>
              <text class="material-detail-line__name">{{item.name}}</text>
              <text wx:if="{{item.showSku}}" class="material-detail-line__sku">{{item.sku}}</text>
            </view>
            <text class="material-detail-line__qty {{detail.type === 'STOCK_RETURN' ? 'material-detail-line__qty--return' : ''}}">{{item.quantityText}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showFooter && !loading && detail}}" class="report-batch-footer">
    <view wx:if="{{editing}}" class="report-batch-footer__inner">
      <view class="report-batch-footer__btn report-batch-footer__btn--ghost" bindtap="onCancelEdit">取消</view>
      <view class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onSaveEdit">{{saving ? '保存中…' : '保存'}}</view>
    </view>
    <view wx:else class="report-batch-footer__inner">
      <view wx:if="{{canDelete}}" class="report-batch-footer__btn report-batch-footer__btn--danger" bindtap="onDeleteTap">删除</view>
      <view wx:if="{{canEdit}}" class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onEnterEdit">编辑</view>
    </view>
  </view>
</view>
