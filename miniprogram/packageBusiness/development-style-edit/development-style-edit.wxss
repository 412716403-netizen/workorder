@import "/styles/plan-create-form.wxss";
@import "/styles/category-select-pills.wxss";

.dev-style-edit-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.dev-style-edit__name-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dev-style-edit__refresh-code {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: -8rpx -8rpx -8rpx 0;
  border-radius: 12rpx;
}

.dev-style-edit__refresh-code--hover {
  background: rgba(47, 107, 255, 0.08);
}

.dev-style-edit__refresh-code-icon {
  width: 32rpx;
  height: 32rpx;
}

.dev-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx 8rpx;
}

.dev-section-head__left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.dev-section-head__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary, #1f2329);
}

.dev-section-head__hint,
.dev-section-head__count {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8f959e);
  font-weight: 500;
}

.dev-section-head__desc {
  display: block;
  padding: 0 28rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8f959e);
  line-height: 1.4;
}

.dev-edit-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary, #2f6bff);
  font-weight: 600;
  padding: 8rpx 0;
}

.dev-subsection {
  padding: 8rpx 28rpx 0;
}

.dev-subsection__title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #646a73);
}

.plan-form-cell--image {
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.dev-edit-image {
  width: 168rpx;
  height: 168rpx;
  margin-left: auto;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
}

.dev-edit-image__img {
  width: 100%;
  height: 100%;
}

.dev-edit-image__ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8f959e);
}

.dev-edit-image__ph-plus {
  font-size: 36rpx;
  line-height: 1;
  color: #94a3b8;
}

.dev-empty-tip {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary, #8f959e);
  background: #f8fafc;
  border-radius: 12rpx;
  text-align: center;
}

.dev-chip-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 28rpx 24rpx;
}

.dev-chip {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #646a73);
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
}

.dev-chip--on {
  color: #fff;
  background: var(--color-primary, #2f6bff);
  border-color: var(--color-primary, #2f6bff);
}

.dev-selected-block {
  margin: 0 20rpx 24rpx;
  padding: 8rpx 16rpx 8rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.dev-selected-block__title {
  display: block;
  padding: 12rpx 12rpx 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-tertiary, #8f959e);
}

.dev-order-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.dev-order-row:last-child {
  border-bottom: none;
}

.dev-order-row__idx {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary, #2f6bff);
  background: rgba(47, 107, 255, 0.1);
  border-radius: 10rpx;
  flex-shrink: 0;
}

.dev-order-row__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
}

.dev-order-row__moves {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.dev-order-row__btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid rgba(47, 107, 255, 0.2);
}

.report-batch-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.report-batch-footer__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.report-batch-footer__btn--primary {
  color: #fff;
  background: var(--color-primary, #2f6bff);
}

.report-batch-footer__btn--disabled {
  opacity: 0.55;
}
