@import "/styles/plan-create-form.wxss";

.plan-create-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.dev-bom-style-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f3;
}

.dev-bom-style-card__media {
  flex-shrink: 0;
}

.dev-bom-style-card__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}

.dev-bom-style-card__img--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-bom-style-card__ph-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.45;
}

.dev-bom-style-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dev-bom-style-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-bom-style-card__sku {
  font-size: 22rpx;
  color: #8f959e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-bom-style-card__hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #646a73;
}

.dev-bom-cell {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f3;
}

.dev-bom-cell__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  flex: 1;
  padding-right: 16rpx;
}

.dev-bom-cell__status {
  font-size: 22rpx;
  color: #8f959e;
  background: #f2f3f5;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.dev-bom-cell__status--on {
  color: #039855;
  background: rgba(3, 152, 85, 0.1);
}

.dev-bom-add {
  text-align: center;
  padding: 28rpx;
  color: #2f6bff;
  font-weight: 600;
  font-size: 28rpx;
}

.dev-bom-material-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
}

.dev-bom-material-row__select {
  flex: 1;
  min-width: 0;
}

.dev-bom-remove-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  padding-right: 8rpx;
}

.dev-bom-remove-icon__img {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}

.dev-bom-remove-icon:active .dev-bom-remove-icon__img {
  opacity: 1;
}
