<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">{{pageTitle}}</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view class="plan-detail-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px;">
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:else class="plan-detail-page">
      <view class="dev-section-card">
        <view class="dev-section-card__head">
          <text class="dev-section-card__title">{{styleName}}</text>
          <text class="dev-section-card__hint">{{styleCode}}</text>
        </view>

        <view class="dev-mat-form-row">
          <text class="dev-mat-form-label">单据日期</text>
          <picker mode="date" value="{{entryDate}}" bindchange="onEntryDateChange">
            <view class="dev-mat-form-value">{{entryDate}}</view>
          </picker>
        </view>
        <view class="dev-mat-form-row">
          <text class="dev-mat-form-label">单据时间</text>
          <picker mode="time" value="{{entryTime}}" bindchange="onEntryTimeChange">
            <view class="dev-mat-form-value">{{entryTime}}</view>
          </picker>
        </view>

        <view wx:if="{{isIssue}}" class="dev-mat-form-row">
          <text class="dev-mat-form-label">出库仓库</text>
          <picker mode="selector" range="{{warehouses}}" range-key="name" value="{{warehouseIndex}}" bindchange="onWarehouseChange">
            <view class="dev-mat-form-value">{{warehouses[warehouseIndex].name || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view class="dev-section-card">
        <view class="dev-section-card__head">
          <text class="dev-section-card__title">物料明细</text>
        </view>

        <view wx:if="{{!rows.length}}" class="dev-empty-block">
          <text class="dev-empty-block__text">{{isIssue ? '请先配置试制 BOM' : '暂无可退物料'}}</text>
        </view>

        <!-- 领料：物料 | 单个用量 | 净领用 | 库存 | (批次) | 本次领料 -->
        <scroll-view
          wx:elif="{{isIssue}}"
          scroll-x
          enhanced
          show-scrollbar="{{false}}"
          class="material-issue-table-scroll"
        >
          <view class="material-issue-table {{showBatchCol ? 'material-issue-table--batch' : ''}}">
            <view class="material-issue-table__thead">
              <view class="material-issue-table__th material-issue-table__th--name">物料</view>
              <view class="material-issue-table__th material-issue-table__th--num">单个用量</view>
              <view class="material-issue-table__th material-issue-table__th--num">净领用</view>
              <view class="material-issue-table__th material-issue-table__th--stock">库存数量</view>
              <view wx:if="{{showBatchCol}}" class="material-issue-table__th material-issue-table__th--batch">批次</view>
              <view class="material-issue-table__th material-issue-table__th--input">本次领料</view>
            </view>

            <view wx:for="{{rows}}" wx:key="rowKey" class="material-issue-table__tr">
              <view class="material-issue-table__td material-issue-table__td--name">
                <view class="material-issue-table__name-wrap" style="padding-left: {{item.indentPx}}px;">
                  <view
                    wx:if="{{item.hasChildren}}"
                    class="material-issue-table__expand {{item.expanded ? 'material-issue-table__expand--open' : ''}}"
                    data-row-key="{{item.rowKey}}"
                    catchtap="onToggleExpand"
                  >{{item.expanded ? '▼' : '▶'}}</view>
                  <view wx:else class="material-issue-table__expand material-issue-table__expand--placeholder"></view>
                  <view class="material-issue-table__name-line">
                    <text class="material-issue-table__name">{{item.productName}}</text>
                    <text wx:if="{{item.showProductSku}}" class="material-issue-table__sku">{{item.productSku}}</text>
                  </view>
                </view>
              </view>
              <view class="material-issue-table__td material-issue-table__td--num">{{item.unitQtyText || '—'}}</view>
              <view class="material-issue-table__td material-issue-table__td--num">{{item.netQty}}</view>
              <view class="material-issue-table__td material-issue-table__td--stock">{{item.stockText}}</view>
              <view wx:if="{{showBatchCol}}" class="material-issue-table__td material-issue-table__td--batch">
                <picker
                  wx:if="{{item.needsBatch}}"
                  mode="selector"
                  range="{{item.batchPickerRange}}"
                  value="{{item.batchIndex}}"
                  data-index="{{index}}"
                  bindchange="onBatchChange"
                >
                  <view class="material-issue-batch-picker">
                    {{item.batchDisplayText || item.batchPickerRange[item.batchIndex] || '选择批次'}}
                  </view>
                </picker>
                <view wx:else class="material-issue-batch-picker material-issue-batch-picker--readonly">—</view>
              </view>
              <view class="material-issue-table__td material-issue-table__td--input">
                <input
                  class="material-issue-input"
                  type="digit"
                  placeholder="0"
                  value="{{item.issueQty}}"
                  data-index="{{index}}"
                  bindinput="onQtyInput"
                />
              </view>
            </view>
          </view>
        </scroll-view>

        <!-- 退料：物料 | 仓库 | 批次或库存 | 可退 | 本次退料 -->
        <scroll-view
          wx:else
          scroll-x
          enhanced
          show-scrollbar="{{false}}"
          class="material-issue-table-scroll"
        >
          <view class="material-issue-table material-issue-table--return {{showBatchCol ? 'material-issue-table--batch' : ''}}">
            <view class="material-issue-table__thead">
              <view class="material-issue-table__th material-issue-table__th--name">物料</view>
              <view class="material-issue-table__th material-issue-table__th--wh">仓库</view>
              <view wx:if="{{showBatchCol}}" class="material-issue-table__th material-issue-table__th--batch">批次</view>
              <view wx:else class="material-issue-table__th material-issue-table__th--stock">库存数量</view>
              <view class="material-issue-table__th material-issue-table__th--num">可退</view>
              <view class="material-issue-table__th material-issue-table__th--input">本次退料</view>
            </view>

            <view wx:for="{{rows}}" wx:key="key" class="material-issue-table__tr">
              <view class="material-issue-table__td material-issue-table__td--name">
                <view class="material-issue-table__name-line">
                  <text class="material-issue-table__name">{{item.productName}}</text>
                  <text wx:if="{{item.showProductSku}}" class="material-issue-table__sku">{{item.productSku}}</text>
                </view>
              </view>
              <view class="material-issue-table__td material-issue-table__td--wh">{{item.warehouseName}}</view>
              <view wx:if="{{showBatchCol}}" class="material-issue-table__td material-issue-table__td--batch">
                <text class="material-issue-batch-picker material-issue-batch-picker--readonly">{{item.batchNo}}</text>
              </view>
              <view wx:else class="material-issue-table__td material-issue-table__td--stock">{{item.stockText}}</view>
              <view class="material-issue-table__td material-issue-table__td--num">{{item.returnableQty}}</view>
              <view class="material-issue-table__td material-issue-table__td--input">
                <input
                  class="material-issue-input"
                  type="digit"
                  placeholder="0"
                  value="{{item.returnQty}}"
                  data-index="{{index}}"
                  bindinput="onQtyInput"
                />
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="dev-mat-submit-wrap">
        <button class="dev-mat-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
          {{isIssue ? '确认领料' : '确认退料'}}
        </button>
      </view>
    </view>
  </scroll-view>
</view>
