@import '/packageBusiness/styles/plan-detail-page.wxss';
@import "/styles/list.wxss";
@import "../development-style-detail/development-style-detail.wxss";

.dev-mat-form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.dev-mat-form-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.dev-mat-form-value {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}

/* 对齐工单中心 material-issue-table 横滑表 */
.material-issue-table-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 0 -8rpx;
}

.material-issue-table {
  display: inline-block;
  min-width: 100%;
  background: var(--color-bg-card, #fff);
  border-radius: 16rpx;
  overflow: hidden;
}

/* 各 min-width = 该形态下列宽之和，避免物料名列被压到 min-width */
.material-issue-table__thead,
.material-issue-table__tr {
  display: flex;
  align-items: stretch;
  min-width: 740rpx;
}

.material-issue-table--batch .material-issue-table__thead,
.material-issue-table--batch .material-issue-table__tr {
  min-width: 920rpx;
}

.material-issue-table--return .material-issue-table__thead,
.material-issue-table--return .material-issue-table__tr {
  min-width: 760rpx;
}

.material-issue-table--return.material-issue-table--batch .material-issue-table__thead,
.material-issue-table--return.material-issue-table--batch .material-issue-table__tr {
  min-width: 820rpx;
}

.material-issue-table__thead {
  background: rgba(248, 250, 252, 0.95);
  border-bottom: 1rpx solid var(--color-border, #e2e8f0);
}

.material-issue-table__tr {
  border-bottom: 1rpx solid rgba(241, 245, 249, 0.9);
}

.material-issue-table__tr:last-child {
  border-bottom: none;
}

.material-issue-table__th,
.material-issue-table__td {
  padding: 20rpx 16rpx;
  flex-shrink: 0;
  white-space: normal;
  box-sizing: border-box;
}

.material-issue-table__th {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-secondary, #64748b);
  letter-spacing: 0.04em;
}

.material-issue-table__th--name,
.material-issue-table__td--name {
  width: 240rpx;
  flex: 1 1 240rpx;
  min-width: 200rpx;
}

.material-issue-table__th--num,
.material-issue-table__td--num {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary, #0f172a);
}

.material-issue-table__th--stock,
.material-issue-table__td--stock {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: #059669;
}

.material-issue-table__th--wh,
.material-issue-table__td--wh {
  width: 140rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #64748b);
}

.material-issue-table__th--batch,
.material-issue-table__td--batch {
  width: 180rpx;
}

.material-issue-table__th--input,
.material-issue-table__td--input {
  width: 140rpx;
}

.material-issue-table__name-wrap {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
}

.material-issue-table__expand {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 18rpx;
  color: #94a3b8;
}

.material-issue-table__expand--open {
  color: #4f46e5;
}

.material-issue-table__expand--placeholder {
  visibility: hidden;
}

.material-issue-table__name-line {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.material-issue-table__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary, #0f172a);
  word-break: break-all;
  white-space: normal;
}

.material-issue-table__sku {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-text-tertiary, #94a3b8);
}

.material-issue-batch-picker {
  width: 100%;
  min-height: 72rpx;
  line-height: 1.3;
  padding: 12rpx;
  border: 1rpx solid var(--color-border, #e2e8f0);
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-primary, #0f172a);
  background: #fff;
  box-sizing: border-box;
}

.material-issue-batch-picker--readonly {
  line-height: 72rpx;
  text-align: center;
  color: var(--color-text-secondary, #64748b);
  padding: 0 12rpx;
}

.material-issue-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-border, #e2e8f0);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
  background: #fff;
  box-sizing: border-box;
}

.dev-mat-submit-wrap {
  padding: 32rpx 0 64rpx;
}

.dev-mat-submit {
  background: #4f46e5;
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
