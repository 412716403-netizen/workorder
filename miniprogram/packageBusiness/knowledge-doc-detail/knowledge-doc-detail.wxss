@import '/styles/psi-purchase-order-detail-page.wxss';

.kb-doc-page {
  padding: 0 var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.kb-doc-hero {
  margin-bottom: 16rpx;
  padding: 8rpx 4rpx 16rpx;
}

.kb-doc-hero__title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--color-text-primary);
  word-break: break-word;
}

.kb-doc-hero__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.kb-doc-card {
  padding: 28rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.kb-doc-rich {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
  word-break: break-word;
}

/* 行内高亮（mark → span.kb-hl）；页面内 rich-text 可吃本页 class */
.kb-hl {
  background: #fef08a;
  padding: 1px 3px;
  border-radius: 2px;
}

.kb-doc-callout {
  margin: 8rpx 0 20rpx;
  padding: 20rpx 24rpx;
  background: #f0f9ff;
  border-left: 6rpx solid #38bdf8;
  border-radius: 0 16rpx 16rpx 0;
  color: #0f172a;
  box-sizing: border-box;
}

.kb-doc-callout--cell {
  margin: 4rpx 0 8rpx;
  padding: 12rpx 16rpx;
  white-space: normal;
}

.kb-doc-rich--callout {
  margin-bottom: 8rpx;
}

.kb-doc-image--callout {
  margin: 8rpx 0;
}

.kb-doc-product--callout {
  margin: 8rpx 0;
}

.kb-doc-table-scroll {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.kb-doc-mini-table {
  display: table;
  min-width: 100%;
  width: max-content;
  border-collapse: collapse;
  border: 1rpx solid #cbd5e1;
}

.kb-doc-mini-table__row {
  display: table-row;
}

.kb-doc-mini-table__cell {
  display: table-cell;
  min-width: 144rpx;
  max-width: 520rpx;
  padding: 16rpx;
  border: 1rpx solid #cbd5e1;
  vertical-align: top;
  white-space: normal;
  word-break: break-word;
  background: #fff;
}

.kb-doc-mini-table__cell--header {
  font-weight: 700;
  background: #f8fafc;
}

.kb-doc-rich--cell {
  width: auto;
  min-width: 0;
  margin-bottom: 0;
}

.kb-doc-image {
  display: block;
  max-width: 100%;
  margin: 8rpx 0 20rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.kb-doc-image--cell {
  margin: 4rpx 0 8rpx;
}

.kb-doc-product {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #1d4ed8;
  background: #dbeafe;
  border-radius: 999rpx;
}

.kb-doc-product--cell {
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
}
