@import '/packageBusiness/styles/psi-purchase-order-detail-page.wxss';

.kb-doc-header-bar {
  position: relative;
  padding-right: 16rpx;
}

.kb-doc-header-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  pointer-events: none;
  z-index: 0;
}

.kb-doc-header-bar .plan-detail-header__back {
  position: relative;
  z-index: 1;
}

.kb-doc-page {
  padding: 0 var(--spacing-page) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.kb-doc-hero {
  margin-bottom: 16rpx;
  padding: 8rpx 4rpx 16rpx;
}

.kb-doc-hero__title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--color-text-primary);
  word-break: break-word;
}

.kb-doc-hero__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.kb-doc-card {
  padding: 28rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.kb-doc-rich {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
  word-break: break-word;
}

/* 行内高亮（mark → span.kb-hl）；页面内 rich-text 可吃本页 class */
.kb-hl {
  background: #fef08a;
  padding: 1px 3px;
  border-radius: 2px;
}

.kb-doc-callout {
  margin: 8rpx 0 20rpx;
  padding: 20rpx 24rpx;
  background: #f0f9ff;
  border-left: 6rpx solid #38bdf8;
  border-radius: 0 16rpx 16rpx 0;
  color: #0f172a;
  box-sizing: border-box;
}

.kb-doc-callout--cell {
  margin: 4rpx 0 8rpx;
  padding: 12rpx 16rpx;
  white-space: normal;
}

.kb-doc-rich--callout {
  margin-bottom: 8rpx;
}

.kb-doc-image--callout {
  margin: 8rpx 0;
}

.kb-doc-product--callout {
  margin: 8rpx 0;
}

.kb-doc-table-scroll {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.kb-doc-mini-table {
  display: table;
  min-width: 100%;
  width: max-content;
  border-collapse: collapse;
  border: 1rpx solid #cbd5e1;
}

.kb-doc-mini-table__row {
  display: table-row;
}

.kb-doc-mini-table__cell {
  display: table-cell;
  min-width: 144rpx;
  max-width: 520rpx;
  padding: 16rpx;
  border: 1rpx solid #cbd5e1;
  vertical-align: top;
  white-space: normal;
  word-break: break-word;
  background: #fff;
}

.kb-doc-mini-table__cell--header {
  font-weight: 700;
  background: #f8fafc;
}

.kb-doc-rich--cell {
  width: auto;
  min-width: 0;
  margin-bottom: 0;
}

.kb-doc-image {
  display: block;
  max-width: 100%;
  margin: 8rpx 0 20rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.kb-doc-image--cell {
  margin: 4rpx 0 8rpx;
}

.kb-doc-product {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #1d4ed8;
  background: #dbeafe;
  border-radius: 999rpx;
}

.kb-doc-product--cell {
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
}

.kb-doc-document {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #6d28d9;
  background: #ede9fe;
  border-radius: 999rpx;
}

.kb-doc-document--cell,
.kb-doc-document--callout {
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
}

.kb-doc-file {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 20rpx;
  padding: 20rpx 22rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.kb-doc-file--cell,
.kb-doc-file--callout {
  margin: 8rpx 0;
  padding: 16rpx 18rpx;
}

.kb-doc-file__icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #fff;
  background: #64748b;
}

.kb-doc-file__icon--pdf {
  background: #e11d48;
}

.kb-doc-file__icon--excel {
  background: #059669;
}

.kb-doc-file__icon--image {
  background: #d97706;
}

.kb-doc-file__icon--office {
  background: #2563eb;
}

.kb-doc-file__icon--video {
  background: #0284c7;
}

.kb-doc-video {
  display: block;
  width: 100%;
  max-height: 420rpx;
  margin: 8rpx 0 20rpx;
  background: #0f172a;
  border-radius: 14rpx;
  overflow: hidden;
}

.kb-doc-video--loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
}

.kb-doc-video__loading-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.kb-doc-video.kb-doc-file--cell,
.kb-doc-video.kb-doc-file--callout {
  margin: 8rpx 0;
}

.kb-doc-file__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.kb-doc-file__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-doc-file__size {
  font-size: 22rpx;
  color: #94a3b8;
}

.kb-doc-file__hint {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 600;
}

.kb-doc-outline-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 80;
  min-width: 96rpx;
  height: 80rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, 0.35);
}

.kb-doc-heading {
  display: block;
  width: 100%;
  margin: 12rpx 0 16rpx;
  scroll-margin-top: 16rpx;
}

.kb-doc-heading__text {
  display: block;
  line-height: 1.4;
  color: #0f172a;
  word-break: break-word;
}

.kb-doc-heading--l1 .kb-doc-heading__text {
  font-size: 36rpx;
  font-weight: 800;
}

.kb-doc-heading--l2 .kb-doc-heading__text {
  font-size: 32rpx;
  font-weight: 700;
}

.kb-doc-heading--l3 .kb-doc-heading__text {
  font-size: 30rpx;
  font-weight: 700;
}

.kb-doc-heading--cell,
.kb-doc-heading--callout {
  margin: 4rpx 0 8rpx;
}

.kb-doc-outline-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(15, 23, 42, 0.45);
}

.kb-doc-outline-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.kb-doc-outline-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.kb-doc-outline-sheet__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.kb-doc-outline-sheet__close {
  font-size: 26rpx;
  color: #64748b;
  padding: 8rpx 4rpx;
}

.kb-doc-outline-sheet__nav {
  flex: 1;
  max-height: calc(70vh - 100rpx);
  padding: 8rpx 0 24rpx;
  box-sizing: border-box;
}

.kb-doc-outline-item {
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-doc-outline-item:active {
  background: #f1f5f9;
}

.kb-doc-outline-item--l1 {
  font-weight: 700;
  color: #0f172a;
}

.kb-doc-outline-item--l2 {
  padding-left: 56rpx;
  font-weight: 600;
}

.kb-doc-outline-item--l3 {
  padding-left: 80rpx;
  font-size: 26rpx;
  color: #64748b;
}
