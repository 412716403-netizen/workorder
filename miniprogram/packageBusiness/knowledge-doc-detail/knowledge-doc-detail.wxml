<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar kb-doc-header-bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <view class="kb-doc-header-title">资料库文档</view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <view wx:if="{{loading}}" class="plan-detail-muted">加载中…</view>

    <view wx:elif="{{found}}" class="kb-doc-page">
      <view class="kb-doc-hero">
        <text class="kb-doc-hero__title">{{title}}</text>
        <text wx:if="{{updatedText}}" class="kb-doc-hero__meta">{{updatedText}}</text>
      </view>

      <view class="kb-doc-card">
        <block wx:for="{{blocks}}" wx:for-item="block" wx:key="key">
          <scroll-view
            wx:if="{{block.type === 'table'}}"
            class="kb-doc-table-scroll"
            scroll-x
            enhanced
            show-scrollbar="{{true}}"
          >
            <view class="kb-doc-mini-table">
              <view
                wx:for="{{block.rows}}"
                wx:for-item="row"
                wx:key="key"
                class="kb-doc-mini-table__row"
              >
                <view
                  wx:for="{{row.cells}}"
                  wx:for-item="cell"
                  wx:key="key"
                  class="kb-doc-mini-table__cell {{cell.isHeader ? 'kb-doc-mini-table__cell--header' : ''}}"
                >
                  <block wx:for="{{cell.blocks}}" wx:for-item="cellBlock" wx:key="key">
                    <view
                      wx:if="{{cellBlock.type === 'heading'}}"
                      id="{{cellBlock.anchorId}}"
                      class="kb-doc-heading kb-doc-heading--cell kb-doc-heading--l{{cellBlock.level}} kb-doc-anchor {{cellBlock.anchorClass}}"
                    >
                      <text class="kb-doc-heading__text">{{cellBlock.text}}</text>
                    </view>

                    <rich-text
                      wx:elif="{{cellBlock.type === 'html'}}"
                      class="kb-doc-rich kb-doc-rich--cell"
                      nodes="{{cellBlock.html}}"
                      space="nbsp"
                    ></rich-text>

                    <image
                      wx:elif="{{cellBlock.type === 'image'}}"
                      class="kb-doc-image kb-doc-image--cell"
                      style="{{cellBlock.imageStyle}}"
                      src="{{cellBlock.src}}"
                      mode="widthFix"
                      data-index="{{cellBlock.previewIndex}}"
                      bindtap="onImageTap"
                    />

                    <view
                      wx:elif="{{cellBlock.type === 'product'}}"
                      class="kb-doc-product kb-doc-product--cell"
                      data-id="{{cellBlock.productId}}"
                      bindtap="onProductTap"
                    >{{cellBlock.label}}</view>

                    <view
                      wx:elif="{{cellBlock.type === 'document'}}"
                      class="kb-doc-document kb-doc-document--cell"
                      data-id="{{cellBlock.documentId}}"
                      bindtap="onDocumentTap"
                    >{{cellBlock.label}}</view>

                    <block wx:elif="{{cellBlock.type === 'file'}}">
                      <template is="kbDocFile" data="{{file: cellBlock, extraClass: 'kb-doc-file--cell'}}" />
                    </block>

                    <view
                      wx:elif="{{cellBlock.type === 'callout'}}"
                      class="kb-doc-callout kb-doc-callout--cell"
                    >
                      <block wx:for="{{cellBlock.blocks}}" wx:for-item="cellCalloutBlock" wx:key="key">
                        <view
                          wx:if="{{cellCalloutBlock.type === 'heading'}}"
                          id="{{cellCalloutBlock.anchorId}}"
                          class="kb-doc-heading kb-doc-heading--callout kb-doc-heading--l{{cellCalloutBlock.level}} kb-doc-anchor {{cellCalloutBlock.anchorClass}}"
                        >
                          <text class="kb-doc-heading__text">{{cellCalloutBlock.text}}</text>
                        </view>
                        <rich-text
                          wx:elif="{{cellCalloutBlock.type === 'html'}}"
                          class="kb-doc-rich kb-doc-rich--callout"
                          nodes="{{cellCalloutBlock.html}}"
                          space="nbsp"
                        ></rich-text>
                        <image
                          wx:elif="{{cellCalloutBlock.type === 'image'}}"
                          class="kb-doc-image kb-doc-image--callout"
                          style="{{cellCalloutBlock.imageStyle}}"
                          src="{{cellCalloutBlock.src}}"
                          mode="widthFix"
                          data-index="{{cellCalloutBlock.previewIndex}}"
                          bindtap="onImageTap"
                        />
                        <view
                          wx:elif="{{cellCalloutBlock.type === 'product'}}"
                          class="kb-doc-product kb-doc-product--callout"
                          data-id="{{cellCalloutBlock.productId}}"
                          bindtap="onProductTap"
                        >{{cellCalloutBlock.label}}</view>
                        <view
                          wx:elif="{{cellCalloutBlock.type === 'document'}}"
                          class="kb-doc-document kb-doc-document--callout"
                          data-id="{{cellCalloutBlock.documentId}}"
                          bindtap="onDocumentTap"
                        >{{cellCalloutBlock.label}}</view>
                        <block wx:elif="{{cellCalloutBlock.type === 'file'}}">
                          <template is="kbDocFile" data="{{file: cellCalloutBlock, extraClass: 'kb-doc-file--callout'}}" />
                        </block>
                      </block>
                    </view>
                  </block>
                </view>
              </view>
            </view>
          </scroll-view>

          <view wx:elif="{{block.type === 'callout'}}" class="kb-doc-callout">
            <block wx:for="{{block.blocks}}" wx:for-item="calloutBlock" wx:key="key">
              <view
                wx:if="{{calloutBlock.type === 'heading'}}"
                id="{{calloutBlock.anchorId}}"
                class="kb-doc-heading kb-doc-heading--callout kb-doc-heading--l{{calloutBlock.level}} kb-doc-anchor {{calloutBlock.anchorClass}}"
              >
                <text class="kb-doc-heading__text">{{calloutBlock.text}}</text>
              </view>

              <rich-text
                wx:elif="{{calloutBlock.type === 'html'}}"
                class="kb-doc-rich kb-doc-rich--callout"
                nodes="{{calloutBlock.html}}"
                space="nbsp"
              ></rich-text>

              <image
                wx:elif="{{calloutBlock.type === 'image'}}"
                class="kb-doc-image kb-doc-image--callout"
                style="{{calloutBlock.imageStyle}}"
                src="{{calloutBlock.src}}"
                mode="widthFix"
                data-index="{{calloutBlock.previewIndex}}"
                bindtap="onImageTap"
              />

              <view
                wx:elif="{{calloutBlock.type === 'product'}}"
                class="kb-doc-product kb-doc-product--callout"
                data-id="{{calloutBlock.productId}}"
                bindtap="onProductTap"
              >{{calloutBlock.label}}</view>

              <view
                wx:elif="{{calloutBlock.type === 'document'}}"
                class="kb-doc-document kb-doc-document--callout"
                data-id="{{calloutBlock.documentId}}"
                bindtap="onDocumentTap"
              >{{calloutBlock.label}}</view>

              <block wx:elif="{{calloutBlock.type === 'file'}}">
                <template is="kbDocFile" data="{{file: calloutBlock, extraClass: 'kb-doc-file--callout'}}" />
              </block>
            </block>
          </view>

          <view
            wx:elif="{{block.type === 'heading'}}"
            id="{{block.anchorId}}"
            class="kb-doc-heading kb-doc-heading--l{{block.level}} kb-doc-anchor {{block.anchorClass}}"
          >
            <text class="kb-doc-heading__text">{{block.text}}</text>
          </view>

          <rich-text
            wx:elif="{{block.type === 'html'}}"
            class="kb-doc-rich"
            nodes="{{block.html}}"
            space="nbsp"
          ></rich-text>

          <image
            wx:elif="{{block.type === 'image'}}"
            class="kb-doc-image"
            style="{{block.imageStyle}}"
            src="{{block.src}}"
            mode="widthFix"
            data-index="{{block.previewIndex}}"
            bindtap="onImageTap"
          />

          <view
            wx:elif="{{block.type === 'product'}}"
            class="kb-doc-product"
            data-id="{{block.productId}}"
            bindtap="onProductTap"
          >{{block.label}}</view>

          <view
            wx:elif="{{block.type === 'document'}}"
            class="kb-doc-document"
            data-id="{{block.documentId}}"
            bindtap="onDocumentTap"
          >{{block.label}}</view>

          <block wx:elif="{{block.type === 'file'}}">
            <template is="kbDocFile" data="{{file: block, extraClass: ''}}" />
          </block>
        </block>
      </view>
    </view>

    <view wx:else class="plan-detail-muted">{{emptyText}}</view>
  </scroll-view>

  <view
    wx:if="{{found && outline.length > 0 && !outlineOpen}}"
    class="kb-doc-outline-fab"
    bindtap="onToggleOutline"
  >目录</view>

  <view wx:if="{{outlineOpen}}" class="kb-doc-outline-mask" bindtap="onCloseOutline"></view>
  <view wx:if="{{outlineOpen}}" class="kb-doc-outline-sheet" catchtap="">
    <view class="kb-doc-outline-sheet__head">
      <text class="kb-doc-outline-sheet__title">目录</text>
      <view class="kb-doc-outline-sheet__close" bindtap="onCloseOutline">关闭</view>
    </view>
    <scroll-view class="kb-doc-outline-sheet__nav" scroll-y show-scrollbar="{{false}}">
      <view
        wx:for="{{outline}}"
        wx:key="id"
        class="kb-doc-outline-item kb-doc-outline-item--l{{item.level}}"
        data-id="{{item.elementId}}"
        bindtap="onOutlineJump"
      >{{item.text}}</view>
    </scroll-view>
  </view>
</view>

<template name="kbDocFile">
  <video
    wx:if="{{file.kind === 'video' && file.displayMode === 'player' && file.localSrc}}"
    class="kb-doc-video {{extraClass}}"
    src="{{file.localSrc}}"
    controls
    show-center-play-btn
    enable-progress-gesture
    object-fit="contain"
  ></video>
  <view
    wx:elif="{{file.kind === 'video' && file.displayMode === 'player'}}"
    class="kb-doc-video kb-doc-video--loading {{extraClass}}"
  >
    <text class="kb-doc-video__loading-text">视频加载中…</text>
  </view>
  <view
    wx:else
    class="kb-doc-file {{extraClass}}"
    data-asset-id="{{file.assetId}}"
    data-file-name="{{file.fileName}}"
    data-mime-type="{{file.mimeType}}"
    data-kind="{{file.kind}}"
    bindtap="onFileTap"
  >
    <view class="kb-doc-file__icon kb-doc-file__icon--{{file.kind}}">{{file.kindLabel}}</view>
    <view class="kb-doc-file__meta">
      <text class="kb-doc-file__name">{{file.fileName}}</text>
      <text class="kb-doc-file__size">{{file.sizeText}}</text>
    </view>
    <text class="kb-doc-file__hint">{{file.kind === 'video' ? '播放' : '打开'}}</text>
  </view>
</template>
