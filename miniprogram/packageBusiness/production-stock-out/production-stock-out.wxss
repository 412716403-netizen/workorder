@import '/styles/production-orders-page.wxss';

.material-filter-panel {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.material-filter-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.material-filter-chips {
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
}

.material-filter-flow {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(47, 107, 255, 0.18);
}

.material-filter-flow--press {
  opacity: 0.88;
}

.material-filter-flow__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.material-filter-flow__label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.2;
}

.material-stock-page {
  padding: 0 0 calc(32rpx + env(safe-area-inset-bottom));
}

.material-stock-card--flat-material {
  margin: 0 var(--spacing-page) 24rpx;
}

.material-stock-card__head--summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.material-partner-group {
  margin: 0 var(--spacing-page) 24rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
  border: 1rpx solid var(--color-border-light);
}

.material-partner-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.material-partner-group__head-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.material-partner-view-tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.material-partner-view-tab {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  border-radius: 8rpx;
  transition: all 0.15s ease;
}

.material-partner-view-tab--active {
  color: #4338ca;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.material-stock-card--material-only {
  border-bottom: none;
}

.material-partner-group__head--internal {
  background: #f8fafc;
}

.material-partner-group__head--partner {
  background: linear-gradient(90deg, rgba(99, 102, 241, 0.08) 0%, #fff 100%);
}

.material-partner-group__label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.material-partner-group__head--partner .material-partner-group__label {
  color: #4338ca;
}

.material-partner-group__count {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.material-stock-card--nested {
  margin: 0;
  border-radius: 0;
  box-shadow: none;
  border-bottom: 1rpx solid var(--color-border-light);
}

.material-stock-card--nested:last-child {
  border-bottom: none;
}

.material-stock-card {
  margin: 0 var(--spacing-page) 20rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.material-stock-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.material-stock-card__head-main {
  flex: 1;
  min-width: 0;
}

.material-stock-card__head-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.material-stock-card__product-line {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 12rpx;
}

.material-stock-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.material-stock-card__sku {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.material-stock-select-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.material-stock-card__order {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.material-stock-action {
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-primary);
  background: #fff;
  white-space: nowrap;
}

.material-stock-action--primary {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.material-stock-action--danger {
  color: #ff4d4f;
  border-color: #ffd6d6;
}

.material-stock-action--muted {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
}

.mat-table {
  width: 100%;
}

.mat-table__thead,
.mat-table__tr {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--color-border-light);
}

.mat-table__thead {
  background: #f7f8fa;
}

.mat-table__tr:last-child {
  border-bottom: none;
}

.mat-table__tr--selecting:active {
  background: #f0f5ff;
}

.mat-table__th,
.mat-table__td {
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  box-sizing: border-box;
  min-width: 0;
}

.mat-table__th {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-align: center;
  white-space: normal;
  line-height: 1.25;
  word-break: break-all;
}

.mat-table__th--check,
.mat-table__td--check {
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 12rpx;
  padding-right: 0;
}

.mat-table__th--name,
.mat-table__td--name {
  flex: 1.4;
  min-width: 0;
  text-align: left;
  padding-left: 12rpx;
}

.mat-table__th--name {
  text-align: left;
}

.mat-table__th--num,
.mat-table__td--num {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.mat-table__td--num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.mat-table__th--surplus,
.mat-table__td--surplus {
  color: var(--color-primary);
  padding-right: 12rpx;
}

.mat-table__name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: normal;
  word-break: break-all;
}

.mat-table__sku {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  white-space: normal;
  word-break: break-all;
}

.material-stock-load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
