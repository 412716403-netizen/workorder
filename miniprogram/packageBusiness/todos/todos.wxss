@import "/styles/plan-list-shell.wxss";
@import "/styles/tokens.wxss";

.todos-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 8rpx 32rpx 16rpx;
}

.todos-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #64748b;
  border-radius: 12rpx;
}

.todos-tab--active {
  background: #fff;
  color: var(--color-primary);
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.06);
}

.todos-page {
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.todos-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.todos-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.todos-card--done {
  background: #fafbfc;
}

.todos-card--pressed {
  opacity: 0.92;
  background: #f5f7fb;
}

.todos-check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 12rpx;
  border: 2rpx solid #c9cdd4;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.todos-check--done {
  border-color: var(--color-success);
  background: var(--color-success);
}

.todos-check__mark {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.todos-card__main {
  flex: 1;
  min-width: 0;
}

.todos-card__note {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  word-break: break-word;
  white-space: pre-wrap;
}

.todos-card__note--done {
  color: var(--color-text-secondary);
  text-decoration: line-through;
  font-weight: 500;
}

.todos-card__doc-row {
  margin-top: 14rpx;
}

.todos-doc {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  box-sizing: border-box;
}

.todos-doc--link {
  background: var(--color-primary-light);
}

.todos-doc__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 700;
  color: #646a73;
}

.todos-doc--link .todos-doc__text {
  color: var(--color-primary);
}

.todos-doc__chevron {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-primary);
  line-height: 1;
}

.todos-card__remind-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.todos-remind__icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.todos-remind__text {
  font-size: 22rpx;
  font-weight: 600;
  color: #f43f5e;
}

.todos-card__chevron {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 36rpx;
  font-weight: 300;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.todos-footer {
  padding: 8rpx 0 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.todos-hint {
  padding-bottom: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
