<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">待办事项</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <image class="plan-search__icon" src="/assets/icons/search.png" mode="aspectFit" />
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="搜索待办内容或关联单据"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view wx:if="{{!hideCreate}}" class="plan-tool-btn" bindtap="onCreateTap">
        <image class="plan-tool-btn__icon" src="/assets/icons/file-plus.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <view class="todos-tabs">
    <view
      class="todos-tab {{tab === 'open' ? 'todos-tab--active' : ''}}"
      data-tab="open"
      bindtap="onTabTap"
    >未完成</view>
    <view
      class="todos-tab {{tab === 'done' ? 'todos-tab--active' : ''}}"
      data-tab="done"
      bindtap="onTabTap"
    >已完成</view>
  </view>

  <view class="todos-page">
    <empty-state wx:if="{{loading && !rows.length}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{rows.length}}" class="todos-list">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="todos-card {{item.done ? 'todos-card--done' : ''}}"
        data-id="{{item.id}}"
        hover-class="todos-card--pressed"
        bindtap="onCardTap"
      >
        <view
          class="todos-check {{item.done ? 'todos-check--done' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleTap"
        >
          <text wx:if="{{item.done}}" class="todos-check__mark">✓</text>
        </view>

        <view class="todos-card__main">
          <text class="todos-card__note {{item.done ? 'todos-card__note--done' : ''}}">{{item.note}}</text>

          <view wx:if="{{item.showDoc}}" class="todos-card__doc-row">
            <view
              class="todos-doc {{item.canJump ? 'todos-doc--link' : ''}}"
              data-id="{{item.id}}"
              catchtap="onDocTap"
            >
              <text class="todos-doc__text">{{item.docLabel}}</text>
              <text wx:if="{{item.canJump}}" class="todos-doc__chevron">›</text>
            </view>
          </view>

          <view wx:if="{{item.showRemind}}" class="todos-card__remind-row">
            <image class="todos-remind__icon" src="/assets/icons/clock.png" mode="aspectFit" />
            <text class="todos-remind__text">{{item.remindText}}</text>
          </view>
        </view>

        <text class="todos-card__chevron">›</text>
      </view>

      <view class="todos-footer">共 {{rows.length}} 条</view>
      <view wx:if="{{tab === 'done'}}" class="todos-hint">点左侧勾选可还原为未完成</view>
    </view>

    <empty-state wx:else text="{{emptyText}}" />
  </view>
</view>
