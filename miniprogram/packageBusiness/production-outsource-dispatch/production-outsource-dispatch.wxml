<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">待发清单</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>
    <view class="plan-header__tools">
      <view class="plan-search">
        <input class="plan-search__input" value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="工单 / 产品 / 工序" placeholder-class="plan-search__ph" />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view
        class="plan-tool-btn {{filterActive ? 'plan-tool-btn--active' : ''}}"
        bindtap="onFilterTap"
      >
        <image class="plan-tool-btn__icon" src="/assets/icons/list-filter.png" mode="aspectFit" />
      </view>
    </view>
  </view>
  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <view class="outsource-pick-body">
    <view wx:if="{{showFilterPanel}}" class="plan-filter-panel">
      <view class="plan-filter-panel__row">
        <text class="plan-filter-panel__label">工序</text>
        <picker
          mode="selector"
          range="{{milestoneOptions}}"
          range-key="name"
          value="{{draftMilestoneFilterIndex}}"
          bindchange="onDraftMilestoneChange"
        >
          <view class="plan-filter-chip plan-filter-chip--active">{{draftMilestoneFilterLabel}}</view>
        </picker>
      </view>
      <view class="plan-filter-panel__foot">
        <view class="plan-filter-reset" bindtap="onFilterReset">重置</view>
        <view class="plan-filter-apply" bindtap="onFilterApply">确定</view>
      </view>
    </view>
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />
    <view wx:elif="{{rows.length}}" class="plan-list-wrap outsource-pick-wrap">
      <view
        wx:for="{{rows}}"
        wx:key="rowKey"
        class="outsource-pick-row"
        bindtap="onRowTap"
        data-key="{{item.rowKey}}"
      >
        <view class="outsource-pick-row__check {{item.selected ? 'outsource-pick-row__check--on' : ''}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
        <view class="outsource-pick-row__thumb">
          <image
            wx:if="{{item.showProductImage}}"
            class="outsource-pick-row__img"
            src="{{item.productImageUrl}}"
            mode="aspectFill"
            data-key="{{item.rowKey}}"
            binderror="onProductImageError"
          />
          <view wx:else class="outsource-pick-row__img outsource-pick-row__img--placeholder">
            <image class="outsource-pick-row__placeholder-icon" src="{{item.placeholderIconSrc}}" mode="aspectFit" />
          </view>
        </view>
        <view class="outsource-pick-row__body">
          <text class="outsource-pick-row__subtitle">{{item.subtitleLine}}</text>
          <view class="outsource-pick-row__highlight">
            <text class="outsource-pick-row__milestone">{{item.milestoneName}}</text>
            <view class="outsource-pick-row__qty-wrap">
              <text class="outsource-pick-row__qty-label">可外协</text>
              <text class="outsource-pick-row__qty">{{item.availableQtyText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="plan-list-empty">{{emptyText}}</view>
  </view>

  <view class="outsource-pick-footer">
    <view class="outsource-pick-footer__btn {{selectedCount ? '' : 'outsource-pick-footer__btn--disabled'}}" bindtap="onConfirmTap">外协发出 ({{selectedCount}})</view>
  </view>
</view>
