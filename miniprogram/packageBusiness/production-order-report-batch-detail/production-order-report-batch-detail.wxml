<view class="plan-detail-shell">
  <view class="plan-detail-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-detail-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-detail-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-detail-header__title">{{editing ? '报工 · 编辑' : (reviewMode ? '报工审核' : '报工详情')}}</text>
      <view class="plan-detail-header__back plan-detail-header__back--placeholder"></view>
    </view>
  </view>

  <view class="plan-detail-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    class="plan-detail-scroll"
    scroll-y
    scroll-top="{{matrixScrollTop}}"
    scroll-with-animation
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px;"
  >
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{!detail}}" class="plan-detail-muted">未找到报工记录</view>

    <view wx:else class="plan-detail-page {{matrixKeyboardVisible ? 'matrix-keyboard-page--open' : ''}}">
      <view class="report-batch-hero">
        <view class="report-batch-hero__left">
          <image
            wx:if="{{detail.showProductImage}}"
            class="report-batch-hero__img"
            src="{{detail.productImageUrl}}"
            mode="aspectFill"
            binderror="onProductImageError"
          />
          <view wx:else class="report-batch-hero__img report-batch-hero__img--placeholder">
            <image class="report-batch-hero__placeholder-icon" src="{{detail.placeholderIconSrc}}" mode="aspectFit" />
          </view>
        </view>
        <view class="report-batch-hero__text">
          <view class="report-batch-hero__badges">
            <text wx:if="{{detail.showOrderNumber}}" class="report-batch-hero__badge">{{detail.orderNumber}}</text>
            <text wx:if="{{detail.showReportNo}}" class="report-batch-hero__badge report-batch-hero__badge--mono">{{detail.reportNo}}</text>
          </view>
          <text class="report-batch-hero__milestone">工序：{{detail.milestoneName}}</text>
          <view class="report-batch-hero__meta">
            <text class="report-batch-hero__meta-item">添加 {{detail.timeLabel}}</text>
            <text class="report-batch-hero__meta-item">经办：{{detail.operator}}</text>
          </view>
          <view wx:if="{{detail.showCustomEntries}}" class="report-batch-hero__custom">
            <text wx:for="{{detail.customEntries}}" wx:key="label" class="report-batch-hero__custom-item">{{item.label}}：{{item.display}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!editing}}" class="order-detail-summary">
        <view class="order-detail-summary__item">
          <text class="order-detail-summary__label">本次报工</text>
          <text class="order-detail-summary__value">{{detail.totalGoodText}}</text>
        </view>
        <view wx:if="{{detail.showDefectiveTotal}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">不良品</text>
          <text class="order-detail-summary__value order-detail-summary__value--warn">{{detail.totalDefectiveText}}</text>
        </view>
        <view wx:if="{{detail.showUnitPrice}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">单价</text>
          <text class="order-detail-summary__value">{{detail.unitPriceText}}</text>
        </view>
        <view wx:if="{{detail.showAmount}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">本批金额</text>
          <text class="order-detail-summary__value order-detail-summary__value--success">{{detail.totalAmountText}}</text>
        </view>
        <view wx:if="{{detail.showWeight}}" class="order-detail-summary__item">
          <text class="order-detail-summary__label">本批重量</text>
          <text class="order-detail-summary__value">{{detail.totalWeightText}}</text>
        </view>
      </view>

      <view wx:if="{{!editing}}" class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">报工明细</text>
        </view>
        <view wx:if="{{detail.showMatrix && detail.matrixLayout}}" class="plan-form-card">
          <view class="plan-detail-matrix-wrap">
            <scroll-view class="plan-detail-matrix-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="plan-detail-matrix">
                <view class="plan-detail-matrix__head">
                  <view class="plan-detail-matrix__corner">颜色</view>
                  <view wx:for="{{detail.matrixLayout.sizeColumns}}" wx:for-item="col" wx:key="id" class="plan-detail-matrix__size">{{col.header}}</view>
                </view>
                <view wx:for="{{detail.matrixLayout.colorRows}}" wx:for-item="colorRow" wx:key="key" class="plan-detail-matrix__row">
                  <view class="plan-detail-matrix__color">
                    <view wx:if="{{colorRow.colorSwatch}}" class="plan-detail-matrix__swatch" style="background-color: {{colorRow.colorSwatch}};"></view>
                    <text class="plan-detail-matrix__color-text">{{colorRow.colorLabel}}</text>
                  </view>
                  <view wx:for="{{colorRow.cells}}" wx:for-item="cell" wx:key="index" class="plan-detail-matrix__cell">
                    <text wx:if="{{cell.variantId && cell.quantity}}" class="plan-detail-matrix__qty">{{cell.quantity}}</text>
                    <text wx:elif="{{cell.variantId}}" class="plan-detail-matrix__dash">0</text>
                    <text wx:else class="plan-detail-matrix__dash">—</text>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>
        <view wx:if="{{!detail.showMatrix}}" class="plan-form-card">
          <view wx:for="{{detail.lineItems}}" wx:key="reportId" class="report-batch-line">
            <view class="report-batch-line__head">
              <text class="report-batch-line__product">{{item.productName}}<text wx:if="{{item.showProductSku}}" class="list-product-sku"> {{item.productSku}}</text></text>
              <text wx:if="{{item.showVariantLabel}}" class="report-batch-line__variant">{{item.variantLabel}}</text>
            </view>
            <view class="report-batch-line__grid">
              <view class="report-batch-line__cell">
                <text class="report-batch-line__label">数量</text>
                <text class="report-batch-line__value report-batch-line__value--good">{{item.goodQtyText}}</text>
                <text wx:if="{{item.showDefective}}" class="report-batch-line__sub">{{item.defectiveText}}</text>
              </view>
              <view class="report-batch-line__cell">
                <text class="report-batch-line__label">工价</text>
                <text class="report-batch-line__value">{{item.rateText}}</text>
              </view>
              <view class="report-batch-line__cell">
                <text class="report-batch-line__label">金额</text>
                <text class="report-batch-line__value report-batch-line__value--amount">{{item.amountText}}</text>
              </view>
              <view wx:if="{{item.showWeight}}" class="report-batch-line__cell">
                <text class="report-batch-line__label">重量</text>
                <text class="report-batch-line__value">{{item.weightText}} kg</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="plan-detail-section">
        <view class="plan-detail-section__head">
          <text class="plan-detail-section__title">编辑报工</text>
        </view>
        <view class="plan-form-card">
          <view class="plan-form-cell">
            <text class="plan-form-cell__label">报工时间</text>
            <view class="report-batch-edit__datetime">
              <picker mode="date" value="{{detail.editDate}}" bindchange="onEditDateChange">
                <view class="report-batch-edit__picker">{{detail.editDate}}</view>
              </picker>
              <picker mode="time" value="{{detail.editTime}}" bindchange="onEditTimeChange">
                <view class="report-batch-edit__picker">{{detail.editTime}}</view>
              </picker>
            </view>
          </view>
          <view class="plan-form-cell {{detail.showUnitPrice ? '' : 'plan-form-cell--last'}}">
            <text class="plan-form-cell__label">经办人</text>
            <input class="report-batch-edit__input" value="{{detail.editOperator}}" bindinput="onEditOperatorInput" placeholder="经办人" />
          </view>
          <view wx:if="{{detail.showUnitPrice}}" class="plan-form-cell plan-form-cell--input plan-form-cell--last">
            <text class="plan-form-cell__label">单价</text>
            <input class="report-batch-edit__input" type="digit" value="{{detail.editRate}}" bindinput="onEditRateInput" placeholder="元/{{detail.unitName}}" />
          </view>
        </view>

        <view wx:if="{{detail.showMatrix && editMatrixLayout}}" class="plan-form-card">
          <view class="plan-form-cell plan-form-cell--matrix-head report-qty-head">
            <text class="plan-form-cell__label">报工数量</text>
            <view class="report-qty-toggle">
              <view
                class="report-qty-toggle__item {{qtyInputMode === 'good' ? 'report-qty-toggle__item--active' : ''}}"
                data-mode="good"
                bindtap="onQtyModeTap"
              >良品</view>
              <view
                class="report-qty-toggle__item {{qtyInputMode === 'defective' ? 'report-qty-toggle__item--active' : ''}}"
                data-mode="defective"
                bindtap="onQtyModeTap"
              >不良品</view>
            </view>
          </view>
          <scroll-view class="plan-create-matrix-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="plan-create-matrix report-matrix">
              <view class="plan-create-matrix__head">
                <view class="plan-create-matrix__corner">颜色</view>
                <view wx:for="{{editMatrixLayout.sizeColumns}}" wx:key="id" class="plan-create-matrix__size">{{item.header}}</view>
              </view>
              <view wx:for="{{editMatrixLayout.colorRows}}" wx:for-item="row" wx:key="key" class="plan-create-matrix__row">
                <view class="plan-create-matrix__color">
                  <view wx:if="{{row.colorSwatch}}" class="plan-create-matrix__swatch" style="background-color: {{row.colorSwatch}};" />
                  <text class="plan-create-matrix__color-text">{{row.colorLabel}}</text>
                </view>
                <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="plan-create-matrix__cell report-matrix__cell">
                  <view
                    wx:if="{{cell.variantId}}"
                    class="plan-create-matrix__input {{activeMatrixVariantId === cell.variantId ? 'plan-create-matrix__input--active' : ''}} {{activeMatrixVariantId === cell.variantId && matrixInputReplaceAll && (qtyInputMode === 'good' ? cell.quantity : cell.defectiveQty) ? 'plan-create-matrix__input--replace' : ''}} {{(qtyInputMode === 'good' ? cell.quantity : cell.defectiveQty) ? 'plan-create-matrix__input--filled' : 'plan-create-matrix__input--empty'}}"
                    data-variant-id="{{cell.variantId}}"
                    bindtap="onMatrixCellTap"
                  >{{qtyInputMode === 'good' ? cell.quantity : cell.defectiveQty}}</view>
                  <text wx:else class="plan-create-matrix__dash">—</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view wx:elif="{{!detail.showMatrix}}" class="plan-form-card">
          <view wx:for="{{detail.lineItems}}" wx:key="reportId" class="report-batch-edit-line">
            <text class="report-batch-edit-line__title">{{item.productName}}<text wx:if="{{item.showVariantLabel}}"> · {{item.variantLabel}}</text></text>
            <view class="report-batch-edit-line__row">
              <view class="report-batch-edit-line__field">
                <text class="report-batch-edit-line__label">良品</text>
                <input class="report-batch-edit__input" type="number" value="{{item.editGoodQty}}" data-index="{{index}}" bindinput="onLineGoodInput" />
              </view>
              <view class="report-batch-edit-line__field">
                <text class="report-batch-edit-line__label">不良</text>
                <input class="report-batch-edit__input" type="number" value="{{item.editDefectiveQty}}" data-index="{{index}}" bindinput="onLineDefectiveInput" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showFooter && !loading && detail && !detail.isOutsourceReceive && !matrixKeyboardVisible}}" class="report-batch-footer">
    <view wx:if="{{reviewMode && !editing}}" class="report-batch-footer__inner">
      <view
        class="report-batch-footer__btn report-batch-footer__btn--danger {{reviewActing ? 'report-batch-footer__btn--disabled' : ''}}"
        bindtap="onReviewReject"
      >驳回</view>
      <view
        class="report-batch-footer__btn report-batch-footer__btn--primary {{reviewActing ? 'report-batch-footer__btn--disabled' : ''}}"
        bindtap="onReviewApprove"
      >通过</view>
    </view>
    <view wx:elif="{{editing}}" class="report-batch-footer__inner">
      <view class="report-batch-footer__btn report-batch-footer__btn--ghost" bindtap="onCancelEdit">取消</view>
      <view class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onSaveEdit">保存</view>
    </view>
    <view wx:else class="report-batch-footer__inner">
      <view wx:if="{{canDelete}}" class="report-batch-footer__btn report-batch-footer__btn--danger" bindtap="onDeleteTap">删除</view>
      <view wx:if="{{canEdit}}" class="report-batch-footer__btn report-batch-footer__btn--primary" bindtap="onEnterEdit">编辑</view>
    </view>
  </view>

  <matrix-qty-keyboard
    visible="{{matrixKeyboardVisible}}"
    bind:action="onMatrixKeyboardAction"
  />
</view>
