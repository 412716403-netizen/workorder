<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">入库流水</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="单号 / 工单 / 产品"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view
        class="plan-tool-btn {{filterActive ? 'plan-tool-btn--active' : ''}}"
        bindtap="onFilterTap"
      >
        <image class="plan-tool-btn__icon" src="/assets/icons/list-filter.png" mode="aspectFit" />
      </view>
    </view>
  
    <view wx:if="{{showFilterPanel}}" class="plan-filter-panel stock-in-flow-filter-panel plan-filter-panel--header-dropdown">
    <view class="plan-filter-panel__row">
      <text class="plan-filter-panel__label">开始日期</text>
      <picker mode="date" value="{{draftDateFrom}}" bindchange="onDraftDateFromChange">
        <view class="stock-in-flow-filter stock-in-flow-filter--picker">{{draftDateFrom || '请选择'}}</view>
      </picker>
    </view>
    <view class="plan-filter-panel__row">
      <text class="plan-filter-panel__label">结束日期</text>
      <picker mode="date" value="{{draftDateTo}}" bindchange="onDraftDateToChange">
        <view class="stock-in-flow-filter stock-in-flow-filter--picker">{{draftDateTo || '请选择'}}</view>
      </picker>
    </view>
    <view class="plan-filter-panel__row">
      <text class="plan-filter-panel__label">入库仓库</text>
      <picker
        mode="selector"
        range="{{warehouseFilterLabels}}"
        value="{{draftWarehouseIndex}}"
        bindchange="onDraftWarehouseFilterChange"
      >
        <view class="stock-in-flow-filter stock-in-flow-filter--picker">
          {{warehouseFilterLabels[draftWarehouseIndex] || '全部仓库'}}
        </view>
      </picker>
    </view>
    <view class="plan-filter-panel__foot">
      <view class="plan-filter-reset" bindtap="onFilterReset">重置</view>
      <view class="plan-filter-apply" bindtap="onFilterApply">确定</view>
    </view>
  </view></view>
    

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  

  <view class="report-history-page">
    <empty-state wx:if="{{loading}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{rows.length}}">
      <view
        wx:for="{{rows}}"
        wx:key="batchKey"
        class="report-history-row"
        bindtap="onRowTap"
        data-batch-key="{{item.batchKey}}"
      >
        <view class="report-history-row__body">
          <view class="report-history-row__left">
            <view class="report-history-row__thumb">
              <image
                wx:if="{{item.showProductImage}}"
                class="report-history-row__img"
                src="{{item.productImageUrl}}"
                mode="aspectFill"
                data-id="{{item.id}}"
                binderror="onProductImageError"
              />
              <view wx:else class="report-history-row__img report-history-row__img--placeholder">
                <image class="report-history-row__placeholder-icon" src="{{item.placeholderIconSrc}}" mode="aspectFit" />
              </view>
            </view>
          </view>
          <view class="report-history-row__content">
            <view class="report-history-row__head">
              <view class="report-history-row__head-main">
                <text wx:if="{{item.showOrderNumber && item.orderNumber}}" class="report-history-row__order-no">{{item.orderNumber}}</text>
                <text wx:if="{{item.showOrderNumber && item.orderNumber}}" class="report-history-row__head-dot">·</text>
                <text class="report-history-row__doc-no">{{item.docNo}}</text>
                <text class="report-history-row__head-dot">·</text>
                <text class="report-history-row__time">{{item.timeLabel}}</text>
              </view>
              <view class="report-history-row__head-right">
                <text class="report-history-row__qty">{{item.totalQtyText}}</text>
                <text wx:if="{{item.showOperator}}" class="report-history-row__operator">{{item.operatorLine}}</text>
                <text wx:if="{{item.showWarehouse}}" class="report-history-row__warehouse">{{item.warehouseName}}</text>
              </view>
            </view>
            <view class="report-history-row__product">
              <view class="report-history-row__product-left">
                <text class="report-history-row__product-name">{{item.productName}}</text>
                <text wx:if="{{item.showProductSku}}" class="report-history-row__sku">{{item.productSku}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="plan-list-empty">暂无入库记录</view>
  </view>

  <view wx:if="{{rows.length}}" class="report-history-footer">
    <text class="report-history-footer__text">{{stats.batchCount}} 笔 · 合计 {{stats.totalQty}} 件</text>
  </view>
</view>
