<view class="plan-shell">
  <view class="plan-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-header__title">公共数据字典</text>
      <view class="plan-header__back plan-header__back--placeholder"></view>
    </view>

    <view class="plan-header__tools">
      <view class="plan-search">
        <input
          class="plan-search__input"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          placeholder="搜索名称…"
          confirm-type="search"
          placeholder-class="plan-search__ph"
        />
        <view wx:if="{{searchKeyword}}" class="plan-search__clear" bindtap="onSearchClear">×</view>
      </view>
      <view
        wx:if="{{canCreate}}"
        class="plan-tool-btn"
        bindtap="onCreateTap"
      >
        <image class="plan-tool-btn__icon" src="/assets/icons/file-plus.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="plan-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view
    wx:if="{{kindTabs.length}}"
    class="basic-products-cats"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{kindTabs}}"
      wx:key="id"
      class="basic-products-cat {{item.active ? 'basic-products-cat--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onKindTap"
    >{{item.label}} ({{item.count}})</view>
  </scroll-view>

  <view wx:if="{{searchHint}}" class="basic-products-hint">{{searchHint}}</view>

  <view class="basic-products-page">
    <empty-state wx:if="{{loading && !rows.length}}" loading="{{true}}" text="加载中…" />

    <view wx:elif="{{rows.length}}">
      <view
        wx:for="{{rows}}"
        wx:key="id"
        class="basic-products-row basic-dictionaries-row"
        data-id="{{item.id}}"
        bindtap="onRowTap"
      >
        <view class="basic-products-row__body">
          <view class="basic-products-row__left">
            <view class="basic-dictionaries-row__icon-wrap">
              <image
                class="basic-dictionaries-row__icon"
                src="/assets/icons/library.png"
                mode="aspectFit"
              />
            </view>
          </view>

          <view class="basic-products-row__content">
            <view class="basic-dictionaries-row__head">
              <view class="basic-dictionaries-row__title-wrap">
                <text class="basic-dictionaries-row__name">{{item.name}}</text>
              </view>
              <text class="basic-dictionaries-row__kind-pill">{{item.kindLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{totalPages > 1}}" class="basic-products-pager">
        <view
          class="basic-products-pager__btn {{page <= 1 ? 'basic-products-pager__btn--disabled' : ''}}"
          bindtap="onPrevPage"
        >上一页</view>
        <text class="basic-products-pager__info">{{page}} / {{totalPages}} · 共 {{filteredTotal}} 条</text>
        <view
          class="basic-products-pager__btn {{page >= totalPages ? 'basic-products-pager__btn--disabled' : ''}}"
          bindtap="onNextPage"
        >下一页</view>
      </view>
      <view wx:else class="plan-list-footer">共 {{filteredTotal}} 条字典项</view>
    </view>

    <empty-state wx:else text="{{emptyText}}" />
  </view>
</view>
