<page-header title="{{pageTitle}}" show-back="{{true}}" center="{{true}}" bind:back="onHeaderBack" />

<view class="scan-setup st-page">
  <view class="scan-setup__hint">{{setupHint}}</view>

  <view class="scan-setup__form">
    <block wx:if="{{scanType === 'report'}}">
      <picker mode="selector" range="{{pickerNodes}}" range-key="name" value="{{nodeIndex}}" bindchange="onNodeChange">
        <view class="scan-setup__row">
          <text class="scan-setup__label">工序</text>
          <text class="scan-setup__value {{nodeName ? '' : 'scan-setup__value--placeholder'}}">{{nodeName || '请选择'}}</text>
          <text class="scan-setup__chevron">›</text>
        </view>
      </picker>
    </block>

    <block wx:if="{{scanType === 'outsource'}}">
      <picker mode="selector" range="{{pickerPartners}}" range-key="name" value="{{partnerIndex}}" bindchange="onPartnerChange">
        <view class="scan-setup__row">
          <text class="scan-setup__label">加工厂</text>
          <text class="scan-setup__value {{partnerName ? '' : 'scan-setup__value--placeholder'}}">{{partnerName || '请选择'}}</text>
          <text class="scan-setup__chevron">›</text>
        </view>
      </picker>
    </block>

    <block wx:if="{{scanType === 'rework'}}">
      <picker mode="selector" range="{{pickerReworkNodes}}" range-key="name" value="{{reworkNodeIndex}}" bindchange="onReworkNodeChange">
        <view class="scan-setup__row">
          <text class="scan-setup__label">返工工序</text>
          <text class="scan-setup__value {{reworkNodeName ? '' : 'scan-setup__value--placeholder'}}">{{reworkNodeName || '请选择'}}</text>
          <text class="scan-setup__chevron">›</text>
        </view>
      </picker>
    </block>
  </view>

  <button class="st-btn-primary scan-setup__start" bindtap="onStartScan">开始扫码</button>
</view>
