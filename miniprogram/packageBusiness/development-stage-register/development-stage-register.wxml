<view class="plan-create-shell">
  <view class="plan-create-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="plan-create-header__bar" style="height: {{navBarHeight}}px;">
      <view class="plan-create-header__back" bindtap="onHeaderBack">‹</view>
      <text class="plan-create-header__title">节点登记</text>
      <view class="plan-create-header__back plan-create-header__back--placeholder"></view>
    </view>
  </view>
  <view class="plan-create-header-spacer" style="height: {{headerBlockHeight}}px;"></view>

  <scroll-view class="plan-create-scroll" scroll-y style="height: {{scrollHeight}}px;" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="plan-create-muted">加载中…</view>
    <view wx:else class="plan-create-page">
      <view class="plan-form-card">
        <view class="plan-form-cell">
          <text class="plan-form-cell__label">节点</text>
          <text class="plan-form-cell__value">{{stageName}}</text>
        </view>
        <view class="plan-form-cell plan-form-cell--status">
          <text class="plan-form-cell__label">状态</text>
          <view class="dev-status-btns">
            <view
              wx:for="{{statusOptions}}"
              wx:key="id"
              class="dev-status-btn {{status === item.id ? 'dev-status-btn--active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onStatusTap"
            >{{item.label}}</view>
          </view>
        </view>
      </view>

      <view class="plan-form-card">
        <view class="plan-form-cell plan-form-cell--section">
          <text class="plan-form-cell__label">登记内容</text>
        </view>
        <view wx:if="{{!fields.length}}" class="plan-create-muted">该节点无可填字段</view>
        <block wx:for="{{fields}}" wx:key="id">
          <view wx:if="{{item.type === 'select'}}" class="plan-form-cell plan-form-cell--input">
            <text class="plan-form-cell__label">{{item.required ? '*' : ''}}{{item.label}}</text>
            <picker mode="selector" range="{{item.options}}" value="{{item.pickerIndex}}" data-id="{{item.id}}" bindchange="onSelectChange">
              <view class="plan-form-cell__value">{{item.value || '请选择'}}</view>
            </picker>
          </view>
          <datetime-calendar-select
            wx:elif="{{item.type === 'date'}}"
            label="{{item.label}}"
            required="{{item.required}}"
            date="{{item.datePart}}"
            time="{{item.timePart}}"
            data-id="{{item.id}}"
            bind:change="onDateFieldChange"
            bind:sheetopen="onPickerSheetOpen"
            bind:sheetclose="onPickerSheetClose"
          />
          <view wx:elif="{{item.type === 'file'}}" class="plan-form-cell plan-form-cell--file">
            <text class="plan-form-cell__label">{{item.required ? '*' : ''}}{{item.label}}</text>
            <view wx:if="{{item.previewList.length}}" class="dev-file-thumbs">
              <view
                wx:for="{{item.previewList}}"
                wx:for-item="thumb"
                wx:key="id"
                class="dev-file-thumb-item"
              >
                <image
                  class="dev-file-thumb"
                  src="{{thumb.src}}"
                  mode="aspectFill"
                  data-id="{{item.id}}"
                  data-index="{{thumb.index}}"
                  catchtap="onFilePreview"
                />
                <view
                  class="dev-file-thumb-del"
                  data-id="{{item.id}}"
                  data-index="{{thumb.index}}"
                  catchtap="onFileRemove"
                >×</view>
              </view>
            </view>
            <view
              wx:if="{{item.canAddMore !== false}}"
              class="dev-file-btn {{item.hasFile ? 'dev-file-btn--on' : ''}}"
              data-id="{{item.id}}"
              bindtap="onFilePick"
            >{{item.fileLabel || '选择图片'}}</view>
          </view>
          <view wx:else class="plan-form-cell plan-form-cell--input">
            <text class="plan-form-cell__label">{{item.required ? '*' : ''}}{{item.label}}</text>
            <input class="plan-form-cell__input" value="{{item.value}}" data-id="{{item.id}}" bindinput="onFieldInput" placeholder="请填写" />
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && !pickerSheetOpen}}" class="plan-create-footer">
    <button
      class="plan-create-submit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSaveTap"
    >{{submitting ? '保存中…' : '保存登记'}}</button>
  </view>
</view>
