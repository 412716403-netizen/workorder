@import '../../styles/tokens.wxss';
@import '../../styles/matrix-keyboard-page.wxss';
@import '/styles/plan-create-form.wxss';

page {
  background: var(--color-bg-page);
  height: 100%;
}

.plan-form-card .sps--cell .plan-form-cell {
  border-bottom: 1rpx solid var(--color-border);
}

.plan-form-card .sps--cell:last-child .plan-form-cell {
  border-bottom: none;
}

.plan-create-page--keyboard {
  /* 保留别名，实际占位见 matrix-keyboard-page.wxss */
}

.report-matrix__cell {
  padding: 8rpx 4rpx;
  align-items: flex-start;
  flex: 0 0 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
}

.report-matrix .plan-create-matrix__size {
  flex: 0 0 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
}

.report-matrix__cell-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 96rpx;
  gap: 4rpx;
}

.report-matrix .plan-create-matrix__input {
  width: 72rpx;
  height: 64rpx;
  min-height: 64rpx;
  flex-shrink: 0;
  padding: 0;
}

.report-matrix__cell-inner--empty .plan-create-matrix__dash {
  width: 72rpx;
}

.report-matrix__max {
  display: block;
  width: 100%;
  min-height: 28rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

.report-context-card {
  padding: 24rpx var(--spacing-card);
}

.report-context-card__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.report-context-card__main {
  flex: 1;
  min-width: 0;
}

.report-context-card__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
}

.report-context-card__order {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-context-card__dot {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.report-context-card__product {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-context-card__hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.report-context-card__scan {
  flex-shrink: 0;
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.report-context-card__scan-icon {
  width: 48rpx;
  height: 48rpx;
}

.report-context-card__scan-text {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.report-context-card__scan:active {
  opacity: 0.72;
}

.report-qty-head {
  align-items: center;
}

.report-qty-summary {
  padding: 20rpx var(--spacing-card) 8rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.report-qty-summary__hero {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.report-qty-summary__label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.report-qty-summary__value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
}

.report-qty-summary__detail {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.report-qty-toggle {
  display: flex;
  padding: 4rpx;
  border-radius: 12rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
}

.report-qty-toggle__item {
  min-width: 96rpx;
  padding: 10rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: 10rpx;
}

.report-qty-toggle__item--active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 255, 0.12);
}

.report-variant-row {
  padding: 16rpx var(--spacing-card);
  border-bottom: 1rpx solid var(--color-border);
}

.report-variant-row:last-child {
  border-bottom: none;
}

.report-variant-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.report-variant-row__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-variant-row__meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.report-variant-row__inputs {
  display: flex;
}

.report-stepper-field__input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border);
  background: #fff;
  font-size: 28rpx;
  text-align: center;
}

.report-stepper-field__input--full {
  width: 100%;
}

.report-qty-cell {
  align-items: flex-start;
}

.report-qty-cell__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.report-qty-cell__max {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--color-text-tertiary);
}

.report-stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.report-stepper__btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
}

.report-stepper__btn:active {
  opacity: 0.7;
}

.report-stepper__input {
  width: 120rpx;
  height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ── 称重工序：本次交货总重量 + 预估物料消耗（对齐 Web ReportWeightBomSection） ── */
.report-weight-card {
  padding: 24rpx;
  background: #eef2ff;
  border: 1rpx solid #c7d2fe;
}

.report-weight-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.report-weight-head__label {
  font-size: 26rpx;
  font-weight: 700;
  color: #4338ca;
}

.report-weight-head__hint {
  font-size: 20rpx;
  color: #6366f1;
}

.report-weight-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c7d2fe;
  border-radius: 12rpx;
  background: #fff;
  font-size: 30rpx;
  font-weight: 700;
  color: #4338ca;
  text-align: right;
}

.report-weight-preview {
  margin-top: 16rpx;
  border: 1rpx solid #e0e7ff;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.report-weight-preview__title {
  padding: 12rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #4f46e5;
  background: #eef2ff;
  border-bottom: 1rpx solid #e0e7ff;
}

.report-weight-preview__row {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.report-weight-preview__row--head {
  border-top: none;
  background: #f8fafc;
}

.report-weight-preview__col {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.report-weight-preview__row--head .report-weight-preview__col {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-tertiary);
}

.report-weight-preview__col--name {
  flex: 1.4;
  text-align: left;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-weight-preview__col--actual {
  font-weight: 700;
  color: #4f46e5;
}

.report-weight-nobom {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #d97706;
}
