@import "/styles/tokens.wxss";

.worker-report-confirm-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.worker-report-confirm-summary__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary, #1f2329);
}

.worker-report-confirm-summary__meta {
  font-size: 24rpx;
  color: var(--color-text-secondary, #646a73);
  line-height: 1.5;
}

.worker-report-confirm-line__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.worker-report-confirm-line__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary, #2f6bff);
}

.worker-report-confirm-line__sku {
  font-size: 24rpx;
  color: var(--color-text-secondary, #8f959e);
}

.worker-report-confirm-line__total {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
  margin-bottom: 12rpx;
}

.worker-report-confirm-line__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid var(--color-border, #f0f1f3);
}

.worker-report-confirm-line__spec {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-secondary, #646a73);
}

.worker-report-confirm-line__qty-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.worker-report-confirm-line__qty {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
}

.worker-report-confirm-line__defective {
  font-size: 22rpx;
  color: #b45309;
}
