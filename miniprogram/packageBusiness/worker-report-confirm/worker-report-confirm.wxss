@import '../production-order-report/production-order-report.wxss';

.report-matrix--readonly .plan-create-matrix__input {
  pointer-events: none;
}

.report-matrix__input--readonly {
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-stepper--readonly {
  min-width: 200rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-stepper__readonly-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.report-stepper-field__input--readonly {
  color: var(--color-text-primary);
  font-weight: 600;
  background: var(--color-bg-page);
}
